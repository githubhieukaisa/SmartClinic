@inherits LayoutComponentBase

<div class="flex h-screen bg-background">
    <!-- Sidebar -->
    <aside class="w-64 bg-sidebar border-r border-border flex flex-col fixed h-full">
        <!-- Logo -->
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
                    <i class="ph-bold ph-stethoscope text-white text-sm"></i>
                </div>
                <h1 class="text-xl font-bold text-foreground">DocLink</h1>
            </div>
        </div>

        <!-- Doctor Profile Card -->
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-gradient-to-br from-primary to-primary/70 rounded-full flex items-center justify-center text-white font-bold">
                    JM
                </div>
                <div>
                    <p class="font-semibold text-foreground text-sm">Dr. James Miller</p>
                    <p class="text-xs text-muted-foreground">General Practitioner</p>
                </div>
            </div>
            <div class="bg-primary/10 rounded-lg p-2 text-center">
                <span class="text-xs font-medium text-primary">On Duty</span>
            </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="flex-1 px-4 py-6">
            <ul class="space-y-2">
                <li>
                    <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition">
                        <i class="ph-bold ph-squares-four text-lg"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition">
                        <i class="ph-bold ph-queue text-lg"></i>
                        <span>Patient Queue</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition">
                        <i class="ph-bold ph-users text-lg"></i>
                        <span>Patients</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition">
                        <i class="ph-bold ph-file-text text-lg"></i>
                        <span>Medical Records</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition">
                        <i class="ph-bold ph-pill text-lg"></i>
                        <span>Prescriptions</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition">
                        <i class="ph-bold ph-test-tube text-lg"></i>
                        <span>Lab Tests</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Logout Button -->
        <div class="p-4 border-t border-border">
            <button class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-red-50 transition font-medium">
                <i class="ph-bold ph-sign-out text-lg"></i>
                <span>Sign Out</span>
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 overflow-auto">
        <div class="min-h-screen bg-background">
            @Body
        </div>
    </main>
</div>
