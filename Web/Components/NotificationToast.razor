@using SmartClinic.Services

<!-- Toast UI with very high z-index to ensure visibility -->
<div style="background:white;border:2px solid #3b82f6;border-radius:0.5rem;padding:1rem;box-shadow:0 10px 15px -3px rgba(0,0,0,0.2);display:flex;align-items:center;gap:0.75rem;width:100%;max-width:28rem;pointer-events:auto;z-index:50001;position:relative">
    <!-- Icon -->
    <div style="flex-shrink:0;font-size:1.5rem;font-weight:bold">
        @switch (Notification.Type)
        {
            case "success":
                <span style="color:#16a34a">✓</span>
                break;
            case "error":
                <span style="color:#dc2626">✕</span>
                break;
            case "warning":
                <span style="color:#ea580c">⚠</span>
                break;
            default:
                <span style="color:#2563eb">ℹ</span>
                break;
        }
    </div>

    <!-- Message -->
    <div style="flex:1">
        <p style="font-size:0.875rem;margin:0;color:#1f2937;font-weight:500">@Notification?.Message</p>
        <p style="font-size:0.75rem;margin:0.25rem 0 0 0;color:#6b7280">(ID: @Notification?.Id)</p>
    </div>

    <!-- Close button -->
    <button @onclick="OnClose"
            style="flex-shrink:0;background:none;border:none;color:#ef4444;cursor:pointer;padding:0.25rem;font-size:1.5rem;line-height:1;hover:color:#991b1b"
            aria-label="Close notification">
        ×
    </button>
</div>

@code {
    [Parameter]
    public GlobalNotificationService.Notification? Notification { get; set; }

    [Parameter]
    public EventCallback<string> OnDismiss { get; set; }

    private int _instanceId;
    private static int _instanceCount = 0;

    protected override void OnInitialized()
    {
        _instanceId = ++_instanceCount;
        System.Diagnostics.Debug.WriteLine($"[NotificationToast] Rendering toast for: {Notification?.Message}");
        System.Diagnostics.Debug.WriteLine($"[NotificationToast]   ID: {Notification?.Id}");
        System.Diagnostics.Debug.WriteLine($"[NotificationToast]   Type: {Notification?.Type}");
        
        // AUTO-DISMISS DISABLED FOR DEBUGGING
        // To re-enable: uncomment line below
        // _ = Task.Delay(3000).ContinueWith(_ => OnClose());
    }

    private async Task OnClose()
    {
        if (Notification?.Id != null)
        {
            System.Diagnostics.Debug.WriteLine($"[NotificationToast] User closed notification: {Notification.Id}");
            await OnDismiss.InvokeAsync(Notification.Id);
        }
    }
}
