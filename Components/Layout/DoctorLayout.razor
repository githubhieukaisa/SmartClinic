@using Blazored.Toast.Configuration
@using SmartClinic.Components.Common
@using SmartClinic.Services
@using Blazored.Toast
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject NotificationService NotificationService

<!-- ✅ BlazoredToasts - Global Toast UI for all pages -->
<BlazoredToasts Position="ToastPosition.TopCenter"
                Timeout="3"
                IconType="IconType.Blazored"
                @rendermode="InteractiveServer" />

<!-- ✅ Toast Handler - SignalR event listener (no UI rendering) -->
<ToastHandler />

<div class="flex h-screen bg-background">
    <aside class="w-64 bg-sidebar border-r border-border flex flex-col fixed h-full">
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
                    <i class="ph-bold ph-stethoscope text-white text-sm"></i>
                </div>
                <h1 class="text-xl font-bold text-foreground">DocLink</h1>
            </div>
        </div>

        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-gradient-to-br from-primary to-primary/70 rounded-full flex items-center justify-center text-white font-bold">
                    JM
                </div>
                <div>
                    <p class="font-semibold text-foreground text-sm">Dr. James Miller</p>
                    <p class="text-xs text-muted-foreground">General Practitioner</p>
                </div>
            </div>
            <div class="bg-primary/10 rounded-lg p-2 text-center">
                <span class="text-xs font-medium text-primary">On Duty</span>
            </div>
        </div>

        <nav class="flex-1 px-4 py-6">
            <ul class="space-y-2">
                <li>
                    <NavLink href="/" Match="NavLinkMatch.All" class="@NavClass("/", exact: true)">
                        <i class="ph-bold ph-squares-four text-lg"></i>
                        <span>Dashboard</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/doctor/my-patients" class="@NavClass("/doctor/my-patients")">
                        <i class="ph-bold ph-queue text-lg"></i>
                        <span>Patient Queue</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/doctor/patients" class="@NavClass("/doctor/patients")">
                        <i class="ph-bold ph-users text-lg"></i>
                        <span>Patients</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/doctor/medical-records" class="@NavClass("/doctor/medical-records")">
                        <i class="ph-bold ph-file-text text-lg"></i>
                        <span>Medical Records</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/doctor/prescriptions" class="@NavClass("/doctor/prescriptions")">
                        <i class="ph-bold ph-pill text-lg"></i>
                        <span>Prescriptions</span>
                    </NavLink>
                </li>
            </ul>
        </nav>

        <div class="p-4 border-t border-border">
            <button class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-red-50 transition font-medium">
                <i class="ph-bold ph-sign-out text-lg"></i>
                <span>Sign Out</span>
            </button>
        </div>
    </aside>

    <main class="flex-1 ml-64 overflow-auto">
        <div class="min-h-screen bg-background">
            @Body
        </div>
    </main>
</div>

@code {
    private string NavClass(string href, bool exact = false)
    {
        var currentPath = new Uri(Nav.Uri).AbsolutePath;
        var isActive = exact
            ? currentPath.Equals(href, StringComparison.OrdinalIgnoreCase)
            : currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase);

        return isActive
            ? "flex items-center gap-3 px-4 py-3 rounded-lg bg-primary text-primary-foreground font-medium transition"
            : "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition";
    }

}


