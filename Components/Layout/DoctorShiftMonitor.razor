@* ============================================================
   DoctorShiftMonitor — Component vô hình + Badge ca trực
   ============================================================
   @rendermode InteractiveServer khai báo ở đây → KHÔNG bao giờ prerender.
   Tự render badge trực tiếp → không cần EventCallback cross-component.
   ============================================================ *@

@rendermode InteractiveServer
@using SmartClinic.Services
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable

@inject DoctorDailyShiftService DailyShiftService
@inject AuthenticationStateProvider AuthenticationStateProvider

@* Badge hiển thị ngay tại đây — Interactive nên StateHasChanged() hoạt động *@
<div class="mt-3">
    @if (DailyShiftService.IsOnDuty && DailyShiftService.CurrentShift?.Room != null)
    {
        <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Đang trực · @DailyShiftService.CurrentShift.Room.Name
        </span>
    }
    else
    {
        <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
            Ngoài ca trực
        </span>
    }
</div>

@code {
    private bool _initialized = false;

    protected override async Task OnInitializedAsync()
    {
        // Guard chống tạo nhiều instance cho cùng 1 bác sĩ
        if (_initialized) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true) return;

        var roleMaskClaim = user.FindFirst("RoleMask")?.Value;
        if (!int.TryParse(roleMaskClaim, out int roleMask) || (roleMask & 2) != 2) return;

        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int doctorId)) return;

        DailyShiftService.OnShiftStateChanged += HandleShiftStateChanged;
        await DailyShiftService.InitializeAsync(doctorId);
        _initialized = true;
    }

    private void HandleShiftStateChanged()
    {
        // ✅ StateHasChanged trên chính component Interactive này → hoạt động chắc chắn
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        DailyShiftService.OnShiftStateChanged -= HandleShiftStateChanged;
        await ValueTask.CompletedTask;
    }
}
