@using Blazored.Toast
@using Blazored.Toast.Configuration
@using SmartClinic.Components.Common
@inherits LayoutComponentBase
@inject NavigationManager Nav

<BlazoredToasts Position="ToastPosition.BottomRight"
                Timeout="5"
                IconType="IconType.Blazored"
                @rendermode="InteractiveServer" />

<PharmacistToastHandler @rendermode="InteractiveServer" />

<div class="flex h-screen bg-background">
    <!-- Sidebar -->
    <aside class="w-64 bg-sidebar border-r border-border flex flex-col fixed h-full">
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center">
                    <i class="ph ph-pill text-white text-sm"></i>
                </div>
                <h1 class="text-xl font-bold text-foreground">SmartClinic</h1>
            </div>
        </div>

        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center text-green-700 font-bold">
                    D
                </div>
                <div>
                    <p class="font-semibold text-foreground text-sm">Dược sĩ</p>
                    <p class="text-xs text-muted-foreground">Pharmacist</p>
                </div>
            </div>
        </div>

        <nav class="flex-1 px-4 py-6">
            <ul class="space-y-2">
                <li>
                    <NavLink href="/pharmacist/prescriptions" class="@NavClass("/pharmacist/prescriptions")">
                        <i class="ph ph-prescription text-lg"></i>
                        <span>Đơn thuốc chờ</span>
                    </NavLink>
                </li>
            </ul>
        </nav>

        <div class="p-4 border-t border-border">
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button type="submit"
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-red-50 transition font-medium">
                    <i class="ph-bold ph-sign-out text-lg"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 ml-64 overflow-auto">
        <div class="min-h-screen bg-background">
            @Body
        </div>
    </main>
</div>

@code {
    private string NavClass(string href)
    {
        var currentPath = new Uri(Nav.Uri).AbsolutePath;
        var isActive = currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "flex items-center gap-3 px-4 py-3 rounded-lg bg-green-600 text-white font-medium transition"
            : "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition";
    }
}
