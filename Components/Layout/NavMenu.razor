@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="w-full">
	<nav class="flex flex-col gap-2 px-4 py-6 w-full">

		@* Đăng Nhập *@
		<AuthorizeView>
			<NotAuthorized>
				<NavLink class="@baseClass" href="login" Match="NavLinkMatch.All">
					<i class="ph ph-sign-in text-lg"></i>
					<span>Đăng Nhập</span>
				</NavLink>
			</NotAuthorized>
		</AuthorizeView>

		@* Bác Sĩ *@
		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="/doctor/dashboard" Match="NavLinkMatch.All">
					<i class="ph ph-squares-four text-lg"></i>
					<span>Tổng Quan</span>
				</NavLink>

				<NavLink class="@baseClass" href="/doctor/my-patients">
					<i class="ph ph-queue text-lg"></i>
					<span>Hàng Đợi</span>
				</NavLink>

				@* Hiện Khám Bệnh khi đang trong tiến trình *@
				@if (NavManager.Uri.Contains("/doctor/examination/"))
				{
					<NavLink class="@baseClass" href="@NavManager.Uri" Match="NavLinkMatch.Prefix">
						<i class="ph ph-stethoscope text-lg"></i>
						<span>Khám Bệnh</span>
					</NavLink>
				}

			</Authorized>
		</AuthorizeView>

		@* Kỹ thuật viên xét nghiệm *@
		<AuthorizeView Policy="LabTechPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="/lab" Match="NavLinkMatch.All">
					<i class="ph ph-flask text-lg"></i>
					<span>Xét Nghiệm</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Reception Links *@
		<AuthorizeView Policy="ReceptionPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="checkin">
					<i class="ph ph-clipboard text-lg"></i>
					<span>Quầy Lễ Tân</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Cashier Links *@
		<AuthorizeView Policy="CashierPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="/cashier/payments" Match="NavLinkMatch.All">
					<i class="ph ph-money text-lg"></i>
					<span>Thanh toán</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Pharmacist Links *@
		<AuthorizeView Policy="PharmacistPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="/pharmacist/prescriptions" Match="NavLinkMatch.All">
					<i class="ph ph-receipt text-lg"></i>
					<span>Đơn Thuốc</span>
				</NavLink>

				<NavLink class="@baseClass" href="/pharmacist/medicines" Match="NavLinkMatch.All">
					<i class="ph ph-pill text-lg"></i>
					<span>Kho Thuốc</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Admin Links *@
		<AuthorizeView Policy="AdminPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="/admin/statistics" Match="NavLinkMatch.All">
					<i class="ph ph-chart-bar text-lg"></i>
					<span>Thống kê</span>
				</NavLink>

				<NavLink class="@baseClass" href="hangfire">
					<i class="ph ph-gear text-lg"></i>
					<span>HangFire</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Manager Links (Vận hành — CRUD, Phân lịch) *@
		<AuthorizeView Policy="ManagerPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="/admin/users" Match="NavLinkMatch.All">
					<i class="ph ph-users text-lg"></i>
					<span>Tài khoản</span>
				</NavLink>

				<NavLink class="@baseClass" href="/admin/scheduling" Match="NavLinkMatch.All">
					<i class="ph ph-calendar text-lg"></i>
					<span>Phân lịch trực</span>
				</NavLink>

				<NavLink class="@baseClass" href="/admin/medicines" Match="NavLinkMatch.All">
					<i class="ph ph-pill text-lg"></i>
					<span>Kho Thuốc</span>
				</NavLink>

				<NavLink class="@baseClass" href="/admin/test">
					<i class="ph ph-flask text-lg"></i>
					<span>Xét nghiệm</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Đăng Xuất được chuyển sang MainLayout *@

	</nav>
</div>


@implements IDisposable

@code {
	private const string baseClass = "w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-muted transition";

	protected override void OnInitialized()
	{
		NavManager.LocationChanged += HandleLocationChanged;
	}

	private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		StateHasChanged();
	}

	public void Dispose()
	{
		NavManager.LocationChanged -= HandleLocationChanged;
	}
}