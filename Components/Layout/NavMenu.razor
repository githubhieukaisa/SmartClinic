@using Microsoft.AspNetCore.Components.Authorization
@using SmartClinic.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
	<nav class="flex-column">
		<AuthorizeView>
			<NotAuthorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
						<span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Đăng Nhập
					</NavLink>
				</div>
			</NotAuthorized>
		</AuthorizeView>
		
		@* Doctor Link *@
		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition" href="/doctor/dashboard" Match="NavLinkMatch.All">
						<i class="ph-bold ph-squares-four text-lg"></i>
						<span>Dashboard</span>
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="@doctorClassString" href="/doctor/my-patients">
						<i class="ph-bold ph-queue text-lg"></i>
						<span>Patient Queue</span>
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="@doctorClassString" href="doctor/patients">
						<i class="ph-bold ph-users text-lg"></i>
						<span>Patients</span>
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="@doctorClassString" href="doctor/medical-records">
						<i class="ph-bold ph-file-text text-lg"></i>
						<span>Medical Records</span>
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="@doctorClassString" href="doctor/prescriptions">
						<i class="ph-bold ph-pill text-lg"></i>
						<span>Prescriptions</span>
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="@doctorClassString" href="doctor/lab-tests">
						<i class="ph-bold ph-test-tube text-lg"></i>
						<span>Lab Tests</span>
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="@doctorClassString" href="doctor/waiting-list-demo">
						<span class="bi bi-heart-pulse" aria-hidden="true"></span> Phòng Khám
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>
		<AuthorizeView Policy="PharmacistPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="/pharmacist/prescriptions">
						<span class="bi bi-capsule" aria-hidden="true"></span> Dược Sĩ
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="CashierPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="/cashier/payments">
						<span class="bi bi-cash-coin" aria-hidden="true"></span> Thu Ngân
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>
		@* Reception Link *@
		<AuthorizeView Policy="ReceptionPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="checkin">
						<span class="bi bi-person-badge" aria-hidden="true"></span> Quầy Lễ Tân
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView Policy="AdminPolicy">
			<Authorized>
				<div class="nav-item px-3">
					<NavLink class="nav-link" href="hangfire">
						<span class="bi bi-heart-pulse" aria-hidden="true"></span> HangFire
					</NavLink>
				</div>
			</Authorized>
		</AuthorizeView>

		<AuthorizeView>
			<Authorized>
				<div class="nav-item px-3">
					<form action="/logout" method="post" style="display: inline;">
						<AntiforgeryToken />
						<button type="submit" class="nav-link btn btn-link text-white" style="border: none; background: none; width: 100%; text-align: left;">
							<span class="bi bi-box-arrow-right" aria-hidden="true"></span> Đăng Xuất
						</button>
					</form>
				</div>
			</Authorized>
		</AuthorizeView>
	</nav>
</div>


@code{
	private const string doctorClassString = "nav-link flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition";
}