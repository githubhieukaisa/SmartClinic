@using Microsoft.AspNetCore.Components.Authorization
@using SmartClinic.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
	<nav class="flex flex-col gap-1 px-3 py-4 mx-auto w-full">

		@* Đăng Nhập *@
		<AuthorizeView>
			<NotAuthorized>
				<NavLink class="@baseClass" href="login" Match="NavLinkMatch.All">
					<i class="ph ph-sign-in text-lg"></i>
					<span>Đăng Nhập</span>
				</NavLink>
			</NotAuthorized>
		</AuthorizeView>

		@* Doctor Links *@
		<AuthorizeView Policy="DoctorPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="/doctor/dashboard" Match="NavLinkMatch.All">
					<i class="ph ph-squares-four text-lg"></i>
					<span>Dashboard</span>
				</NavLink>

				<NavLink class="@baseClass" href="/doctor/my-patients">
					<i class="ph ph-queue text-lg"></i>
					<span>Patient Queue</span>
				</NavLink>

				<NavLink class="@baseClass" href="doctor/patients">
					<i class="ph ph-users text-lg"></i>
					<span>Patients</span>
				</NavLink>

				<NavLink class="@baseClass" href="doctor/medical-records">
					<i class="ph ph-file-text text-lg"></i>
					<span>Medical Records</span>
				</NavLink>

				<NavLink class="@baseClass" href="doctor/prescriptions">
					<i class="ph ph-pill text-lg"></i>
					<span>Prescriptions</span>
				</NavLink>

				<NavLink class="@baseClass" href="doctor/lab-tests">
					<i class="ph ph-test-tube text-lg"></i>
					<span>Lab Tests</span>
				</NavLink>

				<NavLink class="@baseClass" href="doctor/waiting-list-demo">
					<i class="ph ph-stethoscope text-lg"></i>
					<span>Phòng Khám</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Reception Links *@
		<AuthorizeView Policy="ReceptionPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="checkin">
					<i class="ph ph-clipboard text-lg"></i>
					<span>Quầy Lễ Tân</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Admin Links *@
		<AuthorizeView Policy="AdminPolicy">
			<Authorized>
				<NavLink class="@baseClass" href="hangfire">
					<i class="ph ph-gear text-lg"></i>
					<span>HangFire</span>
				</NavLink>
			</Authorized>
		</AuthorizeView>

		@* Đăng Xuất *@
		<AuthorizeView>
			<Authorized>
				<form action="/logout" method="post" class="w-full">
					<AntiforgeryToken />
					<button type="submit" class="@baseClass">
						<i class="ph ph-sign-out text-lg"></i>
						<span>Đăng Xuất</span>
					</button>
				</form>
			</Authorized>
		</AuthorizeView>

	</nav>
</div>


@code {
	private const string baseClass = "w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-muted transition";
}