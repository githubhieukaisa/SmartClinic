@using Blazored.Toast
@using Blazored.Toast.Configuration
@using SmartClinic.Components.Common

@inherits LayoutComponentBase

<div class="flex h-screen bg-background">
    <aside class="w-64 bg-sidebar border-r border-border flex flex-col fixed h-full z-50">
        <!-- HEADER: Logo -->
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                    <i class="ph ph-hospital text-white text-sm"></i>
                </div>
                <h1 class="text-xl font-bold text-foreground">SmartClinic</h1>
            </div>
        </div>

        <!-- HEADER: User Profile + Shift Badge (nếu là bác sĩ) -->
        <NavUser />

        <!-- NAVIGATION -->
        <nav class="flex-1 overflow-y-auto">
            <NavMenu />
        </nav>

        <!-- FOOTER: Logout -->
        <div class="p-4 border-t border-border mt-auto">
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button type="submit"
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-red-50 transition font-medium">
                    <i class="ph-bold ph-sign-out text-lg"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 ml-64 overflow-auto relative">
        <div class="min-h-screen bg-background">
            @Body
        </div>
    </main>
</div>

<BlazoredToasts Position="ToastPosition.BottomRight" Timeout="3" IconType="IconType.Blazored"
                @rendermode="InteractiveServer" />

<ToastHandler @rendermode="InteractiveServer" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
