@using Blazored.Toast
@using Blazored.Toast.Configuration
@using SmartClinic.Components.Common
@using SmartClinic.Services
@using SmartClinic.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NotificationService Notification
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="flex-1 overflow-auto">
        <div class="min-h-screen bg-background">
            @Body
        </div>
    </main>
</div>

<BlazoredToasts Position="ToastPosition.BottomRight" Timeout="3" IconType="IconType.Blazored"
                @rendermode="InteractiveServer" />

<ToastHandler @rendermode="InteractiveServer" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@inject IDbContextFactory<SmartClinicDbContext> DbContextFactory

@code {
    private int? _currentRoomId;
    private int _doctorId;
    private System.Threading.Timer? _shiftCheckTimer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true) return;

        // Chỉ Doctor mới cần theo dõi Room auto-detect
        var roleMaskClaim = user.FindFirst("RoleMask")?.Value;
        if (!int.TryParse(roleMaskClaim, out int roleMask) || (roleMask & 2) != 2)
        {
            System.Diagnostics.Debug.WriteLine($"[MainLayout] ℹ️ Not a Doctor (RoleMask={roleMaskClaim}) — skipping JoinRoom");
            return;
        }

        // Lấy DoctorId
        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int docId))
        {
            _doctorId = docId;
        }

        // Khởi chạy ngay lần đầu tiên để load & join phòng hiện tại của bác sĩ (nếu có)
        await CheckActiveShiftAsync();

        // Khởi chạy Timer quét Database trong background (Mỗi 15 giây)
        _shiftCheckTimer = new System.Threading.Timer(async _ => await CheckActiveShiftAsync(), null, TimeSpan.FromSeconds(15),
TimeSpan.FromSeconds(15));
    }

    private async Task CheckActiveShiftAsync()
    {
        var now = DateTime.Now;
        // Log để dễ dàng theo dõi thời điểm chạy vòng background Timer (để ở đây cho chắc chắn log luôn hiện)
        System.Diagnostics.Debug.WriteLine($"[MainLayout] ⏰ ---------- Timer Tick: {now.ToString("HH:mm:ss")} | DoctorId: {_doctorId} ----------");

        if (_doctorId <= 0) return;

        try
        {
            // Mở 1 connection Database riêng
            using var dbContext = await DbContextFactory.CreateDbContextAsync();

            // Lấy CA TRỰC ĐANG ACTIVE (Status == Active)
            var activeShift = await dbContext.DoctorShifts
                .Where(s => s.DoctorId == _doctorId
                         && s.Status == "Active"
                         && s.StartTime <= now
                         && (s.EndTime == null || s.EndTime >= now))
                .OrderByDescending(s => s.StartTime)
                .FirstOrDefaultAsync();

            int? activeRoomId = activeShift?.RoomId;

            if (activeRoomId == null)
            {
                // Nếu không có ca trực (hoặc đã lỡ ca), rollback về Room mặc định của User
                var doctor = await dbContext.Users.FindAsync(_doctorId);
                activeRoomId = doctor?.RoomId;
            }

            // Nếu phát hiện có phòng trực & phòng khác phòng hiện tại → Chuyển phòng ngầm!
            if (activeRoomId.HasValue && activeRoomId.Value > 0)
            {
                if (_currentRoomId != activeRoomId.Value)
                {
                    System.Diagnostics.Debug.WriteLine($"[MainLayout] 🔄 TIMERSHIFT DETECTED! Time: {now.ToString("HH:mm:ss")}. Doctor={_doctorId}, OldRoom={_currentRoomId?.ToString() ?? "NULL"}, NewRoom={activeRoomId.Value}");

                    // 1. Thoát Phòng Cũ (nếu đang ở phòng nào đó)
                    if (_currentRoomId.HasValue)
                    {
                        await Notification.LeaveRoomAsync(_currentRoomId.Value);
                    }

                    // 2. Vào Phòng Mới
                    await Notification.JoinRoomAsync(activeRoomId.Value);
                    _currentRoomId = activeRoomId.Value;
                }
                else
                {
                    // Ping log để bạn biết Timer vẫn đang chạy
                    System.Diagnostics.Debug.WriteLine($"[MainLayout] ⏳ {now.ToString("HH:mm:ss")}: Timer tick, still in Room_{_currentRoomId.Value}...");
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MainLayout] ❌ Error background check shift: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _shiftCheckTimer?.Dispose();
        await ValueTask.CompletedTask;
    }
}

