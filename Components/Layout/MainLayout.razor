@using Blazored.Toast
@using Blazored.Toast.Configuration
@using SmartClinic.Components.Common
@using SmartClinic.Constant
@using SmartClinic.Services
@using SmartClinic.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NotificationService Notification
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="flex h-screen bg-background">
    <aside class="w-64 bg-sidebar border-r border-border flex flex-col fixed h-full z-50">
        <!-- HEADER: Logo -->
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                    <i class="ph ph-hospital text-white text-sm"></i>
                </div>
                <h1 class="text-xl font-bold text-foreground">SmartClinic</h1>
            </div>
        </div>

        <!-- HEADER: User Profile -->
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-3">
                <div
                    class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-bold shrink-0">
                    @_userInitial
                </div>
                <div>
                    <p class="font-semibold text-foreground text-sm line-clamp-1" title="@_userName">@_userName</p>
                    <p class="text-xs text-muted-foreground line-clamp-1" title="@_userRole">@_userRole</p>
                </div>
            </div>
        </div>

        <!-- NAVIGATION -->
        <nav class="flex-1 overflow-y-auto">
            <NavMenu />
        </nav>

        <!-- FOOTER: Logout -->
        <div class="p-4 border-t border-border mt-auto">
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button type="submit"
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-red-50 transition font-medium">
                    <i class="ph-bold ph-sign-out text-lg"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 ml-64 overflow-auto relative">
        <div class="min-h-screen bg-background">
            @Body
        </div>
    </main>
</div>

<BlazoredToasts Position="ToastPosition.BottomRight" Timeout="3" IconType="IconType.Blazored"
                @rendermode="InteractiveServer" />

<ToastHandler @rendermode="InteractiveServer" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@inject IDbContextFactory<SmartClinicDbContext> DbContextFactory

@code {
    private int? _currentRoomId;
    private int _doctorId;
    private System.Threading.Timer? _shiftCheckTimer;

    // Header Profile vars
    private string _userName = "Vô danh";
    private string _userInitial = "U";
    private string _userRole = "Khách";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true) return;

        // Populate User Info
        _userName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                    ?? user.Identity.Name ?? "Bạn";
        _userInitial = _userName.Trim().Length > 0 ? _userName.Trim().Substring(0, 1).ToUpper() : "U";

        var roleMaskClaim = user.FindFirst("RoleMask")?.Value;
        if (int.TryParse(roleMaskClaim, out int roleMask))
        {
            var roleNames = new List<string>();
            if ((roleMask & 16) == 16) roleNames.Add("Admin");
            if ((roleMask & 2) == 2) roleNames.Add("Bác sĩ");
            if ((roleMask & 8) == 8) roleNames.Add("Thu ngân");
            if ((roleMask & 32) == 32) roleNames.Add("Xét nghiệm");
            if ((roleMask & 4) == 4) roleNames.Add("Dược sĩ");
            if ((roleMask & 1) == 1) roleNames.Add("Lễ tân");

            _userRole = roleNames.Any() ? string.Join(", ", roleNames) : "User";
        }

        // Chỉ Doctor mới cần theo dõi Room auto-detect
        if (!int.TryParse(roleMaskClaim, out int doctorRoleMask) || (doctorRoleMask & 2) != 2)
        {
            System.Diagnostics.Debug.WriteLine($"[MainLayout] ℹ️ Not a Doctor (RoleMask={roleMaskClaim}) — skipping JoinRoom");
            return;
        }

        // Lấy DoctorId
        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int docId))
        {
            _doctorId = docId;
        }

        // Khởi chạy ngay lần đầu tiên để load & join phòng hiện tại của bác sĩ (nếu có)
        await CheckActiveShiftAsync();

        // Khởi chạy Timer quét Database trong background (Mỗi 15 giây)
        _shiftCheckTimer = new System.Threading.Timer(async _ => await CheckActiveShiftAsync(), null, TimeSpan.FromSeconds(15),
TimeSpan.FromMinutes(10));
    }

    private async Task CheckActiveShiftAsync()
    {
        var now = DateTime.Now;
        // Log để dễ dàng theo dõi thời điểm chạy vòng background Timer (để ở đây cho chắc chắn log luôn hiện)
        System.Diagnostics.Debug.WriteLine($"[MainLayout] ⏰ ---------- Timer Tick: {now.ToString("HH:mm:ss")} | DoctorId: {_doctorId} ----------");

        if (_doctorId <= 0) return;

        try
        {
            // Mở 1 connection Database riêng
            using var dbContext = await DbContextFactory.CreateDbContextAsync();

            // Lấy CA TRỰC ĐANG ACTIVE (Status == Active)
            var activeShift = await dbContext.DoctorShifts
                .Where(s => s.DoctorId == _doctorId
                         && s.StatusEnum == DoctorShiftStatus.Active
                         && s.StartTime <= now
                         && (s.EndTime == null || s.EndTime >= now))
                .OrderByDescending(s => s.StartTime)
                .FirstOrDefaultAsync();

            int? activeRoomId = activeShift?.RoomId;

            if (activeRoomId == null)
            {
                // Nếu không có ca trực, không tự ý lấy phòng mặc định (theo yêu cầu mới)
                System.Diagnostics.Debug.WriteLine($"[MainLayout] ⚠️ No active shift for Doctor {_doctorId}.");

                // Nếu không có ca trực, thoát khỏi phòng hiện tại nếu đang ở trong phòng nào đó
                if (_currentRoomId.HasValue)
                {
                    await Notification.LeaveRoomAsync(_currentRoomId.Value);
                    _currentRoomId = null;
                }
            }
            // Nếu phát hiện có phòng trực & phòng khác phòng hiện tại → Chuyển phòng ngầm!
            else if (activeRoomId.HasValue && activeRoomId.Value > 0)
            {
                if (_currentRoomId != activeRoomId.Value)
                {
                    System.Diagnostics.Debug.WriteLine($"[MainLayout] 🔄 TIMERSHIFT DETECTED! Time: {now.ToString("HH:mm:ss")}. Doctor={_doctorId}, OldRoom={_currentRoomId?.ToString() ?? "NULL"}, NewRoom={activeRoomId.Value}");

                    // 1. Thoát Phòng Cũ (nếu đang ở phòng nào đó)
                    if (_currentRoomId.HasValue)
                    {
                        await Notification.LeaveRoomAsync(_currentRoomId.Value);
                    }

                    // 2. Vào Phòng Mới
                    await Notification.JoinRoomAsync(activeRoomId.Value);
                    _currentRoomId = activeRoomId.Value;
                }
                else
                {
                    // Ping log để bạn biết Timer vẫn đang chạy
                    System.Diagnostics.Debug.WriteLine($"[MainLayout] ⏳ {now.ToString("HH:mm:ss")}: Timer tick, still in Room_{_currentRoomId.Value}...");
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MainLayout] ❌ Error background check shift: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _shiftCheckTimer?.Dispose();
        await ValueTask.CompletedTask;
    }
}

