@using Blazored.Toast
@using Blazored.Toast.Configuration
@using SmartClinic.Components.Common
@inherits LayoutComponentBase
@inject NavigationManager Nav

<BlazoredToasts Position="ToastPosition.BottomRight" Timeout="5" IconType="IconType.Blazored"
                @rendermode="InteractiveServer" />

<CashierToastHandler @rendermode="InteractiveServer" />

<div class="flex h-screen bg-background">
    <aside class="w-64 bg-sidebar border-r border-border flex flex-col fixed h-full">
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                    <i class="ph ph-currency-circle-dollar text-white text-sm"></i>
                </div>
                <h1 class="text-xl font-bold text-foreground">SmartClinic</h1>
            </div>
        </div>

        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-3">
                <div
                    class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-bold">
                    T
                </div>
                <div>
                    <p class="font-semibold text-foreground text-sm">Thu ngân</p>
                    <p class="text-xs text-muted-foreground">Cashier</p>
                </div>
            </div>
        </div>

        <nav class="flex-1 px-4 py-6">
            <ul class="space-y-2">
                <li>
                    <NavLink href="/cashier/payments" class="@NavClass("/cashier/payments")">
                        <i class="ph ph-money text-lg"></i>
                        <span>Thanh toán</span>
                    </NavLink>
                </li>
            </ul>
        </nav>

        <div class="p-4 border-t border-border">
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button type="submit"
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-red-50 transition font-medium">
                    <i class="ph-bold ph-sign-out text-lg"></i>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 ml-64 overflow-auto">
        <div class="min-h-screen bg-background">
            @Body
        </div>
    </main>
</div>

@code {
    private string NavClass(string href)
    {
        var currentPath = new Uri(Nav.Uri).AbsolutePath;
        var isActive = currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "flex items-center gap-3 px-4 py-3 rounded-lg bg-indigo-600 text-white font-medium transition"
            : "flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition";
    }
}
