@using Microsoft.AspNetCore.Authorization
@inherits LayoutComponentBase
@attribute [Authorize(Policy = "AdminPolicy")]

<div class="flex h-screen bg-slate-100 font-sans text-slate-900">
    <!-- SIDEBAR (Thanh điều hướng bên trái) -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col shadow-xl">
        <!-- Logo / Tiêu đề -->
        <div class="h-16 flex items-center justify-center border-b border-slate-700">
            <h1 class="text-xl font-bold tracking-wider">SmartClinic Admin</h1>
        </div>

        <!-- Menu Navigation -->
        <nav class="flex-1 px-4 py-6 space-y-2">
            <NavLink href="/admin/users" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-slate-700" Match="NavLinkMatch.All">
                <!-- Icon Users (SVG) -->
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <span class="font-medium">Quản lý Tài khoản</span>
            </NavLink>

            <NavLink href="/admin/medicines" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-slate-700" Match="NavLinkMatch.All">
                <!-- Icon Thuốc (SVG) -->
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                <span class="font-medium">Danh mục Thuốc</span>
            </NavLink>
        </nav>

        <!-- Nút Đăng xuất ở cuối Sidebar -->
        <div class="p-4 border-t border-slate-700">
            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-red-400 hover:text-red-300 hover:bg-slate-700 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                <span class="font-medium">Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT (Khu vực chứa ruột của từng trang) -->
    <main class="flex-1 flex flex-col overflow-hidden">
        <!-- Header phụ (tùy chọn) -->
        <header class="h-16 bg-white shadow-sm flex items-center px-8">
            <h2 class="text-lg font-semibold text-slate-700">Hệ thống Quản trị (Admin)</h2>
        </header>

        <!-- Nơi Blazor sẽ "bơm" giao diện của Users.razor hoặc Medicines.razor vào -->
        <div class="flex-1 overflow-y-auto p-8">
            @Body
        </div>
    </main>
</div>