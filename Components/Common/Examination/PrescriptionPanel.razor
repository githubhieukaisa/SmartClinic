@using SmartClinic.Models
@using SmartClinic.Services
@using Microsoft.EntityFrameworkCore
@using Blazored.Toast.Services

@inject IDbContextFactory<SmartClinicDbContext> DbFactory
@inject IToastService ToastService
@inject IPharmacyService PharmacyService

<div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
    <div class="flex items-center gap-3 mb-6">
        <i class="ph ph-pill text-2xl text-primary"></i>
        <h2 class="text-xl font-bold text-foreground">Kê Đơn Thuốc</h2>
    </div>

    <div class="space-y-6">
        <!-- Medicine Selection -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium text-foreground mb-2">Chọn Thuốc</label>
                <select @bind="_selectedMedicineId"
                        class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="0">Chọn một loại thuốc...</option>
                    @foreach (var med in _availableMedicines.Where(m => !_prescribedMedicines.Any(pm =>
                        pm.MedicineId == m.Id)))
                    {
                        <option value="@med.Id">@med.Name (@med.Unit)</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-foreground mb-2">Số lượng</label>
                <input type="number" @bind="_medicineQuantity"
                       class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                       min="1" placeholder="SL" />
            </div>

            <div>
                <label class="block text-sm font-medium text-foreground mb-2">Liều dùng</label>
                <input type="text" @bind="_medicineDosage"
                       class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                       placeholder="Vd: 2 lần/ngày" />
            </div>
        </div>

        <!-- Add Medicine Button -->
        <SaveActionButton OnClick="AddMedicineAsync" Label="Thêm Thuốc" LoadingLabel="Đang thêm..." Icon="ph-plus"
                          Disabled="@(_prescriptionSaved || _selectedMedicineId == 0 || _medicineQuantity < 1)" />

        <!-- Selected Medicines Table -->
        @if (_prescribedMedicines.Any())
        {
            <div>
                <h3 class="text-sm font-semibold text-foreground mb-3">Danh sách thuốc đã kê</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-border bg-muted/30">
                                <th class="text-center py-3 px-4 font-medium text-muted-foreground">Tên thuốc</th>
                                <th class="text-center py-3 px-4 font-medium text-muted-foreground">Số lượng</th>
                                <th class="text-center py-3 px-4 font-medium text-muted-foreground">Liều dùng</th>
                                <th class="text-center py-3 px-4 font-medium text-muted-foreground">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var medicine in _prescribedMedicines)
                            {
                                <tr class="border-b border-border hover:bg-muted/20 transition">
                                     <td class="py-3 px-4 text-foreground text-center">@medicine.MedicineName</td>
                                     <td class="py-3 px-4 text-center text-foreground">@medicine.Quantity</td>
                                     <td class="py-3 px-4 text-center text-foreground">@medicine.Dosage</td>
                                    <td class="py-3 px-4">
                                        <div class="flex justify-center">
                                            <Button Variant="Button.ButtonVariant.Danger" IsFullWidth="false"
                                                    Disabled="@_prescriptionSaved"
                                                    OnClick="@(async _ => RemoveMedicine(medicine.MedicineId))">
                                                <i class="ph ph-trash mr-1"></i> Xóa
                                            </Button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-8 text-muted-foreground">
                <i class="ph ph-pill text-3xl mb-2 opacity-50"></i>
                <p class="text-sm">Chưa có thuốc nào được kê</p>
            </div>
        }

        <!-- Save Prescription Button / Locked State -->
        @if (_prescriptionSaved)
        {
            <!-- Đã gửi → hiện badge, không cho sửa -->
            <div class="flex items-center gap-4">
                <div
                    class="flex items-center gap-2 px-4 py-2 rounded-xl bg-green-500/10 text-green-600 text-sm font-medium w-fit">
                    <i class="ph ph-check-circle text-base"></i>
                    <span>Đơn thuốc đã gửi — Đang chờ Dược sĩ</span>
                </div>

                @* ── TEST ONLY ───────────────────── *@
                <button @onclick="ResetPrescriptionTestAsync"
                        class="flex items-center gap-2 px-3 py-2 bg-red-500/10 text-red-600 rounded-lg text-sm font-medium hover:bg-red-500/20 transition border border-red-500/30">
                    <i class="ph ph-trash"></i>
                    Test: Xoá Toàn Bộ Đơn Thuốc
                </button>
            </div>
        }
        else
        {
            <SaveActionButton
            OnClick="@(() => { _showPrescriptionConfirm = true; StateHasChanged(); return Task.CompletedTask; })"
            Label="Lưu Đơn Thuốc" LoadingLabel="Đang lưu..." Icon="ph-prescription"
            Disabled="@(!_prescribedMedicines.Any())" />
        }

    </div>
</div>

<!-- Confirm Prescription Modal -->
<Modal IsVisible="@_showPrescriptionConfirm" OnClose="() => _showPrescriptionConfirm = false" Size="Modal.ModalSize.Xl">

    <HeaderContent>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                <i class="ph ph-prescription text-xl"></i>
            </div>
            <div>
                <h3 class="text-lg font-bold text-primary">Xác Nhận Đơn Thuốc</h3>
            </div>
        </div>
    </HeaderContent>

    <ChildContent>
        <div class="mb-4">
            <p class="text-sm text-foreground mb-3 font-medium">Bạn có chắc chắn muốn gửi đơn thuốc này? <b
                class="text-red-500">Đơn
                thuốc sẽ không thể chỉnh sửa sau khi gửi.</b></p>
                <div class="rounded-xl border border-border overflow-hidden">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-muted text-muted-foreground uppercase font-bold text-[10px]">
                             <tr>
                                 <th class="px-4 py-2 text-center">Tên thuốc</th>
                                 <th class="px-4 py-2 text-center">SL</th>
                                 <th class="px-4 py-2 text-center">Liều dùng</th>
                             </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                             @foreach (var med in _prescribedMedicines)
                             {
                                 <tr>
                                     <td class="px-4 py-2 font-medium text-slate-800 text-center">@med.MedicineName</td>
                                     <td class="px-4 py-2 text-center text-slate-600">@med.Quantity</td>
                                     <td class="px-4 py-2 text-slate-500 italic text-center">@med.Dosage</td>
                                 </tr>
                             }
                        </tbody>
                    </table>
                </div>
            </div>
        </ChildContent>

        <FooterContent>
            <div class="flex justify-end w-full">
                <div class="grid grid-cols-2 gap-3 w-full sm:w-2/3 md:w-1/2">
                    <button @onclick="() => _showPrescriptionConfirm = false"
                            class="w-full px-3 py-2 rounded-xl border border-border text-foreground font-semibold hover:bg-muted transition-colors text-sm flex items-center justify-center">
                        Hủy
                    </button>
                    <SaveActionButton OnClick="SavePrescriptionAsync" Label="Xác nhận" LoadingLabel="Đang gửi..."
                                      Icon="ph-check" Variant="solid" ExtraCssClass="w-full justify-center !py-2 !text-sm" />
                </div>
            </div>
        </FooterContent>

    </Modal>

@code {
    [Parameter] public int TicketId { get; set; }

    private int _selectedMedicineId = 0;
    private int _medicineQuantity = 1;
    private string _medicineDosage = "";
    private List<PrescribedMedicine> _prescribedMedicines = new();
    private bool _prescriptionSaved = false;
    private bool _showPrescriptionConfirm = false;
    private List<Medicine> _availableMedicines = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        _availableMedicines = await context.Medicines
            .OrderBy(m => m.Name)
            .ToListAsync();

        var existingPrescription = await context.Prescriptions
            .Include(p => p.PrescriptionDetails)
                .ThenInclude(d => d.Medicine)
            .FirstOrDefaultAsync(p => p.TicketId == TicketId);

        if (existingPrescription != null)
        {
            _prescriptionSaved = true;
            _prescribedMedicines = existingPrescription.PrescriptionDetails
                .Select(d => new PrescribedMedicine
                {
                    MedicineId = d.MedicineId ?? 0,
                    MedicineName = d.Medicine?.Name ?? $"Medicine #{d.MedicineId}",
                    Quantity = d.Quantity,
                    Dosage = d.UsageInstruction ?? "",
                })
                .ToList();
        }
    }

    private async Task AddMedicineAsync()
    {
        if (_selectedMedicineId == 0 || _medicineQuantity < 1) return;

        var selectedMed = _availableMedicines.FirstOrDefault(m => m.Id == _selectedMedicineId);
        if (selectedMed != null)
        {
            _prescribedMedicines.Add(new PrescribedMedicine
            {
                MedicineId = _selectedMedicineId,
                MedicineName = selectedMed.Name,
                Quantity = _medicineQuantity,
                Dosage = _medicineDosage
            });
            _selectedMedicineId = 0;
            _medicineQuantity = 1;
            _medicineDosage = "";
        }
        StateHasChanged();
    }

    private void RemoveMedicine(int medicineId)
    {
        _prescribedMedicines.RemoveAll(m => m.MedicineId == medicineId);
        StateHasChanged();
    }

    private async Task SavePrescriptionAsync()
    {
        if (_prescriptionSaved) return;

        try
        {
            var prescription = new Prescription
            {
                TicketId = TicketId,
                Status = "Pending",
            };

            foreach (var med in _prescribedMedicines)
            {
                prescription.PrescriptionDetails.Add(new PrescriptionDetail
                {
                    MedicineId = med.MedicineId,
                    Quantity = med.Quantity,
                    UnitPrice = 0,
                    UsageInstruction = med.Dosage,
                });
            }

            using var context = DbFactory.CreateDbContext();
            context.Prescriptions.Add(prescription);
            await context.SaveChangesAsync();

            await PharmacyService.NotifyNewPrescriptionAsync(prescription.Id);

            _prescriptionSaved = true;
            _showPrescriptionConfirm = false;
            ToastService.ShowSuccess($"Đã lưu {_prescribedMedicines.Count} loại thuốc — Đã chuyển thông tin tới Dược sĩ!");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [PrescriptionPanel] Save error: {ex.Message}");
            ToastService.ShowError("Không thể lưu đơn thuốc. Vui lòng kiểm tra lại danh mục thuốc hoặc kết nối máy chủ.");
        }
    }

    private async Task ResetPrescriptionTestAsync()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            // Include PrescriptionDetails to handle manual deletion because of Restrict behavior
            var existingPrescription = await context.Prescriptions
                .Include(p => p.PrescriptionDetails)
                .FirstOrDefaultAsync(p => p.TicketId == TicketId);

            if (existingPrescription != null)
            {
                // Remove details first to satisfy foreign key constraints
                if (existingPrescription.PrescriptionDetails.Any())
                {
                    context.PrescriptionDetails.RemoveRange(existingPrescription.PrescriptionDetails);
                }
                
                context.Prescriptions.Remove(existingPrescription);
                await context.SaveChangesAsync();
                
                _prescriptionSaved = false;
                _prescribedMedicines.Clear();
                ToastService.ShowInfo("Đã xóa hoàn toàn đơn thuốc và chi tiết để test lại.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [PrescriptionPanel] RESET error: {ex.Message}");
            ToastService.ShowError("Có lỗi xảy ra khi xóa dữ liệu thử nghiệm.");
        }
    }

    private class PrescribedMedicine
    {
        public int MedicineId { get; set; }
        public string MedicineName { get; set; } = "";
        public int Quantity { get; set; }
        public string Dosage { get; set; } = "";
    }
}
