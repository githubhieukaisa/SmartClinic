<div class="flex flex-col items-center justify-center h-full p-8 text-center transition-transform duration-300 bg-white border shadow-xl dark:bg-slate-800 rounded-2xl border-slate-100 dark:border-slate-700 hover:scale-[1.02]">
    <h2 class="mb-2 text-xl font-semibold tracking-widest uppercase text-slate-500 dark:text-slate-400">
        Số Đang Gọi
    </h2>

    @* tabular-nums: Cực kỳ quan trọng cho các con số thay đổi liên tục để chiều rộng không bị giật *@
    <div class="my-4 font-black tracking-tighter text-7xl md:text-9xl text-rose-600 dark:text-rose-500 tabular-nums">
        @TicketNumber
    </div>

    <div class="px-6 py-2 mt-4 text-lg font-semibold text-slate-700 dark:text-slate-300">
        Bệnh nhân: <span class="text-blue-600 dark:text-blue-400">@PatientName</span>
    </div>

    <div class="px-6 py-2 mt-3 text-xl font-bold border rounded-full md:text-2xl bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 border-indigo-100 dark:border-indigo-800/50">
        Vào: @RoomName
    </div>
</div>

@code {
    [Parameter] public string TicketNumber { get; set; } = string.Empty;
    [Parameter] public string RoomName { get; set; } = string.Empty;
    [Parameter] public string PatientName { get; set; } = "Đang chờ bệnh nhân...";
}