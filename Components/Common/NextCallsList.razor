@* Shared/NextCallsList.razor *@
<div class="h-full p-6 bg-white border shadow-lg dark:bg-slate-800 rounded-2xl border-slate-100 dark:border-slate-700">
    <h4 class="pb-2 mb-4 text-lg font-bold border-b text-slate-700 dark:text-slate-200 border-slate-100 dark:border-slate-700">
        CHUẨN BỊ:
    </h4>
    <ul class="space-y-3">
        @if (Tickets == null || !Tickets.Any())
        {
            <li class="italic text-slate-400">Chưa có số tiếp theo...</li>
        }
        else
        {
            @foreach (var ticket in Tickets)
            {
                <li class="flex items-center p-3 text-xl font-semibold rounded-lg bg-slate-50 dark:bg-slate-700/50 text-slate-700 dark:text-slate-300">
                    <span class="flex items-center justify-center w-8 h-8 mr-3 text-sm rounded-full bg-slate-200 dark:bg-slate-600">#</span>
                    @ticket
                </li>
            }
        }
    </ul>
</div>

@code {
    [Parameter] public List<string> Tickets { get; set; } = new();
}