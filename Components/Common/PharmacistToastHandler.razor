@* PharmacistToastHandler.razor
   Lắng nghe SignalR "NewPrescriptionReady" và hiển thị toast cho Dược sĩ.
   Đặt component này trong PharmacistLayout.
*@
@using Blazored.Toast.Services
@using Microsoft.AspNetCore.SignalR.Client
@using SmartClinic.DTOs
@inject IToastService Toaster
@inject NavigationManager Navigation
@implements IAsyncDisposable

@code {
    private HubConnection? _hub;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/prescription"))
            .WithAutomaticReconnect()
            .Build();

        // Lắng nghe đơn thuốc mới từ bác sĩ
        _hub.On<NewPrescriptionNotificationDto>("NewPrescriptionReady", async (data) =>
        {
            await InvokeAsync(() =>
            {
                Toaster.ShowSuccess(
                    $"💊 Đơn mới #{data.TicketNumber} - {data.PatientName} " +
                    $"({data.MedicineCount} thuốc · {data.TotalAmount:N0}đ)");
            });
        });

        await _hub.StartAsync();
        await _hub.InvokeAsync("JoinPharmacistGroup");

        System.Diagnostics.Debug.WriteLine("[PharmacistToastHandler] Connected & joined Pharmacists group");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub != null)
            await _hub.DisposeAsync();
    }
}
