@* PharmacistToastHandler.razor
   - Lắng nghe SignalR "NewPrescriptionReady"
   - Hiển thị toast
   - Raise event OnNewPrescription để trang Prescriptions.razor tự reload
   Đặt trong PharmacistLayout.
*@
@using Blazored.Toast.Services
@using Microsoft.AspNetCore.SignalR.Client
@using SmartClinic.DTOs
@inject IToastService Toaster
@inject NavigationManager Navigation
@implements IAsyncDisposable

@code {
    private HubConnection? _hub;

    /// <summary>
    /// Event fired khi có đơn thuốc mới.
    /// Prescriptions.razor subscribe vào đây để tự reload danh sách.
    /// </summary>
    public event Func<NewPrescriptionNotificationDto, Task>? OnNewPrescription;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/prescription"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<NewPrescriptionNotificationDto>("NewPrescriptionReady", async (data) =>
        {
            // 1. Hiện toast
            await InvokeAsync(() =>
            {
                Toaster.ShowSuccess(
                    $"💊 New prescription #{data.TicketNumber} — {data.PatientName} " +
                    $"({data.MedicineCount} items · {data.TotalAmount:N0}đ)");
            });

            // 2. Notify trang Prescriptions để tự reload
            if (OnNewPrescription != null)
            {
                await OnNewPrescription.Invoke(data);
            }
        });

        await _hub.StartAsync();
        await _hub.InvokeAsync("JoinPharmacistGroup");

        System.Diagnostics.Debug.WriteLine("[PharmacistToastHandler] Connected & joined Pharmacists group");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub != null)
            await _hub.DisposeAsync();
    }
}
