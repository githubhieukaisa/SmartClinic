<button type="@Type"
        disabled="@(IsLoading || Disabled)"
        @onclick="OnClick"
        class="@GetButtonClasses()">

    @if (IsLoading)
    {
        <svg class="w-5 h-5 mr-2 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Đang xử lý...</span>
    }
    else
    {
        @ChildContent
    }
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string CssClass { get; set; } = string.Empty;

    //Variant và FullWidth
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public bool IsFullWidth { get; set; } = true;

    // Enum Variant
    public enum ButtonVariant
    {
        Primary,
        Secondary,
        Danger,
        Success,
        Outline
    }

    private string GetButtonClasses()
    {
        var baseClasses = "flex justify-center items-center px-4 py-2 font-semibold rounded-lg shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed";

        var widthClass = IsFullWidth ? "w-full" : "w-auto";

        var variantClasses = Variant switch
        {
            ButtonVariant.Primary => "text-white bg-blue-600 hover:bg-blue-700 focus:ring-blue-500",
            ButtonVariant.Secondary => "text-slate-700 bg-slate-200 hover:bg-slate-300 focus:ring-slate-500",
            ButtonVariant.Danger => "text-white bg-red-600 hover:bg-red-700 focus:ring-red-500",
            ButtonVariant.Success => "text-white bg-green-600 hover:bg-green-700 focus:ring-green-500",
            ButtonVariant.Outline => "text-blue-600 bg-transparent border border-blue-600 hover:bg-blue-50 focus:ring-blue-500",
            _ => "text-white bg-blue-600 hover:bg-blue-700 focus:ring-blue-500"
        };

        return $"{baseClasses} {widthClass} {variantClasses} {CssClass}";
    }
}