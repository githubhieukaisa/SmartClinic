@using SmartClinic.Models
@using SmartClinic.Services
@using Blazored.Toast.Services
@using SmartClinic.Components.Common.Examination
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject ILabService LabService
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider

<div class="bg-card rounded-xl border border-border shadow-sm overflow-hidden flex flex-col h-full">
    <div class="p-6 border-b border-border bg-muted/30 flex justify-between items-start">
        <div class="flex gap-4">
            <div
                class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-lg">
                @Order.QueueTicket?.TicketNumber
            </div>
            <div>
                <h3 class="text-xl font-bold text-foreground">@Order.QueueTicket?.Patient?.FullName</h3>
                <p class="text-sm text-muted-foreground flex items-center gap-2 mt-0.5">
                    <i class="ph ph-clock"></i>
                    Chỉ định lúc @Order.CreatedAt.ToString("HH:mm")
                </p>
            </div>
        </div>
        <div class="flex flex-col items-end gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider
                @(Order.Status == LabOrderStatus.Completed ? "bg-green-500/10 text-green-600" : "bg-amber-500/10 text-amber-600")">
                @(Order.Status == LabOrderStatus.Completed ? "Hoàn Thành" : "Đang Chờ")
            </span>
        </div>
    </div>

    <div class="p-6 space-y-4 flex-1">
        @foreach (var detail in Order.LabOrderDetails.Where(d => SelectedStationId == 0 || d.LabTest?.DefaultRoomId ==
        SelectedStationId))
        {
            bool isDetailDone = _savedDetailIds.Contains(detail.Id);
            bool isExpanded = _expandedDetailIds.Contains(detail.Id);

            <div
                class="border border-border rounded-xl overflow-hidden transition-all duration-200 @(isExpanded ? "ring-1 ring-primary/20 shadow-md" : (isDetailDone ? "bg-muted/10 opacity-80" : "bg-amber-50/20 border-amber-200"))">
                @* Test Row Header *@
                <div @onclick="() => ToggleDetail(detail.Id)"
                     class="flex items-center justify-between p-4 cursor-pointer hover:bg-muted/20 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="w-2 h-2 rounded-full @(isDetailDone ? "bg-green-500" : "bg-amber-500 animate-pulse")">
                        </div>
                        <h4 class="font-bold text-foreground">@detail.LabTest?.Name</h4>
                    </div>
                    <div class="flex items-center gap-3">
                        @if (isDetailDone)
                        {
                            <span
                                class="text-[10px] font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded uppercase tracking-tighter">Hoàn
                                Tất</span>
                            }
                        else
                            {
                                <span
                                    class="text-[10px] font-bold text-amber-600 bg-amber-100 px-2 py-0.5 rounded uppercase tracking-tighter">Đang
                                    Chờ</span>
                                }
                                <i class='ph ph-caret-@(isExpanded ? "up" : "down") text-muted-foreground'></i>
                            </div>
                        </div>

                        @* Test Row Body (Expanded) *@
                        @if (isExpanded)
                        {
                            <div class="p-4 pt-0 space-y-4 animate-in slide-in-from-top-2 duration-200">
                                <div class="h-px bg-border/50 mb-4"></div>
                                <div>
                                    <label
                                        class="block text-[11px] font-bold text-muted-foreground uppercase tracking-widest mb-1.5 flex items-center gap-2">
                                        <i class="ph ph-note-pencil text-primary"></i>
                                        Kết quả đo / Kết luận <span class="text-destructive">*</span>
                                    </label>
                                    <textarea
                                    class="w-full px-4 py-3 bg-background border border-border rounded-xl text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all text-sm disabled:bg-muted/50 disabled:text-muted-foreground"
                                    rows="3" placeholder="Ví dụ: Chỉ số ở mức ổn định..." @bind="detail.ResultNotes"
                                    readonly="@isDetailDone"></textarea>
                                </div>
                                <div>
                                    <label
                                        class="block text-[11px] font-bold text-muted-foreground uppercase tracking-widest mb-1.5 flex items-center gap-2">
                                        <i class="ph ph-file-arrow-up text-primary"></i>
                                        Tệp đính kèm (Hình ảnh/PDF)
                                    </label>

                                    @if (string.IsNullOrEmpty(detail.ResultFileUrl))
                                    {
                                        <label
                                            class="flex items-center justify-center w-full px-4 py-6 border-2 border-dashed border-border rounded-xl cursor-pointer hover:border-primary/50 hover:bg-muted/30 transition-all group">
                                            <div class="flex flex-col items-center gap-2 text-center">
                                                <i
                                                class="ph ph-cloud-arrow-up text-3xl text-muted-foreground group-hover:text-primary transition-colors"></i>
                                                <span class="text-xs font-bold text-muted-foreground">Nhấn để tải lên kết quả (Max
                                                    10MB)</span>
                                                    <span class="text-[10px] text-muted-foreground/60">Chấp nhận .jpg, .png, .pdf...</span>
                                                </div>
                                                <InputFile OnChange="@(e => HandleFileSelected(e, detail))" class="hidden"
                                                           disabled="@isDetailDone" />
                                            </label>
                                        }
                                    else
                                        {
                                            <div class="flex items-center justify-between p-3 bg-primary/5 border border-primary/20 rounded-xl">
                                                <div class="flex items-center gap-3 overflow-hidden">
                                                    <div
                                                        class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                                                        @{
                                                            var ext = detail.ResultFileUrl.Split('.').LastOrDefault()?.ToLower();
                                                            <i class="ph ph-@(ext == "pdf" ? "file-pdf" : "image-square") text-xl"></i>
                                                        }
                                                    </div>
                                                    <div class="flex flex-col overflow-hidden">
                                                        <span
                                                        class="text-xs font-bold text-foreground truncate">@detail.ResultFileUrl.Split('/').Last()</span>
                                                        <a href="@detail.ResultFileUrl" target="_blank"
                                                           class="text-[10px] text-primary hover:underline font-bold">Xem tệp tin</a>
                                                    </div>
                                                </div>
                                                @if (!isDetailDone)
                                                {
                                                    <button @onclick="() => detail.ResultFileUrl = null"
                                                            class="p-2 text-muted-foreground hover:text-destructive transition-colors">
                                                        <i class="ph ph-trash text-lg"></i>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="flex justify-end pt-2">
                                        <SaveActionButton OnClick="() => SaveResultAsync(detail)"
                                                          Disabled="@(isDetailDone || string.IsNullOrWhiteSpace(detail.ResultNotes))"
                                                          Label="@(isDetailDone ? "Đã Gửi Bác Sĩ" : "Lưu Kết Quả")" LoadingLabel="Đang lưu..."
                                                          Icon="@(isDetailDone ? "ph-check-square" : "ph-floppy-disk")"
                                                          Variant="@(isDetailDone ? "ghost" : "solid")" ExtraCssClass="!py-2 !h-9" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

@code {
    [Parameter, EditorRequired] public LabOrder Order { get; set; } = default!;
    [Parameter] public EventCallback<int> OnOrderUpdated { get; set; }
    [Parameter] public int SelectedStationId { get; set; }

    private HashSet<int> _expandedDetailIds = new();
    private HashSet<int> _savedDetailIds = new();

    protected override void OnParametersSet()
    {
        _savedDetailIds = Order.LabOrderDetails
            .Where(d => !string.IsNullOrEmpty(d.ResultNotes))
            .Select(d => d.Id)
            .ToHashSet();
    }

    private void ToggleDetail(int detailId)
    {
        if (_expandedDetailIds.Contains(detailId))
            _expandedDetailIds.Remove(detailId);
        else
            _expandedDetailIds.Add(detailId);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e, LabOrderDetail detail)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                var uploadedUrl = await LabService.UploadFileAsync(file);
                detail.ResultFileUrl = uploadedUrl;
                ToastService.ShowSuccess($"Đã tải lên tệp: {file.Name}");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [LabOrderCard] File upload error: {ex.Message}");
            ToastService.ShowError("Không thể tải tệp lên. Vui lòng kiểm tra lại định dạng tệp (PDF/Ảnh) hoặc kích thước tệp (tối đa 10MB).");
        }
    }

    private async Task SaveResultAsync(LabOrderDetail detail)
    {
        if (string.IsNullOrWhiteSpace(detail.ResultNotes))
        {
            ToastService.ShowWarning("Vui lòng nhập kết quả trước khi đưa lại cho bác sĩ.");
            return;
        }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var performerName = user.FindFirst("FullName")?.Value ?? user.Identity?.Name;
            
            int? performedId = null;
            if (int.TryParse(userIdStr, out int id)) performedId = id;

            await LabService.SubmitLabResultAsync(detail.Id, detail.ResultNotes, detail.ResultFileUrl, performedId, performerName);
            _savedDetailIds.Add(detail.Id);
            ToastService.ShowSuccess($"Đã ghi nhận kết quả cho {detail.LabTest?.Name}");

            // Optionally collapse after saving
            _expandedDetailIds.Remove(detail.Id);

            if (OnOrderUpdated.HasDelegate)
            {
                await OnOrderUpdated.InvokeAsync(Order.Id);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [LabOrderCard] Save error: {ex.Message}");
            ToastService.ShowError("Có lỗi xảy ra khi lưu kết quả. Vui lòng kiểm tra lại dữ liệu và kết nối mạng.");
        }
    }
}
