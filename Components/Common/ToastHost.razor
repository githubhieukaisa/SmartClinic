@* ToastHost.razor - Dual Flow Handler (SignalR + Manual Toasts)
   
   This component handles TWO separate flows:
   1. SignalR Flow: Backend events → Direct JS call (no event system)
   2. Manual Flow: Pages → ToastService.OnToast → JS call
   
   This architecture avoids circular dependencies and keeps concerns separated.
*@

@using SmartClinic.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject ToastNotificationService ToastService
@inject NotificationService SignalRService
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
    /// <summary>
    /// Initialize subscriptions
    /// </summary>
    protected override void OnInitialized()
    {
        System.Diagnostics.Debug.WriteLine("[ToastHost] Component initialized");
        
        // ✅ Subscribe to SignalR events (automatic toasts from backend)
        SignalRService.OnPatientQueueUpdated += HandlePatientQueueUpdatedAsync;
        System.Diagnostics.Debug.WriteLine("[ToastHost] Subscribed to SignalRService.OnPatientQueueUpdated");
        
        // ✅ Subscribe to manual toasts (optional - only if pages need to show toasts)
        // This supports future enhancement without changing SignalR flow
        ToastService.OnToast += HandleManualToastAsync;
        System.Diagnostics.Debug.WriteLine("[ToastHost] Subscribed to ToastService.OnToast (optional manual flow)");
    }

    /// <summary>
    /// After render, ensure SignalR connection is established
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            System.Diagnostics.Debug.WriteLine("[ToastHost] Setting up SignalR connection");
            
            // Ensure SignalR connection is established
            if (!SignalRService.IsConnected)
            {
                System.Diagnostics.Debug.WriteLine("[ToastHost] Waiting for SignalR connection...");
                await SignalRService.EnsureStartedAsync();
                System.Diagnostics.Debug.WriteLine("[ToastHost] SignalR connection established");
            }
            else
            {
                System.Diagnostics.Debug.WriteLine("[ToastHost] SignalR already connected");
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// ═══════════════════════════════════════════════════════════
    /// FLOW 1: SignalR Events (Automatic Toasts from Backend)
    /// ═══════════════════════════════════════════════════════════
    /// 
    /// Triggered by: Backend broadcasts "QueueTicketUpdated"
    /// Direct JS call: No dependency on ToastService event system
    /// Performance: Fast, no event propagation overhead
    /// </summary>
    private async void HandlePatientQueueUpdatedAsync(string patientName)
    {
        System.Diagnostics.Debug.WriteLine(
            $"[ToastHost] SIGNALR FLOW: Patient added event received - {patientName}");
        
        await InvokeAsync(async () =>
        {
            try
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[ToastHost] SIGNALR FLOW: Calling JS directly (no ToastService)");
                
                // ✅ Call JavaScript directly - don't go through ToastService event system
                // This avoids: SignalR → ShowToastAsync → OnToast → HandleToastAsync (circular)
                await JS.InvokeVoidAsync("appToasts.show", 
                    $"✓ {patientName} added to queue", 
                    "success", 
                    null);  // url parameter
                
                System.Diagnostics.Debug.WriteLine(
                    "[ToastHost] SIGNALR FLOW: Toast displayed via JS");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[ToastHost] SIGNALR FLOW ERROR: {ex.Message}");
            }
        });
    }

    /// <summary>
    /// ═══════════════════════════════════════════════════════════
    /// FLOW 2: Manual Toasts (From Pages - Optional Future Use)
    /// ═══════════════════════════════════════════════════════════
    /// 
    /// Triggered by: Pages call await Toast.ShowToastAsync(...)
    /// Via: ToastService.OnToast event system
    /// Use case: Form validation, user action feedback, custom messages
    /// 
    /// Note: Currently not used in this app, but available for future enhancement
    /// </summary>
    private async Task HandleManualToastAsync(string message, string type, string? url)
    {
        System.Diagnostics.Debug.WriteLine(
            $"[ToastHost] MANUAL FLOW: Toast requested - msg='{message}', type='{type}'");
        
        try
        {
            // ✅ Call JavaScript to display manual toast
            await JS.InvokeVoidAsync("appToasts.show", message, type, url);
            
            System.Diagnostics.Debug.WriteLine(
                "[ToastHost] MANUAL FLOW: Toast displayed via JS");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(
                $"[ToastHost] MANUAL FLOW ERROR: {ex.Message}");
        }
    }

    /// <summary>
    /// Cleanup when component is disposed
    /// </summary>
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        System.Diagnostics.Debug.WriteLine("[ToastHost] Component disposing");
        
        // Unsubscribe from both flows
        SignalRService.OnPatientQueueUpdated -= HandlePatientQueueUpdatedAsync;
        ToastService.OnToast -= HandleManualToastAsync;
        
        System.Diagnostics.Debug.WriteLine("[ToastHost] Unsubscribed from all events");
        
        await ValueTask.CompletedTask;
    }
}

