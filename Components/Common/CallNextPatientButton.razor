@using Blazored.Toast.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SmartClinic.Services
@inject IQueueService QueueService
@inject IToastService ToastService

<button @onclick="HandleClick"
        disabled="@(IsLoading || !HasResolvedRoomId)"
        class="@GetButtonClasses()">

    @if (IsLoading)
    {
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Đang gọi...</span>
    }
    else
    {
        <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
        </svg>
        <span>@ButtonText</span>
    }
</button>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // 1. Parameters cho phép ghi đè linh hoạt từ component cha
    [Parameter] public int? RoomId { get; set; }
    [Parameter] public string RoomName { get; set; } = "";
    [Parameter] public string ButtonText { get; set; } = "Gọi bệnh nhân";
    [Parameter] public string CssClass { get; set; } = ""; // Mở rộng CSS khi cần (VD: w-full trên mobile)

    // 2. Quản lý State
    private bool IsLoading { get; set; }
    private int? ResolvedRoomId { get; set; }
    private bool HasResolvedRoomId => ResolvedRoomId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        if (RoomId.HasValue && RoomId.Value > 0)
        {
            ResolvedRoomId = RoomId.Value;
            return;
        }

        if (AuthenticationStateTask is null)
        {
            ResolvedRoomId = null;
            return;
        }

        var authState = await AuthenticationStateTask;
        var roomIdClaim = authState.User.FindFirst("RoomId")?.Value;

        ResolvedRoomId = int.TryParse(roomIdClaim, out var roomId) ? roomId : null;
    }

    // 3. Dynamic Class Binding
    private string GetButtonClasses()
    {
        // Thứ tự logic: Layout -> Spacing -> Sizing -> Typography -> Colors -> Effects
        var baseClasses = "inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-blue-600 dark:bg-blue-500 rounded-lg shadow-sm";
        var interactiveClasses = "hover:bg-blue-700 dark:hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-all duration-200";
        var stateClasses = IsLoading ? "opacity-70 cursor-not-allowed" : "active:scale-95";

        return $"{baseClasses} {interactiveClasses} {stateClasses} {CssClass}".Trim();
    }

    // 4. Xử lý Logic
    private async Task HandleClick()
    {
        if (IsLoading) return; // Ngăn chặn double-click
        if (!HasResolvedRoomId)
        {
            ToastService.ShowError("Không tìm thấy phòng khám của bác sĩ trong JWT.");
            return;
        }

        IsLoading = true;
        StateHasChanged(); // Cập nhật UI hiển thị Spinner

        try
        {
            bool success = await QueueService.CallNextPatientAsync(ResolvedRoomId!.Value);
            if (!success)
            {
                ToastService.ShowWarning("Đã hết bệnh nhân trong hàng đợi!");
            }
            else
            {
                var displayRoomName = string.IsNullOrWhiteSpace(RoomName)
                    ? $"Phòng {ResolvedRoomId!.Value}"
                    : RoomName;
                ToastService.ShowSuccess($"Đã gọi bệnh nhân vào {displayRoomName}");
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged(); // Trả lại trạng thái bình thường
        }
    }
}