@page "/patient/medical-history/{TicketId:int}"
@using SmartClinic.Constant
@using SmartClinic.Models
@using SmartClinic.Components.Common.Examination
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SmartClinicDbContext> DbFactory
@inject NavigationManager NavigationManager

<div class="p-8">
    <div class="mb-6">
        <button @onclick="GoBack"
                class="flex items-center gap-2 px-4 py-2 text-blue-600 hover:bg-blue-50 rounded-xl transition font-semibold">
            <i class="ph ph-arrow-left"></i>
            Quay lại danh sách
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="flex flex-col items-center justify-center py-20 gap-4 text-slate-400">
            <i class="ph ph-spinner-gap text-3xl animate-spin"></i>
            <span class="text-sm font-medium">Đang tải chi tiết...</span>
        </div>
    }
    else if (_ticket == null)
    {
        <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-center">
            <i class="ph ph-warning-circle text-4xl text-red-500 mb-3"></i>
            <h3 class="text-lg font-bold text-red-900">Không tìm thấy thông tin lượt khám</h3>
            <p class="text-red-700 text-sm mt-1">Dữ liệu lượt khám không tồn tại hoặc bạn không có quyền truy cập.</p>
        </div>
    }
    else
    {
        <!-- Header Info -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-900">Chi tiết lượt khám #@_ticket.TicketNumber</h1>
            <p class="text-slate-500 mt-1 flex items-center gap-2">
                <i class="ph ph-calendar"></i>
                @_ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                <span class="mx-2 text-slate-300">|</span>
                <span class="text-green-600 font-bold">Đã hoàn tất</span>
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <!-- Left: Clinical Info -->
            <div class="lg:col-span-2 space-y-8">
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-800 mb-5 flex items-center gap-2">
                        <i class="ph ph-stethoscope text-blue-600"></i>
                        Kết quả chẩn đoán
                    </h3>

                    <div class="space-y-6">
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1.5">Chẩn đoán của bác
                                sĩ</p>
                                <div class="p-4 bg-slate-50 rounded-xl border border-slate-100 italic text-slate-700">
                                    @(string.IsNullOrWhiteSpace(_ticket.Diagnosis) ? "Chưa có dữ liệu" : _ticket.Diagnosis)
                                </div>
                            </div>

                            <div>
                                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1.5">Kế hoạch điều trị
                                </p>
                                <div class="text-slate-700 whitespace-pre-line leading-relaxed">
                                    @(string.IsNullOrWhiteSpace(_ticket.TreatmentPlan) ? "Liên hệ bác sĩ để biết thêm chi tiết." : _ticket.TreatmentPlan)
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_ticket.AdditionalNotes))
                            {
                                <div>
                                    <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1.5">Ghi chú thêm</p>
                                    <p class="text-sm text-slate-500 italic">@_ticket.AdditionalNotes</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Lab Results Panel -->
                    <LabOrderPanel TicketId="TicketId" RoomId="0" IsReadOnly="true" />

                    <!-- Prescription Panel -->
                    <PrescriptionPanel TicketId="TicketId" IsReadOnly="true" />
                </div>

                <!-- Right: Meta Info -->
                <div class="space-y-6">
                    <!-- Patient Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-4">Thông tin bệnh nhân</h3>
                        <div class="flex items-center gap-4 mb-4">
                            <div
                                class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-black">
                                @(_ticket.Patient?.FullName.Substring(0, 1).ToUpper() ?? "?")
                            </div>
                            <div>
                                <p class="font-bold text-slate-900">@(_ticket.Patient?.FullName ?? "N/A")</p>
                                <p class="text-xs text-slate-500">@(_ticket.Patient?.Phone ?? "N/A")</p>
                            </div>
                        </div>
                        <div class="pt-4 border-t border-slate-50 space-y-3">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Ngày sinh:</span>
                                <span class="text-slate-900 font-medium">@(_ticket.Patient?.DoB?.ToString("dd/MM/yyyy") ??
                                                  "-")</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-slate-500">Giới tính:</span>
                                    <span class="text-slate-900 font-medium">@(_ticket.Patient?.Gender == true ? "Nam" :
                                                                    "Nữ")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor Card -->
                            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                                <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-4">Người phụ trách</h3>
                                <div class="space-y-4">
                                    <div class="flex items-center gap-3">
                                        <i class="ph ph-user-md text-xl text-blue-600"></i>
                                        <div>
                                            <p class="text-xs text-slate-500">Bác sĩ khám</p>
                                            <p class="font-bold text-slate-900">@(_ticket.Doctor?.FullName ?? "N/A")</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <i class="ph ph-door text-xl text-blue-600"></i>
                                        <div>
                                            <p class="text-xs text-slate-500">Phòng khám</p>
                                            <p class="font-bold text-slate-900">@(_ticket.Room?.Name ?? "N/A")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Total Amount Card -->
                            <div class="bg-blue-600 rounded-2xl p-6 shadow-lg shadow-blue-200 text-white">
                                <h3 class="text-xs font-bold uppercase tracking-widest opacity-80 mb-2">Tổng chi phí lượt khám</h3>
                                <p class="text-3xl font-black italic">
                                    @(_ticket.TotalAmount?.ToString("N0") ?? "0")
                                    <span class="text-sm font-normal not-italic opacity-80">VNĐ</span>
                                </p>
                                @if (_ticket.StatusEnum == TicketStatus.Done)
                                {
                                    <div
                                        class="mt-4 flex items-center gap-1.5 text-[10px] font-bold bg-white/20 w-fit px-2 py-1 rounded-lg">
                                        <i class="ph ph-check-circle"></i> ĐÃ THANH TOÁN
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

@code {
    [Parameter] public int TicketId { get; set; }

    private QueueTicket? _ticket;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            _ticket = await context.QueueTickets
                .AsNoTracking()
                .Include(t => t.Patient)
                .Include(t => t.Doctor)
                .Include(t => t.Room)
                .FirstOrDefaultAsync(t => t.Id == TicketId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MedicalHistoryDetails] Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack() => NavigationManager.NavigateTo("/patient/medical-history");
}
