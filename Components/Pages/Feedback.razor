@page "/feedback/{EvaluationId:guid}"
@using SmartClinic.Models
@using SmartClinic.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<SmartClinicDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Đánh giá dịch vụ – SmartClinic</PageTitle>

<div class="min-h-screen bg-slate-50 flex items-center justify-center p-6">
    <div class="w-full max-w-lg">

        @if (_isLoading)
        {
            <div class="flex justify-center py-20">
                <i class="ph ph-spinner-gap text-3xl text-slate-400 animate-spin"></i>
            </div>
        }
        else if (_evaluation == null)
        {
            <div class="bg-white rounded-2xl border border-red-200 p-8 text-center shadow-sm">
                <i class="ph ph-warning-circle text-5xl text-red-400 mb-3 block"></i>
                <h1 class="text-xl font-bold text-slate-800 mb-2">Không tìm thấy đánh giá</h1>
                <p class="text-sm text-slate-500">Đường link không hợp lệ hoặc đã hết hạn.</p>
            </div>
        }
        else if (_evaluation.IsSubmitted)
        {
            <!-- Đã đánh giá rồi -->
            <div class="bg-white rounded-2xl border border-emerald-200 p-8 text-center shadow-sm">
                <i class="ph ph-check-circle-fill text-5xl text-emerald-500 mb-3 block"></i>
                <h1 class="text-xl font-bold text-slate-800 mb-1">Cảm ơn bạn!</h1>
                <p class="text-sm text-slate-500 mb-4">Bạn đã gửi đánh giá @_evaluation.SubmittedAt?.ToString("dd/MM/yyyy").
                </p>
                <div class="flex justify-center gap-1.5 text-3xl">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starIndex = i;
                        var isSelected = starIndex <= (_evaluation.Rating ?? 0);
                        <i class="ph ph-star @(isSelected ? "ph-fill text-amber-500" : "text-slate-300")"></i>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_evaluation.Comment))
                {
                    <p class="mt-3 text-sm text-slate-600 italic">"@_evaluation.Comment"</p>
                }
            </div>
        }
        else
        {
            <!-- Form đánh giá -->
            <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
                <div class="text-center mb-6">
                    <span
                    class="inline-block bg-primary/10 text-primary text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full mb-3">SmartClinic</span>
                    <h1 class="text-2xl font-bold text-slate-800">Đánh giá lần khám của bạn</h1>
                    <p class="text-sm text-slate-500 mt-1">
                        Bác sĩ: <b>@(_evaluation.Doctor?.FullName ?? "—")</b>
                    </p>
                </div>

                <!-- Star Rating -->
                <div class="mb-8 text-center">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4">Mức độ hài lòng *</p>
                    <div class="flex gap-3 justify-center" @onmouseout="() => _hoverRating = 0">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var starIndex = i;
                            var isActive = starIndex <= (_hoverRating > 0 ? _hoverRating : _rating);

                            <button type="button" @onclick="() => _rating = starIndex"
                                    @onmouseover="() => _hoverRating = starIndex"
                                    class="transition-all duration-200 hover:scale-125 focus:outline-none">
                                <i class="ph ph-star text-5xl @(isActive ? "ph-fill text-amber-500" : "text-slate-300")"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Comment -->
                <div class="mb-6">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 block">Nhận xét (tuỳ
                        chọn)</label>
                        <textarea @bind="_comment" rows="4"
                                  placeholder="Bạn cảm thấy thế nào về dịch vụ, thái độ bác sĩ, thời gian chờ...?"
                                      class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm text-slate-700 resize-none focus:outline-none focus:ring-2 focus:ring-primary/30">
                    </textarea>
                        </div>

                        <!-- Submit -->
                        @if (!string.IsNullOrWhiteSpace(_errorMsg))
                        {
                            <p class="text-red-500 text-xs mb-3">@_errorMsg</p>
                        }
                        <button @onclick="SubmitAsync" disabled="@(_isSaving || _rating == 0)"
                                class="w-full py-3 bg-primary text-white font-bold rounded-xl text-sm hover:bg-primary/90 transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                            @if (_isSaving)
                            {
                                <i class="ph ph-spinner-gap animate-spin"></i>
                            }
                            Gửi đánh giá
                        </button>
                        <p class="text-center text-[11px] text-slate-400 mt-3">Bạn cần chọn ít nhất 1 sao để gửi.</p>
                    </div>
                }
            </div>
        </div>

@code {
    [Parameter] public Guid EvaluationId { get; set; }

    private DoctorEvaluation? _evaluation;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private int _rating = 0;
    private int _hoverRating = 0;
    private string _comment = "";
    private string _errorMsg = "";

    protected override async Task OnInitializedAsync()
    {
        using var ctx = DbFactory.CreateDbContext();
        _evaluation = await ctx.DoctorEvaluations
            .Include(e => e.Doctor)
            .Include(e => e.QueueTicket)
            .AsNoTracking()
            .FirstOrDefaultAsync(e => e.Id == EvaluationId);

        _isLoading = false;
    }

    private async Task SubmitAsync()
    {
        if (_rating == 0)
        {
            _errorMsg = "Vui lòng chọn ít nhất 1 sao.";
            return;
        }

        _isSaving = true;
        _errorMsg = "";
        StateHasChanged();

        try
        {
            using var ctx = DbFactory.CreateDbContext();
            var record = await ctx.DoctorEvaluations.FindAsync(EvaluationId);
            if (record == null || record.IsSubmitted)
            {
                _errorMsg = "Đánh giá không hợp lệ hoặc đã được gửi.";
                return;
            }

            record.Rating = _rating;
            record.Comment = _comment.Trim();
            record.IsSubmitted = true;
            record.SubmittedAt = DateTime.Now;

            await ctx.SaveChangesAsync();

            // Reload để hiển thị màn hình cảm ơn
            _evaluation = record;
        }
        catch (Exception ex)
        {
            _errorMsg = "Có lỗi xảy ra: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
}
