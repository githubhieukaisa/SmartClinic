@page "/doctor/dashboard"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.Components.Layout
@using SmartClinic.Constant
@using SmartClinic.Models
@using SmartClinic.Services
@using Blazored.Toast.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
@layout MainLayout
@inject IDbContextFactory<SmartClinicDbContext> DbFactory
@inject PatientService PatientService
@inject NavigationManager NavigationManager
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITicketService TicketService
@inject DoctorDailyShiftService DailyShiftService
@implements IAsyncDisposable
@attribute [Authorize(Policy = "DoctorPolicy")]

<div class="p-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-foreground">Tổng Quan</h1>
            <p class="text-muted-foreground mt-1">Chào mừng trở lại!</p>
        </div>
        <div class="flex items-center gap-4">

            <div class="text-right">
                <p class="text-sm font-medium text-foreground">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</p>
                <p class="text-xs text-muted-foreground">@DateTime.Now.ToString("HH:mm")</p>
            </div>
            <button class="relative p-2 hover:bg-muted rounded-lg transition">
                <i class="ph ph-bell text-xl text-foreground"></i>
                <span class="absolute top-1 right-1 w-2 h-2 bg-destructive rounded-full"></span>
            </button>
        </div>
    </div>

    <!-- Appointment Summary -->
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-foreground">Tổng quan hàng đợi</h2>
        <div class="flex items-center gap-2 bg-muted p-1 rounded-lg">
            <button @onclick="@(() => SetFilterAsync("Day"))"
                    class="px-3 py-1 rounded-md text-sm font-medium transition @(_filterPeriod == "Day" ? "bg-background shadow-sm text-foreground" : "text-muted-foreground hover:text-foreground")">Hôm
                nay</button>
                <button @onclick="@(() => SetFilterAsync("Week"))"
                        class="px-3 py-1 rounded-md text-sm font-medium transition @(_filterPeriod == "Week" ? "bg-background shadow-sm text-foreground" : "text-muted-foreground hover:text-foreground")">Tuần
                    này</button>
                    <button @onclick="@(() => SetFilterAsync("Month"))"
                            class="px-3 py-1 rounded-md text-sm font-medium transition @(_filterPeriod == "Month" ? "bg-background shadow-sm text-foreground" : "text-muted-foreground hover:text-foreground")">Tháng
                        này</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-semibold text-foreground text-sm">Tổng số hàng đợi</h4>
                            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center">
                                <i class="ph ph-queue text-xl text-primary"></i>
                            </div>
                        </div>
                        <p class="text-3xl font-bold text-primary">@TotalCount</p>
                        <div class="mt-4 bg-primary/10 rounded-full h-2">
                            <div class="bg-primary h-full rounded-full" style="width: 100%"></div>
                        </div>
                    </div>

                    <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-semibold text-foreground text-sm">Đang chờ khám</h4>
                            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                                <i class="ph ph-hourglass text-xl text-amber-600"></i>
                            </div>
                        </div>
                        <p class="text-3xl font-bold text-amber-600">@WaitingCount</p>
                        <div class="mt-4 bg-amber-100 rounded-full h-2">
                            <div class="bg-amber-500 h-full rounded-full" style="width: @WaitingPct%"></div>
                        </div>
                    </div>

                    <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-semibold text-foreground text-sm">Đang khám / Xét nghiệm</h4>
                            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="ph ph-clock text-xl text-blue-600"></i>
                            </div>
                        </div>
                        <p class="text-3xl font-bold text-blue-600">@InProgressCount</p>
                        <div class="mt-4 bg-blue-100 rounded-full h-2">
                            <div class="bg-blue-600 h-full rounded-full" style="width: @InProgressPct%"></div>
                        </div>
                    </div>
                </div>

                <!-- Main Content Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Dashboard Tables -->
                    <div class="lg:col-span-2 space-y-6">
                        <!-- Testing Queue -->
                        <div class="bg-card rounded-xl border border-border p-6 shadow-sm">
                            <div class="flex items-center justify-between mb-6">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center">
                                        <i class="ph ph-flask text-lg text-purple-600"></i>
                                    </div>
                                    <h2 class="text-lg font-bold text-foreground">Bệnh nhân đang xét nghiệm</h2>
                                </div>
                                <button @onclick='() => NavigationManager.NavigateTo("/doctor/my-patients")'
                                        class="flex items-center gap-1 text-primary hover:text-primary/80 text-sm font-medium transition">
                                    Xem hàng đợi <i class="ph ph-arrow-right"></i>
                                </button>
                            </div>

                            <div class="overflow-x-auto">
                                @if (!_testingTickets.Any())
                                {
                                    <div class="flex flex-col items-center justify-center py-8 text-muted-foreground">
                                        <i class="ph ph-check-circle text-4xl mb-2 text-muted-foreground/50"></i>
                                        <span class="text-sm">Không có bệnh nhân nào đang đợi kết quả xét nghiệm.</span>
                                    </div>
                                }
                                else
                                {
                                    <table class="w-full text-sm">
                                        <thead>
                                            <tr class="border-b border-border bg-muted/30">
                                                <th class="text-center py-3 px-4 font-semibold text-muted-foreground w-16">STT</th>
                                                <th class="text-left py-3 px-4 font-semibold text-muted-foreground">Bệnh nhân</th>
                                                <th class="text-left py-3 px-4 font-semibold text-muted-foreground">Trạng thái</th>
                                                <th class="text-right py-3 px-4 font-semibold text-muted-foreground">Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var t in _testingTickets)
                                            {
                                                <tr class="border-b border-border transition hover:bg-muted/30">
                                                    <td class="py-3 px-4 font-bold text-foreground text-center">@t.TicketNumber</td>
                                                    <td class="py-3 px-4">
                                                        <p class="font-medium text-foreground">@t.PatientUser?.FullName</p>
                                                        <p class="text-xs text-muted-foreground mt-0.5">@t.PatientUser?.PhoneNumber</p>
                                                    </td>
                                                    <td class="py-3 px-4 text-left">
                                                        <span
                                                            class='@($"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium {GetStatusClass(t.StatusEnum)}")'>
                                                            @TranslateStatus(t.StatusEnum)
                                                        </span>
                                                    </td>
                                                    <td class="py-3 px-4 text-right">
                                                        <button
                                                            @onclick='() => NavigationManager.NavigateTo($"/doctor/examination/{t.Id}/{t.PatientId}")'
                                                            class="flex items-center justify-end gap-1 w-full text-primary hover:text-primary/80 font-medium text-xs">
                                                            Đọc KQ <i class="ph ph-arrow-right"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>

                        <!-- Recently Completed -->
                        <div class="bg-card rounded-xl border border-border p-6 shadow-sm">
                            <div class="flex items-center justify-between mb-6">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center">
                                        <i class="ph ph-check-circle text-lg text-green-600 font-bold"></i>
                                    </div>
                                    <h2 class="text-lg font-bold text-foreground">Khám xong gần đây</h2>
                                </div>
                            </div>

                            <div class="overflow-x-auto">
                                @if (!_recentCompletedTickets.Any())
                                {
                                    <div class="text-center py-6 text-muted-foreground text-sm">
                                        Chưa có bệnh nhân nào hoàn tất khám hôm nay.
                                    </div>
                                }
                                else
                                {
                                    <table class="w-full text-sm">
                                        <tbody>
                                            @foreach (var t in _recentCompletedTickets)
                                            {
                                                <tr class="border-b border-border last:border-0 transition hover:bg-muted/30">
                                                    <td
                                                        class="py-3 px-4 font-bold text-foreground w-16 text-center text-muted-foreground/70">
                                                        @t.TicketNumber</td>
                                                        <td class="py-3 px-4">
                                                            <p class="font-medium text-foreground">@t.PatientUser?.FullName</p>
                                                        </td>
                                                        <td class="py-3 px-4 text-right text-muted-foreground text-xs">
                                                            @(t.UpdatedAt?.ToString("HH:mm") ?? t.CreatedAt.ToString("HH:mm"))
                                                        </td>
                                                        <td class="py-3 px-4 text-right">
                                                            <div class="flex justify-end">
                                                                <button @onclick='() => NavigationManager.NavigateTo($"/medical-record/{t.Id}")'
                                                                        class="flex items-center gap-1.5 px-3 py-1.5 text-primary hover:bg-muted rounded-lg text-xs font-medium transition"
                                                                        title="Xem hồ sơ bệnh án">
                                                                    <i class="ph ph-file-text"></i>
                                                                    Xem hồ sơ
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="space-y-6">
                            <!-- Quick Actions -->
                            <div class="bg-card rounded-xl border border-border p-6 shadow-sm">
                                <div class="flex items-center gap-2 mb-4">
                                    <i class="ph ph-lightning text-xl text-foreground"></i>
                                    <h3 class="text-lg font-bold text-foreground">Tiện ích nhanh</h3>
                                </div>
                                <div class="space-y-3">
                                    <button @onclick='() => NavigationManager.NavigateTo("/doctor/my-patients")'
                                            class="w-full flex items-center justify-center gap-2 bg-primary text-primary-foreground py-3 rounded-lg font-medium hover:bg-primary/90 transition shadow-sm">
                                        <i class="ph ph-monitor-play"></i> Mở màn hình nhận bệnh
                                    </button>
                                    <button @onclick="OpenWaitingRoom"
                                            class="w-full flex items-center justify-center gap-2 bg-primary/10 text-primary py-3 rounded-lg font-medium hover:bg-primary/20 transition">
                                        <i class="ph ph-monitor"></i> Màn hình chờ (Tivi)
                                    </button>
                                </div>
                            </div>

                            <!-- Shift Info -->
                            <div class="bg-card rounded-xl border border-border p-6 shadow-sm">
                                <div class="flex items-center gap-2 mb-4">
                                    <i class="ph ph-clock text-xl text-foreground"></i>
                                    <h3 class="text-lg font-bold text-foreground">Ca trực hiện tại</h3>
                                </div>
                                @if (DailyShiftService.IsOnDuty && DailyShiftService.CurrentRoomId.HasValue)
                                {
                                    <div class="bg-emerald-50 rounded-lg p-4 border border-emerald-100">
                                        <div class="flex items-center justify-between mb-3 border-b border-emerald-100 pb-3">
                                            <span class="text-sm text-emerald-600">Phòng khám</span>
                                            <span class="font-bold text-emerald-800">Phòng @DailyShiftService.CurrentRoomId.Value</span>
                                        </div>
                                        <div class="flex items-center justify-between mb-3 border-b border-emerald-100 pb-3">
                                            <span class="text-sm text-emerald-600">Trạng thái</span>
                                            <span class="inline-flex items-center gap-1 text-xs font-black text-emerald-700 uppercase">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                                ĐANG TRỰC
                                            </span>
                                        </div>
                                        <div class="text-[10px] text-emerald-500 italic text-center mt-2">
                                            Dữ liệu cập nhật thời gian thực
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-8 rounded-lg border border-dashed border-slate-200 bg-slate-50">
                                        <div
                                            class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-3 shadow-sm">
                                            <i class="ph ph-moon text-slate-400 text-xl"></i>
                                        </div>
                                        <p class="text-sm font-bold text-slate-500">Ngoài ca trực</p>
                                        <p class="text-[10px] text-slate-400 mt-1 px-4">Bạn chưa được phân ca trực nào trong khung giờ này.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

@code {
    private int _currentDoctorId = 0;

    // Lists for main content
    private List<QueueTicket> _testingTickets = new();
    private List<QueueTicket> _recentCompletedTickets = new();
    private DoctorShift? _currentShift;
    private int? _currentRoomId;
    private string? _roomName;
    private bool _isLoading = true; // Thêm biến tracking loading state

    // Summary logic
    private int TotalCount = 0;
    private int WaitingCount = 0;
    private int InProgressCount = 0;
    private int WaitingPct => TotalCount > 0 ? WaitingCount * 100 / TotalCount : 0;
    private int InProgressPct => TotalCount > 0 ? InProgressCount * 100 / TotalCount : 0;
    private string _filterPeriod = "Day"; // Day, Week, Month

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            var claim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (claim != null && int.TryParse(claim.Value, out int id))
            {
                _currentDoctorId = id;

                // Subscribe to shift changes (Initialized by MainLayout)
                DailyShiftService.OnShiftStateChanged += HandleShiftStateChanged;
            }
        }

        // Fire and forget
        _ = LoadCompleteDashboardDataAsync();
    }

    private void HandleShiftStateChanged()
    {
        _ = LoadCompleteDashboardDataAsync();
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        DailyShiftService.OnShiftStateChanged -= HandleShiftStateChanged;
        await ValueTask.CompletedTask;
    }

    private async Task LoadCompleteDashboardDataAsync()
    {
        if (_currentDoctorId <= 0) return;

        try
        {
            // 1. Get room context from centralized DailyShiftService
            // No need to query DB for shift again - layout handles it.
            _currentRoomId = DailyShiftService.CurrentRoomId;

            // 2. Fetch queue summary using the found roomId
            var summary = await PatientService.GetDoctorDashboardSummaryAsync(_currentDoctorId, _filterPeriod);

            TotalCount = summary.TotalCount;
            WaitingCount = summary.WaitingCount;
            InProgressCount = summary.InProgressCount;
            _testingTickets = summary.TestingTickets;
            _recentCompletedTickets = summary.RecentCompletedTickets;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error dashboard load: {ex.Message}");
            ToastService.ShowError("Không thể tải dữ liệu tổng quan.");
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetFilterAsync(string period)
    {
        _filterPeriod = period;
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        // Hàm này giờ chỉ cần gọi lại hàm tổng hợp để đồng bộ
        await LoadCompleteDashboardDataAsync();
    }

    private static string GetStatusClass(TicketStatus status) => status switch
    {
        TicketStatus.Done => "bg-green-100 text-green-700",
        TicketStatus.Completed => "bg-teal-100 text-teal-700",
        TicketStatus.Examinating => "bg-cyan-100 text-cyan-700",
        TicketStatus.Calling => "bg-orange-100 text-orange-700",
        TicketStatus.Waiting => "bg-amber-100 text-amber-700",
        TicketStatus.Testing => "bg-purple-100 text-purple-700",
        TicketStatus.Missed => "bg-red-100 text-red-700",
        TicketStatus.Cancelled => "bg-slate-100 text-slate-700",
        _ => "bg-gray-100 text-gray-700"
    };

    private static string TranslateStatus(TicketStatus status) => status switch
    {
        TicketStatus.Waiting => "Chờ khám",
        TicketStatus.Calling => "Đang gọi",
        TicketStatus.Examinating => "Đang khám",
        TicketStatus.Testing => "Đang xét nghiệm",
        TicketStatus.Completed => "Đã khám xong",
        TicketStatus.Done => "Hoàn tất",
        TicketStatus.Missed => "Trễ hẹn",
        TicketStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static string GetRowBgClass(TicketStatus status) => status switch
    {
        TicketStatus.Done => "bg-green-50",
        TicketStatus.Completed => "bg-teal-50",
        TicketStatus.Examinating => "bg-cyan-50",
        TicketStatus.Calling => "bg-orange-50",
        TicketStatus.Waiting => "bg-amber-50",
        TicketStatus.Testing => "bg-purple-50",
        TicketStatus.Missed => "bg-red-50",
        TicketStatus.Cancelled => "bg-slate-50",
        _ => ""
    };

    // ── TEST ONLY — xóa khi production ─────────────────────────────────────
    private bool _isAddingTestTicket = false;

    private async Task AddTestQueueTicketAsync()
    {
        if (_isAddingTestTicket) return;
        _isAddingTestTicket = true;

        try
        {
            if (_currentDoctorId == 0)
            {
                ToastService.ShowError("Cannot determine current doctor. Please re-login.");
                return;
            }

            if (_currentRoomId == null)
            {
                ToastService.ShowError("Chưa vào ca trực, không thể tạo vé mẫu.");
                return;
            }

            await TicketService.GenerateTicketAsync(
                $"Bệnh nhân mẫu {DateTime.Now:HHmmss}",
                "0900000000",
                _currentShift?.Room?.DepartmentId ?? 1
            );
            ToastService.ShowSuccess("Thêm vé mẫu thành công.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi khi tải mẫu: {ex.Message}");
        }
        finally
        {
            _isAddingTestTicket = false;
        }
    }

    private void OpenWaitingRoom()
    {
        if (_currentRoomId.HasValue && _currentRoomId.Value > 0)
        {
            // Do màn hình chờ là giao diện Tivi (Kiosk mode), nên mở sang tab mới bằng JSRuntime (nếu có)
            // Tuy nhiên với Blazor Server, NavigateTo vẫn là cách chuẩn, user có thể bấm chuột giữa để mở tab mới.
            NavigationManager.NavigateTo($"/waiting-room/{_currentRoomId.Value}");
        }
        else
        {
            ToastService.ShowError("Bạn chưa được phân phòng, không thể mở màn hình chờ.");
        }
    }

    private async Task SimulateShiftChangeAsync()
    {
        try
        {
            if (_currentDoctorId <= 0)
            {
                ToastService.ShowError("Chưa xác nhận được DoctorId, vui lòng tải lại trang.");
                return;
            }
            var now = DateTime.Now;

            // 1. Lấy tất cả ca trực đang diễn ra và ĐÓNG lại (Completed)
            using var context = DbFactory.CreateDbContext();
            var currentShifts = await context.DoctorShifts
                .Where(s => s.DoctorId == _currentDoctorId && s.StatusEnum == DoctorShiftStatus.Active)
                .ToListAsync();

            foreach (var shift in currentShifts)
            {
                shift.StatusEnum = DoctorShiftStatus.Completed;
                if (shift.EndTime == null || shift.EndTime > now)
                {
                    shift.EndTime = now; // Ép kết thúc tại thời điểm hiện tại
                }
            }

            // 🐛 [FIX LỖI SUPABASE/POSTGRES BỊ KẸT SEQUENCE]
            // Tìm số ID to nhất đang có trong DB và cộng thêm 1 để ép vô thẳng khoá chính
            var maxId = await context.DoctorShifts.MaxAsync(s => (int?)s.Id) ?? 0;
            // Giả lập 1 phút nữa Bác sĩ _currentDoctorId sẽ phải chạy sang trực Phòng số 6
            var fakeShift = new DoctorShift
            {
                Id = maxId + 1, // Ép mã tránh đụng độ bộ đếm
                DoctorId = _currentDoctorId,
                RoomId = 6, // Nếu DB bạn đang ko có Room 6, báo lỗi foreign key. Bạn có thể sửa tên mã này.
                StartTime = now.AddSeconds(15), // Đúng 60 giây nữa bắt đầu tính ca
                EndTime = now.AddHours(4),
                StatusEnum = DoctorShiftStatus.Active
            };
            context.DoctorShifts.Add(fakeShift);
            await context.SaveChangesAsync();
            ToastService.ShowInfo($"Đã xếp lịch: Ca trực ảo tại Phòng 6 sẽ bắt đầu lúc {fakeShift.StartTime.ToString("HH:mm:ss")}. (hãy đợi và kiểm tra log console!)");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Có lỗi: " + ex.Message);
        }
    }
    // ─────────────────────────────────────────────────────────────────────────


}
