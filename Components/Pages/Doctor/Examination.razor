@page "/doctor/examination/{TicketId:int}/{PatientId:int}"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.Constant
@using SmartClinic.Models
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@using SmartClinic.Components.Common
@using SmartClinic.Components.Common.Examination
@using Blazored.Toast.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@layout MainLayout
@inject PatientService PatientService
@inject NavigationManager NavigationManager
@inject IDbContextFactory<SmartClinicDbContext> DbFactory
@inject IToastService ToastService
@inject IPharmacyService PharmacyService
@inject ILabService LabService
@attribute [Authorize(Policy = "DoctorPolicy")]
@inject AiService AiService
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider


<div class="p-8">
    <!-- Back Button -->
    <div class="mb-6">
        <button @onclick="GoBack"
                class="flex items-center gap-2 px-4 py-2 text-primary hover:bg-muted rounded-lg transition">
            <i class="ph ph-arrow-left"></i>
            Quay về Hàng đợi
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground">
            <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
            <span class="text-sm">Đang tải thông tin bệnh nhân...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-red-100 border border-red-300 rounded-lg p-4 mb-6">
            <p class="text-red-700 font-medium">Lỗi khi tải thông tin bệnh nhân</p>
            <p class="text-red-600 text-sm">@_errorMessage</p>
        </div>
    }
    else if (_patient == null)
    {
        <div class="bg-yellow-100 border border-yellow-300 rounded-lg p-4 mb-6">
            <p class="text-yellow-700">Không tìm thấy thông tin bệnh nhân</p>
        </div>
    }
    else
    {
        <!-- Header with Patient Info -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Patient Details -->
                <div>
                    <h1 class="text-3xl font-bold text-foreground mb-4">Khám bệnh</h1>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-muted-foreground">Họ và tên</p>
                            <p class="text-foreground font-medium">@_patient.FullName</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Tuổi</p>
                            <p class="text-foreground font-medium">
                                @if (_patient.DoB.HasValue)
                                {
                                    @($"{GetAge(_patient.DoB)} tuổi")
                                }
                                else
                                {
                                    @("—")
                                }
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Số điện thoại</p>
                            <p class="text-foreground font-medium">@_patient.PhoneNumber</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Địa chỉ</p>
                            <p class="text-foreground font-medium text-sm">@_patient.Address</p>
                        </div>
                    </div>
                </div>

                <!-- Ticket Info -->
                <div>
                    <h3 class="text-lg font-semibold text-foreground mb-4">Thông tin hàng đợi</h3>
                    <div class="space-y-3">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs text-muted-foreground">Số thứ tự</p>
                                <p class="text-foreground font-medium text-lg">#@TicketId</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-muted-foreground">Trạng thái</p>
                                <p class="inline-block px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-blue-700">
                                    Đang khám
                                </p>
                            </div>
                        </div>
                        
                        <!-- History Access Section -->
                        <div class="mt-4 p-4 rounded-xl border border-slate-200 bg-slate-50/50">
                            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3 flex items-center gap-2">
                                <i class="ph ph-shield-check"></i> Quyền xem bệnh án cũ
                            </h4>
                            
                            @if (_currentTicket?.HistoryAccess == null)
                            {
                                <button @onclick="RequestHistoryAccessAsync" 
                                        class="w-full py-2.5 bg-primary/10 text-primary border border-primary/20 text-[11px] font-black uppercase tracking-widest rounded-lg hover:bg-primary hover:text-white transition-all shadow-sm flex items-center justify-center gap-2">
                                    <i class="ph ph-shield-star"></i> YÊU CẦU CẤP QUYỀN (OTP)
                                </button>
                            }
                            else if (!_currentTicket.HistoryAccess.IsUnlocked)
                            {
                                <div class="space-y-2">
                                    <div class="flex gap-2">
                                        <input @bind="_inputOtp" placeholder="Nhập mã OTP..." 
                                               class="flex-1 px-3 py-1.5 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary/20" />
                                        <button @onclick="VerifyHistoryOtpAsync" 
                                                class="px-4 py-1.5 bg-primary text-white text-[10px] font-black uppercase rounded-lg hover:bg-primary/90 transition shadow-sm">
                                            XÁC MINH
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_currentTicket.HistoryAccess.UnlockCode))
                                    {
                                        <p class="text-[10px] text-amber-600 italic">
                                            Mã đã gửi cho bệnh nhân. Hết hạn lúc: @_currentTicket.HistoryAccess.CodeExpiryTime?.ToString("HH:mm")
                                        </p>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-between text-emerald-600">
                                    <span class="text-xs font-bold flex items-center gap-1">
                                        <i class="ph ph-check-circle-fill"></i> Đã mở khóa bệnh án
                                    </span>
                                    <button @onclick="() => _showHistoryDetails = !_showHistoryDetails" 
                                            class="text-[10px] underline font-bold uppercase">
                                        @(_showHistoryDetails ? "Đóng" : "Xem danh sách")
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Expanded History Links -->
            @if (_showHistoryDetails && _pastRecords.Any())
            {
                <div class="mt-6 pt-6 border-t border-slate-100 animate-in fade-in slide-in-from-top-2 duration-300">
                    <h4 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="ph ph-clock-counter-clockwise"></i> Lịch sử khám bệnh trước đây
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        @foreach (var record in _pastRecords)
                        {
                            <a href="/medical-record/@record.Id" target="_blank"
                               class="p-3 border border-slate-200 rounded-xl hover:border-primary hover:bg-slate-50 transition block no-underline">
                                <div class="flex justify-between items-start mb-1">
                                    <span class="text-[10px] font-black text-primary bg-primary/10 px-1.5 py-0.5 rounded">#@record.Id</span>
                                    <span class="text-[10px] text-slate-400">@record.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                                <p class="text-xs font-bold text-slate-800 line-clamp-1">@(record.Diagnosis ?? "Không có chẩn đoán")</p>
                                <p class="text-[10px] text-slate-500 mt-1 italic">Bác sĩ: @(record.Doctor?.FullName ?? "—")</p>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Medical Record Section -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="flex items-center gap-3 mb-6">
                <i class="ph ph-file-text text-2xl text-primary"></i>
                <h2 class="text-xl font-bold text-foreground">Hồ Sơ Khám Bệnh</h2>
            </div>

            <!-- AI Quick Input Area -->
            @if (!_isReadOnly)
            {
                <div class="mb-8 p-4 bg-slate-50 border border-slate-200 rounded-xl">
                    <div class="flex items-center justify-between mb-3">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">AI Phụ tá (Nhập nhanh tại
                            đây)</label>
                            <div class="flex items-center gap-2">
                                @if (_isAiLoading)
                                {
                                    <span class="text-xs text-primary animate-pulse flex items-center gap-1">
                                        <i class="ph ph-sparkle"></i> AI đang phân tích...
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <input @bind="_aiRawInput" @bind:event="oninput" @onkeyup="HandleAiKeydown"
                                   placeholder="Ví dụ: đau họng, sốt nhẹ, viêm họng cấp..."
                                   class="flex-1 px-4 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 bg-white" />
                            <button @onclick="ProcessAiRefinementAsync"
                                    disabled="@(string.IsNullOrWhiteSpace(_aiRawInput) || _isAiLoading)"
                                    class="px-4 py-2 bg-primary text-primary-foreground rounded-lg text-sm font-medium hover:bg-primary/90 transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2">
                                <i class="ph ph-magic-wand"></i> Standardize
                            </button>
                        </div>
                        <p class="mt-2 text-[11px] text-slate-400 italic">Gợi ý: Nhập triệu chứng tóm tắt rồi nhấn Standardize để AI
                            tự động điền hồ sơ chuẩn.</p>
                        </div>
                    }

                    <div class="space-y-6">
                        <!-- Diagnosis -->
                        <div>
                            <label class="block text-sm font-medium text-foreground mb-2">Chẩn đoán</label>
                            <textarea @bind="_diagnosis" disabled="@_isReadOnly"
                                      class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary disabled:bg-slate-50 disabled:text-slate-500"
                                      rows="4" placeholder="Nhập chẩn đoán và kết quả thăm khám..."></textarea>
                        </div>

                        <!-- Treatment Plan -->
                        <div>
                            <label class="block text-sm font-medium text-foreground mb-2">Kế hoạch điều trị</label>
                            <textarea @bind="_treatmentPlan" disabled="@_isReadOnly"
                                      class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary disabled:bg-slate-50 disabled:text-slate-500"
                                      rows="4" placeholder="Nhập kế hoạch điều trị và lời khuyên..."></textarea>
                        </div>

                        <!-- Additional Notes -->
                        <div>
                            <label class="block text-sm font-medium text-foreground mb-2">Ghi chú thêm</label>
                            <textarea @bind="_notes" disabled="@_isReadOnly"
                                      class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary disabled:bg-slate-50 disabled:text-slate-500"
                                      rows="3" placeholder="Các ghi chú lâm sàng khác..."></textarea>
                        </div>

                        <!-- Save Medical Record Button -->
                        @if (!_isReadOnly)
                        {
                            <SaveActionButton OnClick="SaveMedicalRecordAsync" Label="Lưu Hồ Sơ" LoadingLabel="Đang lưu..."
                                              Icon="ph-floppy-disk"
                                              Disabled="@(string.IsNullOrWhiteSpace(_diagnosis) || string.IsNullOrWhiteSpace(_treatmentPlan) || string.IsNullOrWhiteSpace(_notes))" />
                        }
                    </div>
                </div>

                <!-- Lab Tests Section (Test) -->
                <LabOrderPanel TicketId="@TicketId" RoomId="@_currentRoomId" IsReadOnly="@_isReadOnly"
                               OnLabsUpdated="CheckPendingLabsAsync" />

                <!-- Medicine Section (Prescription) -->
                <PrescriptionPanel TicketId="@TicketId" IsReadOnly="@_isReadOnly" />

                <!-- Action Buttons -->
                <div class="flex gap-3 justify-end items-center">
                    @if (_hasPendingLabs)
                    {
                        <span
                            class="text-amber-600 text-xs font-bold flex items-center gap-2 bg-amber-50 px-3 py-2 rounded-lg border border-amber-200">
                            <i class="ph ph-warning-circle text-base animate-pulse"></i>
                            Đang chờ kết quả xét nghiệm...
                        </span>
                    }

                    <SaveActionButton OnClick="@(() => { GoBack(); return Task.CompletedTask; })" Label="Quay lại"
                                      LoadingLabel="Đang quay lại..." Icon="ph-arrow-left" />

                    @if (!_isReadOnly)
                    {
                        <SaveActionButton OnClick="CompleteExaminationAsync" Label="Hoàn tất khám" LoadingLabel="Đang hoàn tất..."
                                          Icon="ph-check" Variant="solid" ExtraCssClass="shadow-md"
                                          Disabled="@(string.IsNullOrWhiteSpace(_diagnosis) || string.IsNullOrWhiteSpace(_treatmentPlan) || string.IsNullOrWhiteSpace(_notes) || _hasPendingLabs)" />
                    }
                </div>
            }

            <!-- Prescription Confirmation Modal -->
            <Modal IsVisible="@_showPrescriptionConfirm" OnClose="() => _showPrescriptionConfirm = false"
                   Size="Modal.ModalSize.Md">
                <HeaderContent>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
                            <i class="ph ph-warning text-xl"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-amber-900">Chưa kê đơn thuốc</h3>
                        </div>
                    </div>
                </HeaderContent>

                <ChildContent>
                    <p class="text-sm text-foreground py-4">Bạn chưa kê đơn thuốc cho bệnh nhân này. Bạn có chắc chắn muốn
                        <b>Hoàn tất khám</b> mà không cần thuốc?
                    </p>
                </ChildContent>

                <FooterContent>
                    <div class="flex justify-end gap-3 w-full">
                        <button @onclick="() => _showPrescriptionConfirm = false"
                                class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-semibold hover:bg-slate-50 transition-colors text-sm">
                            Quay lại kê đơn
                        </button>
                        <button @onclick="FinishCompleteAsync"
                                class="px-4 py-2 rounded-xl bg-primary text-primary-foreground font-semibold hover:bg-primary/90 transition-colors text-sm">
                            Xác nhận hoàn tất
                        </button>
                    </div>
                </FooterContent>
            </Modal>
        </div>

@code {
    [Parameter]
    public int TicketId { get; set; }

    [Parameter]
    public int PatientId { get; set; }

    private int _currentRoomId = 0;
    private int _currentDoctorId = 0; // Thêm để tracking bác sĩ đang khám
    private User? _patient;
    private QueueTicket? _currentTicket;
    private List<QueueTicket> _pastRecords = new();
    private string _diagnosis = "";
    private string _treatmentPlan = "";
    private string _notes = "";
    private string _inputOtp = "";
    private bool _hasPendingLabs = false;
    private bool _showPrescriptionConfirm = false;
    private bool _isReadOnly = false;
    private bool _showHistoryDetails = false;

    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Lấy DoctorId từ AuthState
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out var id)) 
        {
            _currentDoctorId = id;
        }

        // Chạy ngầm việc tải dữ liệu
        _ = LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Background loading started for TicketId={TicketId}");

        try
        {
            // Thực hiện query song song
            var patientTask = PatientService.GetPatientByIdAsync(PatientId);
            var labsTask = LabService.HasPendingLabOrdersAsync(TicketId);

            using var context = DbFactory.CreateDbContext();

            await Task.WhenAll(patientTask, labsTask);

            _patient = await patientTask;
            _hasPendingLabs = await labsTask;

            // Lấy thông tin ticket song song với context riêng đã tạo
            _currentTicket = await context.QueueTickets
                .Include(t => t.HistoryAccess)
                .AsNoTracking()
                .FirstOrDefaultAsync(t => t.Id == TicketId);

            if (_patient == null)
            {
                _errorMessage = $"Không tìm thấy bệnh nhân có ID {PatientId}";
            }

            if (_currentTicket != null)
            {
                _isReadOnly = _currentTicket.StatusEnum == TicketStatus.Completed || _currentTicket.StatusEnum == TicketStatus.Done;
                _currentRoomId = _currentTicket.RoomId;
                _diagnosis = _currentTicket.Diagnosis ?? "";
                _treatmentPlan = _currentTicket.TreatmentPlan ?? "";
                _notes = _currentTicket.AdditionalNotes ?? "";

                // Load past records for this patient
                _pastRecords = await context.QueueTickets
                    .AsNoTracking()
                    .Include(t => t.Doctor)
                    .Where(t => t.PatientId == _currentTicket.PatientId && t.Id != TicketId && (t.StatusEnum == TicketStatus.Completed || t.StatusEnum == TicketStatus.Done))
                    .OrderByDescending(t => t.CreatedAt)
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Không thể tải hồ sơ bệnh nhân. Vui lòng thử lại sau.";
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            // Quan trọng: Gọi StateHasChanged từ luồng background để cập nhật UI
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CheckPendingLabsAsync()
    {
        _hasPendingLabs = await LabService.HasPendingLabOrdersAsync(TicketId);
        StateHasChanged();
    }

    private async Task SaveMedicalRecordAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Saving medical record for TicketId={TicketId}...");

        using var context = DbFactory.CreateDbContext();
        var queueTicket = await context.QueueTickets.FindAsync(TicketId);
        if (queueTicket == null)
        {
            _errorMessage = $"Không tìm thấy số thứ tự {TicketId}";
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] Queue ticket not found");
            ToastService.ShowError("Không tìm thấy thông tin lượt khám.");
            return;
        }

        queueTicket.Diagnosis = _diagnosis;
        queueTicket.TreatmentPlan = _treatmentPlan;
        queueTicket.AdditionalNotes = _notes;

        context.QueueTickets.Update(queueTicket);
        await context.SaveChangesAsync();

        _diagnosis = queueTicket.Diagnosis ?? "";
        _treatmentPlan = queueTicket.TreatmentPlan ?? "";
        _notes = queueTicket.AdditionalNotes ?? "";

        ToastService.ShowSuccess("Đã lưu hồ sơ khám bệnh thành công!");
        StateHasChanged();
    }

    private string _aiRawInput = "";
    private bool _isAiLoading = false;

    private async Task HandleAiKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_aiRawInput) && !_isAiLoading)
        {
            await ProcessAiRefinementAsync();
        }
    }

    private async Task ProcessAiRefinementAsync()
    {
        if (string.IsNullOrWhiteSpace(_aiRawInput)) return;

        try
        {
            _isAiLoading = true;
            StateHasChanged();

            var result = await AiService.RefineMedicalRecordAsync(_aiRawInput);

            if (result != null)
            {
                _diagnosis = result.Diagnosis;
                _treatmentPlan = result.Treatment;
                _notes = result.Notes;
                _aiRawInput = ""; // Clear input after success
                ToastService.ShowSuccess("AI đã chuẩn hóa hồ sơ thành công!");
            }
            else
            {
                ToastService.ShowError("AI không thể phản hồi lúc này. Vui lòng kiểm tra API Key.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi AI: {ex.Message}");
        }
        finally
        {
            _isAiLoading = false;
            StateHasChanged();
        }
    }

    private async Task CompleteExaminationAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Starting complete check for TicketId={TicketId}");

        // Check if any prescription exists (with at least one medicine)
        using (var context = DbFactory.CreateDbContext())
        {
            var hasPrescription = await context.Prescriptions
                .AnyAsync(p => p.TicketId == TicketId && p.PrescriptionDetails.Any());

            if (!hasPrescription && !_showPrescriptionConfirm)
            {
                _showPrescriptionConfirm = true;
                StateHasChanged();
                return;
            }
        }

        await FinishCompleteAsync();
    }

    private async Task FinishCompleteAsync()
    {
        _showPrescriptionConfirm = false;
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Finishing completion for TicketId={TicketId}");

        try
        {
            using var context = DbFactory.CreateDbContext();
            var ticket = await context.QueueTickets
                .Include(t => t.LabOrders)
                    .ThenInclude(lo => lo.LabOrderDetails)
                .FirstOrDefaultAsync(t => t.Id == TicketId);

            if (ticket != null)
            {
                // 1. Consultation fee (mặc định 300k)
                decimal total = 300000;

                // 2. Lab Fees
                var labTotal = ticket.LabOrders
                    .SelectMany(lo => lo.LabOrderDetails)
                    .Sum(lod => lod.UnitPrice);
                total += labTotal;

                // 3. Medicine Fees (lấy từ bảng Prescription liên kết với TicketId)
                var prescription = await context.Prescriptions
                    .FirstOrDefaultAsync(p => p.TicketId == TicketId);

                if (prescription != null)
                {
                    total += prescription.TotalAmount ?? 0;
                }

                // Update Ticket
                ticket.TotalAmount = total;
                ticket.StatusEnum = TicketStatus.Completed;
                ticket.Diagnosis = _diagnosis;
                ticket.TreatmentPlan = _treatmentPlan;
                ticket.AdditionalNotes = _notes;

                await context.SaveChangesAsync();
                ToastService.ShowSuccess($"Hoàn tất khám! Tổng quát: {total:N0} VNĐ");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] Complete error: {ex.Message}");
            ToastService.ShowError("Lỗi hệ thống khi hoàn tất khám. Vui lòng đảm bảo các xét nghiệm và đơn thuốc đã được chốt.");
            return;
        }

        System.Diagnostics.Debug.WriteLine($"✅ [Examination] Examination completed");
        NavigationManager.NavigateTo("/doctor/my-patients");
    }

    private async Task RequestHistoryAccessAsync()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            var ticket = await context.QueueTickets.Include(t => t.HistoryAccess).FirstOrDefaultAsync(t => t.Id == TicketId);
            if (ticket == null) return;

            var otp = new Random().Next(100000, 999999).ToString();
            
            if (ticket.HistoryAccess == null)
            {
                ticket.HistoryAccess = new HistoryAccess
                {
                   QueueTicketId = TicketId,
                   UnlockCode = otp,
                   CodeExpiryTime = DateTime.Now.AddMinutes(10),
                   IsUnlocked = false
                };
            }
            else
            {
                ticket.HistoryAccess.UnlockCode = otp;
                ticket.HistoryAccess.CodeExpiryTime = DateTime.Now.AddMinutes(10);
                ticket.HistoryAccess.IsUnlocked = false;
            }

            // Đảm bảo DoctorId của ticket trùng với bác sĩ đang thao tác (để query Auth chính xác)
            if (ticket.DoctorId == null || ticket.DoctorId != _currentDoctorId)
            {
                ticket.DoctorId = _currentDoctorId;
            }

            await context.SaveChangesAsync();
            _currentTicket = ticket;
            
            ToastService.ShowInfo($"Mã OTP đã được tạo: {otp} (Giả định gửi qua SMS/Email)");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Không thể tạo mã yêu cầu: " + ex.Message);
        }
    }

    private async Task VerifyHistoryOtpAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputOtp)) return;

        try
        {
            using var context = DbFactory.CreateDbContext();
            var ticket = await context.QueueTickets.Include(t => t.HistoryAccess).FirstOrDefaultAsync(t => t.Id == TicketId);
            
            if (ticket?.HistoryAccess == null) return;

            if (ticket.HistoryAccess.UnlockCode == _inputOtp && ticket.HistoryAccess.CodeExpiryTime > DateTime.Now)
            {
                ticket.HistoryAccess.IsUnlocked = true;
                ticket.HistoryAccess.UnlockedAt = DateTime.Now;
                
                // Đồng bộ DoctorId (Double check)
                if (ticket.DoctorId == null || ticket.DoctorId != _currentDoctorId)
                {
                    ticket.DoctorId = _currentDoctorId;
                }

                await context.SaveChangesAsync();
                _currentTicket = ticket;
                _showHistoryDetails = true;
                ToastService.ShowSuccess("Đã xác minh và mở khóa hồ sơ bệnh án!");
            }
            else
            {
                ToastService.ShowError("Mã OTP không đúng hoặc đã hết hạn.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi xác minh: " + ex.Message);
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/doctor/my-patients");
    }

    private static int GetAge(DateOnly? dob)
    {
        if (!dob.HasValue) return 0;
        var age = DateTime.Today.Year - dob.Value.Year;
        if (dob.Value.ToDateTime(TimeOnly.MinValue) > DateTime.Today.AddYears(-age)) age--;
        return age;
    }
