@page "/doctor/examination/{TicketId:int}/{PatientId:int}"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.Constant
@using SmartClinic.Models
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@using SmartClinic.Components.Common
@using SmartClinic.Components.Common.Examination
@using Blazored.Toast.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@layout MainLayout
@inject PatientService PatientService
@inject NavigationManager NavigationManager
@inject IDbContextFactory<SmartClinicDbContext> DbFactory
@inject IToastService ToastService
@inject IPharmacyService PharmacyService
@inject ILabService LabService
@attribute [Authorize(Policy = "DoctorPolicy")]


<div class="p-8">
    <!-- Back Button -->
    <div class="mb-6">
        <button @onclick="GoBack"
                class="flex items-center gap-2 px-4 py-2 text-primary hover:bg-muted rounded-lg transition">
            <i class="ph ph-arrow-left"></i>
            Quay về Hàng đợi
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground">
            <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
            <span class="text-sm">Đang tải thông tin bệnh nhân...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-red-100 border border-red-300 rounded-lg p-4 mb-6">
            <p class="text-red-700 font-medium">Lỗi khi tải thông tin bệnh nhân</p>
            <p class="text-red-600 text-sm">@_errorMessage</p>
        </div>
    }
    else if (_patient == null)
    {
        <div class="bg-yellow-100 border border-yellow-300 rounded-lg p-4 mb-6">
            <p class="text-yellow-700">Không tìm thấy thông tin bệnh nhân</p>
        </div>
    }
    else
    {
        <!-- Header with Patient Info -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Patient Details -->
                <div>
                    <h1 class="text-3xl font-bold text-foreground mb-4">Khám bệnh</h1>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-muted-foreground">Họ và tên</p>
                            <p class="text-foreground font-medium">@_patient.FullName</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Tuổi</p>
                            <p class="text-foreground font-medium">@GetAge(_patient.DoB) tuổi</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Số điện thoại</p>
                            <p class="text-foreground font-medium">@_patient.Phone</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Địa chỉ</p>
                            <p class="text-foreground font-medium">@_patient.Address</p>
                        </div>
                    </div>
                </div>

                <!-- Ticket Info -->
                <div>
                    <h3 class="text-lg font-semibold text-foreground mb-4">Thông tin hàng đợi</h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-muted-foreground">Số thứ tự</p>
                            <p class="text-foreground font-medium text-lg">#@TicketId</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Trạng thái</p>
                            <p class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                Đang khám
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Giờ đến</p>
                            <p class="text-foreground font-medium">@DateTime.Now.ToString("HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medical Record Section -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="flex items-center gap-3 mb-6">
                <i class="ph ph-file-text text-2xl text-primary"></i>
                <h2 class="text-xl font-bold text-foreground">Hồ Sơ Khám Bệnh</h2>
            </div>

            <div class="space-y-6">
                <!-- Diagnosis -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-2">Chẩn đoán</label>
                    <textarea @bind="_diagnosis"
                              class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                              rows="4" placeholder="Nhập chẩn đoán và kết quả thăm khám..."></textarea>
                </div>

                <!-- Treatment Plan -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-2">Kế hoạch điều trị</label>
                    <textarea @bind="_treatmentPlan"
                              class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                              rows="4" placeholder="Nhập kế hoạch điều trị và lời khuyên..."></textarea>
                </div>

                <!-- Additional Notes -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-2">Ghi chú thêm</label>
                    <textarea @bind="_notes"
                              class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                              rows="3" placeholder="Các ghi chú lâm sàng khác..."></textarea>
                </div>

                <!-- Save Medical Record Button -->
                <SaveActionButton OnClick="SaveMedicalRecordAsync" Label="Lưu Hồ Sơ" LoadingLabel="Đang lưu..."
                                  Icon="ph-floppy-disk"
                                  Disabled="@(string.IsNullOrWhiteSpace(_diagnosis) || string.IsNullOrWhiteSpace(_treatmentPlan) || string.IsNullOrWhiteSpace(_notes))" />
            </div>
        </div>

        <!-- Lab Tests Section (Test) -->
        <LabOrderPanel TicketId="@TicketId" RoomId="@_currentRoomId" OnLabsUpdated="CheckPendingLabsAsync" />

        <!-- Medicine Section (Prescription) -->
        <PrescriptionPanel TicketId="@TicketId" />

        <!-- Action Buttons -->
        <div class="flex gap-3 justify-end items-center">
            @if (_hasPendingLabs)
            {
                <span
                    class="text-amber-600 text-xs font-bold flex items-center gap-2 bg-amber-50 px-3 py-2 rounded-lg border border-amber-200">
                    <i class="ph ph-warning-circle text-base animate-pulse"></i>
                    Đang chờ kết quả xét nghiệm...
                </span>
            }

            <SaveActionButton OnClick="@(() => { GoBack(); return Task.CompletedTask; })" Label="Quay lại"
                              LoadingLabel="Đang quay lại..." Icon="ph-arrow-left" />

            <SaveActionButton OnClick="CompleteExaminationAsync" Label="Hoàn tất khám" LoadingLabel="Đang hoàn tất..."
                              Icon="ph-check" Variant="solid" ExtraCssClass="shadow-md"
                              Disabled="@(string.IsNullOrWhiteSpace(_diagnosis) || string.IsNullOrWhiteSpace(_treatmentPlan) || string.IsNullOrWhiteSpace(_notes) || _hasPendingLabs)" />
        </div>
    }

    <!-- Prescription Confirmation Modal -->
    <Modal IsVisible="@_showPrescriptionConfirm" OnClose="() => _showPrescriptionConfirm = false"
           Size="Modal.ModalSize.Md">
        <HeaderContent>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
                    <i class="ph ph-warning text-xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-amber-900">Chưa kê đơn thuốc</h3>
                </div>
            </div>
        </HeaderContent>

        <ChildContent>
            <p class="text-sm text-foreground py-4">Bạn chưa kê đơn thuốc cho bệnh nhân này. Bạn có chắc chắn muốn
                <b>Hoàn tất khám</b> mà không cần thuốc?
            </p>
        </ChildContent>

        <FooterContent>
            <div class="flex justify-end gap-3 w-full">
                <button @onclick="() => _showPrescriptionConfirm = false"
                        class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-semibold hover:bg-slate-50 transition-colors text-sm">
                    Quay lại kê đơn
                </button>
                <button @onclick="FinishCompleteAsync"
                        class="px-4 py-2 rounded-xl bg-primary text-primary-foreground font-semibold hover:bg-primary/90 transition-colors text-sm">
                    Xác nhận hoàn tất
                </button>
            </div>
        </FooterContent>
    </Modal>
</div>

@code {
    [Parameter]
    public int TicketId { get; set; }

    [Parameter]
    public int PatientId { get; set; }

    private int _currentRoomId = 0;
    private Patient? _patient;
    private string _diagnosis = "";
    private string _treatmentPlan = "";
    private string _notes = "";
    private bool _hasPendingLabs = false;
    private bool _showPrescriptionConfirm = false;

    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Loading data for TicketId={TicketId}, PatientId={PatientId}");

        try
        {
            _patient = await PatientService.GetPatientByIdAsync(PatientId);
            _hasPendingLabs = await LabService.HasPendingLabOrdersAsync(TicketId);

            if (_patient == null)
            {
                System.Diagnostics.Debug.WriteLine($"⚠️ [Examination] Patient not found with ID={PatientId}");
                _errorMessage = $"Không tìm thấy bệnh nhân có ID {PatientId}";
            }
            else
            {
                System.Diagnostics.Debug.WriteLine($"✅ [Examination] Loaded patient: {_patient.FullName}");
            }

            // Load existing medical record data from DB
            using var context = DbFactory.CreateDbContext();
            var existingTicket = await context.QueueTickets.FindAsync(TicketId);
            if (existingTicket != null)
            {
                _currentRoomId = existingTicket.RoomId;
                _diagnosis = existingTicket.Diagnosis ?? "";
                _treatmentPlan = existingTicket.TreatmentPlan ?? "";
                _notes = existingTicket.AdditionalNotes ?? "";
                System.Diagnostics.Debug.WriteLine($"✅ [Examination] Pre-filled medical record fields from DB. RoomId: {_currentRoomId}");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] ERROR loading patient: {ex.Message}");
            _errorMessage = "Không thể tải hồ sơ bệnh nhân. Vui lòng liên hệ bộ phận kỹ thuật hoặc thử lại sau.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CheckPendingLabsAsync()
    {
        _hasPendingLabs = await LabService.HasPendingLabOrdersAsync(TicketId);
        StateHasChanged();
    }

    private async Task SaveMedicalRecordAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Saving medical record for TicketId={TicketId}...");

        using var context = DbFactory.CreateDbContext();
        var queueTicket = await context.QueueTickets.FindAsync(TicketId);
        if (queueTicket == null)
        {
            _errorMessage = $"Không tìm thấy số thứ tự {TicketId}";
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] Queue ticket not found");
            ToastService.ShowError("Không tìm thấy thông tin lượt khám.");
            return;
        }

        queueTicket.Diagnosis = _diagnosis;
        queueTicket.TreatmentPlan = _treatmentPlan;
        queueTicket.AdditionalNotes = _notes;

        context.QueueTickets.Update(queueTicket);
        await context.SaveChangesAsync();

        _diagnosis = queueTicket.Diagnosis ?? "";
        _treatmentPlan = queueTicket.TreatmentPlan ?? "";
        _notes = queueTicket.AdditionalNotes ?? "";

        ToastService.ShowSuccess("Đã lưu hồ sơ khám bệnh thành công!");
        StateHasChanged();
    }

    private async Task CompleteExaminationAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Starting complete check for TicketId={TicketId}");

        // Check if any prescription exists (with at least one medicine)
        using (var context = DbFactory.CreateDbContext())
        {
            var hasPrescription = await context.Prescriptions
                .AnyAsync(p => p.TicketId == TicketId && p.PrescriptionDetails.Any());

            if (!hasPrescription && !_showPrescriptionConfirm)
            {
                _showPrescriptionConfirm = true;
                StateHasChanged();
                return;
            }
        }

        await FinishCompleteAsync();
    }

    private async Task FinishCompleteAsync()
    {
        _showPrescriptionConfirm = false;
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Finishing completion for TicketId={TicketId}");

        try
        {
            using var context = DbFactory.CreateDbContext();
            var ticket = await context.QueueTickets
                .Include(t => t.LabOrders)
                    .ThenInclude(lo => lo.LabOrderDetails)
                .FirstOrDefaultAsync(t => t.Id == TicketId);

            if (ticket != null)
            {
                // 1. Consultation fee (mặc định 300k)
                decimal total = 300000;

                // 2. Lab Fees
                var labTotal = ticket.LabOrders
                    .SelectMany(lo => lo.LabOrderDetails)
                    .Sum(lod => lod.UnitPrice);
                total += labTotal;

                // 3. Medicine Fees (lấy từ bảng Prescription liên kết với TicketId)
                var prescription = await context.Prescriptions
                    .FirstOrDefaultAsync(p => p.TicketId == TicketId);

                if (prescription != null)
                {
                    total += prescription.TotalAmount ?? 0;
                }

                // Update Ticket
                ticket.TotalAmount = total;
                ticket.StatusEnum = TicketStatus.Completed;
                ticket.Diagnosis = _diagnosis;
                ticket.TreatmentPlan = _treatmentPlan;
                ticket.AdditionalNotes = _notes;

                await context.SaveChangesAsync();
                ToastService.ShowSuccess($"Hoàn tất khám! Tổng quát: {total:N0} VNĐ");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] Complete error: {ex.Message}");
            ToastService.ShowError("Lỗi hệ thống khi hoàn tất khám. Vui lòng đảm bảo các xét nghiệm và đơn thuốc đã được chốt.");
            return;
        }

        System.Diagnostics.Debug.WriteLine($"✅ [Examination] Examination completed");
        NavigationManager.NavigateTo("/doctor/my-patients");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/doctor/my-patients");
    }

    private static int GetAge(DateOnly? dob)
    {
        if (!dob.HasValue) return 0;
        var age = DateTime.Today.Year - dob.Value.Year;
        if (dob.Value.ToDateTime(TimeOnly.MinValue) > DateTime.Today.AddYears(-age)) age--;
        return age;
    }
}
