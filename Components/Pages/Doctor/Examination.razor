@page "/doctor/examination/{TicketId:int}/{PatientId:int}"
@using SmartClinic.Models
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@using Blazored.Toast.Services
@rendermode InteractiveServer
@layout MainLayout
@inject PatientService PatientService
@inject NavigationManager NavigationManager
@inject SmartClinicDbContext DbContext
@inject IToastService ToastService

<div class="p-8">
    <!-- Back Button -->
    <div class="mb-6">
        <button @onclick="GoBack"
                class="flex items-center gap-2 px-4 py-2 text-primary hover:bg-muted rounded-lg transition">
            <i class="ph ph-arrow-left"></i>
            Back to Queue
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground">
            <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
            <span class="text-sm">Loading patient information...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-red-100 border border-red-300 rounded-lg p-4 mb-6">
            <p class="text-red-700 font-medium">Error loading patient</p>
            <p class="text-red-600 text-sm">@_errorMessage</p>
        </div>
    }
    else if (_patient == null)
    {
        <div class="bg-yellow-100 border border-yellow-300 rounded-lg p-4 mb-6">
            <p class="text-yellow-700">Patient information not found</p>
        </div>
    }
    else
    {
        <!-- Header with Patient Info -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Patient Details -->
                <div>
                    <h1 class="text-3xl font-bold text-foreground mb-4">Patient Examination</h1>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-muted-foreground">Full Name</p>
                            <p class="text-foreground font-medium">@_patient.FullName</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Age</p>
                            <p class="text-foreground font-medium">@GetAge(_patient.DoB) years old</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Phone</p>
                            <p class="text-foreground font-medium">@_patient.Phone</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Address</p>
                            <p class="text-foreground font-medium">@_patient.Address</p>
                        </div>
                    </div>
                </div>

                <!-- Ticket Info -->
                <div>
                    <h3 class="text-lg font-semibold text-foreground mb-4">Queue Information</h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-muted-foreground">Ticket Number</p>
                            <p class="text-foreground font-medium text-lg">#@TicketId</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Status</p>
                            <p class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                Examining
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">Arrival Time</p>
                            <p class="text-foreground font-medium">@DateTime.Now.ToString("HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medical Record Section -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="flex items-center gap-3 mb-6">
                <i class="ph ph-file-text text-2xl text-primary"></i>
                <h2 class="text-xl font-bold text-foreground">Medical Record</h2>
            </div>

            <div class="space-y-6">
                <!-- Diagnosis -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-2">Diagnosis</label>
                    <textarea @bind="_diagnosis"
                              class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                              rows="4" placeholder="Enter patient diagnosis and findings..."></textarea>
                </div>

                <!-- Treatment Plan -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-2">Treatment Plan</label>
                    <textarea @bind="_treatmentPlan"
                              class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                              rows="4" placeholder="Enter treatment plan and recommendations..."></textarea>
                </div>

                <!-- Additional Notes -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-2">Additional Notes</label>
                    <textarea @bind="_notes"
                              class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                              rows="3" placeholder="Any additional clinical notes..."></textarea>
                </div>

                <!-- Save Medical Record Button -->
                <button @onclick="SaveMedicalRecordAsync"
                        disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_diagnosis))"
                        class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="ph ph-floppy-disk"></i>
                    Save Medical Record
                </button>
            </div>
        </div>

        <!-- Prescription Section -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="flex items-center gap-3 mb-6">
                <i class="ph ph-pill text-2xl text-primary"></i>
                <h2 class="text-xl font-bold text-foreground">Prescription</h2>
            </div>

            <div class="space-y-6">
                <!-- Medicine Selection -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">Select Medicine</label>
                        <select @bind="_selectedMedicineId"
                                class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                            <option value="0">Choose a medicine...</option>
                            <option value="1">Paracetamol 500mg</option>
                            <option value="2">Amoxicillin 250mg</option>
                            <option value="3">Ibuprofen 400mg</option>
                            <option value="4">Aspirin 100mg</option>
                            <option value="5">Metformin 500mg</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">Quantity</label>
                        <input type="number" @bind="_medicineQuantity"
                               class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                               min="1" placeholder="Qty" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">Dosage</label>
                        <input type="text" @bind="_medicineDosage"
                               class="w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                               placeholder="e.g., 2x daily" />
                    </div>
                </div>

                <!-- Add Medicine Button -->
                <button @onclick="AddMedicineAsync" disabled="@(_selectedMedicineId == 0 || _medicineQuantity < 1)"
                        class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="ph ph-plus"></i>
                    Add Medicine
                </button>

                <!-- Selected Medicines Table -->
                @if (_prescribedMedicines.Any())
                {
                    <div>
                        <h3 class="text-sm font-semibold text-foreground mb-3">Prescribed Medicines</h3>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-border bg-muted/30">
                                        <th class="text-left py-3 px-4 font-medium text-muted-foreground">Medicine</th>
                                        <th class="text-center py-3 px-4 font-medium text-muted-foreground">Quantity</th>
                                        <th class="text-center py-3 px-4 font-medium text-muted-foreground">Dosage</th>
                                        <th class="text-center py-3 px-4 font-medium text-muted-foreground">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var medicine in _prescribedMedicines)
                                    {
                                        <tr class="border-b border-border hover:bg-muted/20 transition">
                                            <td class="py-3 px-4 text-foreground">@medicine.MedicineName</td>
                                            <td class="py-3 px-4 text-center text-foreground">@medicine.Quantity</td>
                                            <td class="py-3 px-4 text-center text-foreground">@medicine.Dosage</td>
                                            <td class="py-3 px-4 text-center">
                                                <button @onclick="() => RemoveMedicine(medicine.MedicineId)"
                                                        class="text-red-600 hover:text-red-700 transition text-xs font-medium">
                                                    <i class="ph ph-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-8 text-muted-foreground">
                        <i class="ph ph-pill text-3xl mb-2 opacity-50"></i>
                        <p class="text-sm">No medicines prescribed yet</p>
                    </div>
                }
            </div>
        </div>

        <!-- Lab Tests Section -->
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm mb-8">
            <div class="flex items-center gap-3 mb-6">
                <i class="ph ph-flask text-2xl text-primary"></i>
                <h2 class="text-xl font-bold text-foreground">Lab Tests</h2>
            </div>

            <div class="space-y-6">
                <!-- Lab Test Selection -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-3">Select Lab Tests</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <label
                            class="flex items-center gap-3 p-3 border border-border rounded-lg hover:bg-muted/20 cursor-pointer transition">
                            <input type="checkbox"
                                   @onchange="@((ChangeEventArgs e) => HandleLabTestChange("Blood Test", (bool)e.Value!))"
                                   class="w-4 h-4 rounded border-border" />
                            <span class="text-sm text-foreground font-medium">Blood Test (CBC)</span>
                        </label>
                        <label
                            class="flex items-center gap-3 p-3 border border-border rounded-lg hover:bg-muted/20 cursor-pointer transition">
                            <input type="checkbox"
                                   @onchange="@((ChangeEventArgs e) => HandleLabTestChange("Urinalysis", (bool)e.Value!))"
                                   class="w-4 h-4 rounded border-border" />
                            <span class="text-sm text-foreground font-medium">Urinalysis</span>
                        </label>
                        <label
                            class="flex items-center gap-3 p-3 border border-border rounded-lg hover:bg-muted/20 cursor-pointer transition">
                            <input type="checkbox"
                                   @onchange="@((ChangeEventArgs e) => HandleLabTestChange("Chest X-Ray", (bool)e.Value!))"
                                   class="w-4 h-4 rounded border-border" />
                            <span class="text-sm text-foreground font-medium">Chest X-Ray</span>
                        </label>
                        <label
                            class="flex items-center gap-3 p-3 border border-border rounded-lg hover:bg-muted/20 cursor-pointer transition">
                            <input type="checkbox"
                                   @onchange="@((ChangeEventArgs e) => HandleLabTestChange("ECG", (bool)e.Value!))"
                                   class="w-4 h-4 rounded border-border" />
                            <span class="text-sm text-foreground font-medium">ECG</span>
                        </label>
                        <label
                            class="flex items-center gap-3 p-3 border border-border rounded-lg hover:bg-muted/20 cursor-pointer transition">
                            <input type="checkbox"
                                   @onchange="@((ChangeEventArgs e) => HandleLabTestChange("Blood Glucose", (bool)e.Value!))"
                                   class="w-4 h-4 rounded border-border" />
                            <span class="text-sm text-foreground font-medium">Blood Glucose</span>
                        </label>
                        <label
                            class="flex items-center gap-3 p-3 border border-border rounded-lg hover:bg-muted/20 cursor-pointer transition">
                            <input type="checkbox"
                                   @onchange="@((ChangeEventArgs e) => HandleLabTestChange("Thyroid Panel", (bool)e.Value!))"
                                   class="w-4 h-4 rounded border-border" />
                            <span class="text-sm text-foreground font-medium">Thyroid Panel</span>
                        </label>
                    </div>
                </div>

                <!-- Selected Lab Tests -->
                @if (_selectedLabTests.Any())
                {
                    <div>
                        <h3 class="text-sm font-semibold text-foreground mb-3">Ordered Tests</h3>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var test in _selectedLabTests)
                            {
                                <div
                                    class="flex items-center gap-2 px-3 py-2 bg-primary/10 text-primary rounded-lg text-xs font-medium">
                                    <i class="ph ph-check"></i>
                                    <span>@test</span>
                                    <button @onclick="() => _selectedLabTests.Remove(test)"
                                            class="ml-1 hover:opacity-70 transition">
                                        <i class="ph ph-x text-sm"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-3 justify-end">
            <button @onclick="GoBack" disabled="@_isSubmitting"
                    class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="ph ph-arrow-left"></i>
                Cancel
            </button>
            <button @onclick="CompleteExaminationAsync" disabled="@_isSubmitting"
                    class="flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="ph ph-check"></i>
                @if (_isSubmitting)
                {
                    <span>Completing...</span>
                }
                else
                {
                    <span>Complete Examination</span>
                }
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public int TicketId { get; set; }

    [Parameter]
    public int PatientId { get; set; }

    private Patient? _patient;
    private string _diagnosis = "";
    private string _treatmentPlan = "";
    private string _notes = "";

    // Medicine prescription
    private int _selectedMedicineId = 0;
    private int _medicineQuantity = 1;
    private string _medicineDosage = "";
    private List<PrescribedMedicine> _prescribedMedicines = new();

    // Lab tests
    private List<string> _selectedLabTests = new();

    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _errorMessage;

    // Medicine mapping for demo (in production, load from database)
    private Dictionary<string, string> _medicineMap = new()
    {
        { "1", "Paracetamol 500mg" },
        { "2", "Amoxicillin 250mg" },
        { "3", "Ibuprofen 400mg" },
        { "4", "Aspirin 100mg" },
        { "5", "Metformin 500mg" }
    };

    protected override async Task OnInitializedAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Loading data for TicketId={TicketId}, PatientId={PatientId}");

        try
        {
            _patient = await PatientService.GetPatientByIdAsync(PatientId);

            if (_patient == null)
            {
                System.Diagnostics.Debug.WriteLine($"⚠️ [Examination] Patient not found with ID={PatientId}");
                _errorMessage = $"Patient with ID {PatientId} not found";
            }
            else
            {
                System.Diagnostics.Debug.WriteLine($"✅ [Examination] Loaded patient: {_patient.FullName}");
            }

            // Load existing medical record data from DB (nếu đã từng save trước đó)
            var existingTicket = await DbContext.QueueTickets.FindAsync(TicketId);
            if (existingTicket != null)
            {
                _diagnosis = existingTicket.Diagnosis ?? "";
                _treatmentPlan = existingTicket.TreatmentPlan ?? "";
                _notes = existingTicket.AdditionalNotes ?? "";
                System.Diagnostics.Debug.WriteLine($"✅ [Examination] Pre-filled medical record fields from DB");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] ERROR loading patient: {ex.Message}");
            _errorMessage = $"Error loading patient: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveMedicalRecordAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Saving medical record for TicketId={TicketId}...");

        try
        {
            _isSubmitting = true;

            // STEP 1: Get the QueueTicket from database
            var queueTicket = await DbContext.QueueTickets.FindAsync(TicketId);
            if (queueTicket == null)
            {
                _errorMessage = $"Queue ticket {TicketId} not found";
                System.Diagnostics.Debug.WriteLine($"❌ [Examination] Queue ticket not found");
                _isSubmitting = false;
                return;
            }

            System.Diagnostics.Debug.WriteLine($"✅ [Examination] Found QueueTicket: {queueTicket.Id}");

            // STEP 2: Update the medical record fields
            queueTicket.Diagnosis = _diagnosis;
            queueTicket.TreatmentPlan = _treatmentPlan;
            queueTicket.AdditionalNotes = _notes;

            System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Updating ticket fields...");

            // STEP 3: Save to database
            DbContext.QueueTickets.Update(queueTicket);
            await DbContext.SaveChangesAsync();

            System.Diagnostics.Debug.WriteLine($"✅ [Examination] Medical record saved successfully");

            // Bind lại từ object đã lưu → đảm bảo UI đồng bộ đúng với DB
            _diagnosis = queueTicket.Diagnosis ?? "";
            _treatmentPlan = queueTicket.TreatmentPlan ?? "";
            _notes = queueTicket.AdditionalNotes ?? "";

            _isSubmitting = false;

            // Show success toast
            ToastService.ShowSuccess("Medical record saved successfully!");

            // Re-render UI ngay lập tức, không cần reload trang
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] ERROR saving record: {ex.Message}");
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] Stack: {ex.StackTrace}");
            _errorMessage = $"Error saving medical record: {ex.Message}";
            ToastService.ShowError($"Error: {ex.Message}");
            _isSubmitting = false;
        }
    }

    private async Task AddMedicineAsync()
    {
        if (_selectedMedicineId == 0 || _medicineQuantity < 1)
            return;

        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Adding medicine {_selectedMedicineId}");

        if (_medicineMap.TryGetValue(_selectedMedicineId.ToString(), out var medicineName))
        {
            var medicine = new PrescribedMedicine
            {
                MedicineId = _selectedMedicineId,
                MedicineName = medicineName,
                Quantity = _medicineQuantity,
                Dosage = _medicineDosage
            };

            _prescribedMedicines.Add(medicine);

            // Reset inputs
            _selectedMedicineId = 0;
            _medicineQuantity = 1;
            _medicineDosage = "";

            System.Diagnostics.Debug.WriteLine($"✅ [Examination] Added {medicineName}");
        }

        StateHasChanged();
    }

    private void RemoveMedicine(int medicineId)
    {
        _prescribedMedicines.RemoveAll(m => m.MedicineId == medicineId);
        StateHasChanged();
    }

    private void HandleLabTestChange(string testName, bool isChecked)
    {
        if (isChecked && !_selectedLabTests.Contains(testName))
        {
            _selectedLabTests.Add(testName);
        }
        else if (!isChecked)
        {
            _selectedLabTests.Remove(testName);
        }
    }

    private async Task CompleteExaminationAsync()
    {
        System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Completing examination for TicketId={TicketId}");

        try
        {
            _isSubmitting = true;

            // Save medical record if any
            if (!string.IsNullOrWhiteSpace(_diagnosis))
            {
                // TODO: Save examination/medical record
            }

            // Save prescriptions if any
            if (_prescribedMedicines.Any())
            {
                // TODO: Save prescriptions to database
                System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Saving {_prescribedMedicines.Count} medicines");
            }

            // Order lab tests if any
            if (_selectedLabTests.Any())
            {
                // TODO: Create lab test orders
                // Update QueueTicket status to "Pending Lab"
                System.Diagnostics.Debug.WriteLine($"🔵 [Examination] Ordering {_selectedLabTests.Count} lab tests");
            }
            else
            {
                // TODO: Mark QueueTicket as "Completed" if no lab tests
                System.Diagnostics.Debug.WriteLine($"🔵 [Examination] No lab tests, marking ticket as completed");
            }

            System.Diagnostics.Debug.WriteLine($"✅ [Examination] Examination completed");

            // Navigate back to queue
            NavigationManager.NavigateTo("/doctor/my-patients");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ [Examination] ERROR: {ex.Message}");
            _errorMessage = $"Error completing examination: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/doctor/my-patients");
    }

    private static int GetAge(DateOnly? dob)
    {
        if (!dob.HasValue) return 0;
        var age = DateTime.Today.Year - dob.Value.Year;
        if (dob.Value.ToDateTime(TimeOnly.MinValue) > DateTime.Today.AddYears(-age)) age--;
        return age;
    }

    // Helper class for prescribed medicines
    private class PrescribedMedicine
    {
        public int MedicineId { get; set; }
        public string MedicineName { get; set; }
        public int Quantity { get; set; }
        public string Dosage { get; set; }
    }
}


