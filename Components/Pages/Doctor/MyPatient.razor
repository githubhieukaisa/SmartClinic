@page "/doctor/my-patients"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.Constant
@using SmartClinic.Models
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@using SmartClinic.Components.Common
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.Toast.Services
@rendermode InteractiveServer
@layout MainLayout
@implements IAsyncDisposable
@inject PatientService PatientService
@inject NavigationManager NavigationManager
@inject NotificationService Notification
@inject SmartClinicDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastService ToastService
@inject ITicketService TicketService
@attribute [Authorize(Policy = "DoctorPolicy")]

<div class="p-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-foreground">Hàng Đợi Bệnh Nhân</h1>
            @if (!string.IsNullOrEmpty(_roomName))
            {
                <p class="text-muted-foreground mt-1">📍 <span class="font-medium">@_roomName</span></p>
            }
        </div>
        <div class="flex items-center gap-4">
            <div class="text-right">
                <p class="text-sm font-medium text-foreground">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</p>
                <p class="text-xs text-muted-foreground">@DateTime.Now.ToString("HH:mm")</p>
            </div>
            @if (_isUpdating)
            {
                <div class="flex items-center gap-2 px-3 py-2 bg-primary/10 text-primary rounded-lg text-xs font-medium">
                    <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
                    Đang cập nhật...
                </div>
            }
            else
            {
                <button class="relative p-2 hover:bg-muted rounded-lg transition">
                    <i class="ph ph-bell text-xl text-foreground"></i>
                    @if (_showNotification)
                    {
                        <span class="absolute top-1 right-1 w-2 h-2 bg-destructive rounded-full"></span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Notification Toast -->
    @if (_showNotification)
    {
        <div class="mb-6 p-4 bg-card border border-primary/30 rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center">
                    <i class="ph ph-bell-ringing text-lg text-primary"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-foreground">Có bệnh nhân mới trong hàng đợi</p>
                    <p class="text-xs text-muted-foreground">Hàng đợi đã được cập nhật</p>
                </div>
            </div>
            <button @onclick="() => _showNotification = false"
                    class="p-1 hover:bg-muted rounded-lg transition text-muted-foreground hover:text-foreground">
                <i class="ph ph-x text-sm"></i>
            </button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-semibold text-foreground text-sm">Tổng số hàng đợi</h4>
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center">
                    <i class="ph ph-queue text-xl text-primary"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-primary">@TotalCount</p>
            <div class="mt-4 bg-primary/10 rounded-full h-2">
                <div class="bg-primary h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-semibold text-foreground text-sm">Đang chờ khám</h4>
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                    <i class="ph ph-hourglass text-xl text-amber-600"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-amber-600">@WaitingCount</p>
            <div class="mt-4 bg-amber-100 rounded-full h-2">
                <div class="bg-amber-500 h-full rounded-full" style="width: @WaitingPct%"></div>
            </div>
        </div>

        <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-semibold text-foreground text-sm">Đang khám / Xét nghiệm</h4>
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="ph ph-clock text-xl text-blue-600"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-blue-600">@InProgressCount</p>
            <div class="mt-4 bg-blue-100 rounded-full h-2">
                <div class="bg-blue-600 h-full rounded-full" style="width: @InProgressPct%"></div>
            </div>
        </div>
    </div>

    <!-- Queue Table -->
    <div class="bg-card rounded-xl border border-border shadow-sm">
        <div class="flex items-center justify-between p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <i class="ph ph-list-numbers text-xl text-foreground"></i>
                <h2 class="text-xl font-bold text-foreground">Hàng Đợi Hôm Nay</h2>
            </div>
            <div class="flex items-center gap-2">
                <CallNextPatientButton RoomId="@_currentRoomId" RoomName="@_roomName" ButtonText="Gọi BN Tiếp Theo"
                                       CssClass="" OnCalled="RefreshQueueAsync" />
                <button @onclick="RefreshQueueAsync"
                        class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition">
                    <i class="ph ph-arrows-clockwise"></i>
                    Làm mới
                </button>
                <button @onclick="AddTestQueueTicketAsync"
                        class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition">
                    <i class="ph ph-plus"></i>
                    Thêm phiếu mẫu
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            @if (_queueTickets == null)
            {
                <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground">
                    <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
                    <span class="text-sm">Đang tải hàng đợi...</span>
                </div>
            }
            else if (!_queueTickets.Any())
            {
                <div class="flex flex-col items-center justify-center py-16 gap-3 text-muted-foreground">
                    <i class="ph ph-queue text-4xl"></i>
                    <p class="text-sm font-medium">Hôm nay không có bệnh nhân nào trong hàng đợi</p>
                </div>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-border bg-muted/30">
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">STT</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">Bệnh nhân</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">Tuổi</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">Số điện thoại</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">Chẩn đoán</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">Chờ đợi</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">Trạng thái</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in PagedTickets)
                        {
                            <tr class="border-b border-border transition @GetRowBgClass(ticket.StatusEnum)">
                                <td class="py-3 px-5 text-center">
                                    <span
                                        class="inline-flex items-center justify-center w-8 h-8 bg-primary/10 text-primary rounded-lg text-xs font-bold">
                                        @ticket.TicketNumber
                                    </span>
                                </td>
                                <td class="py-3 px-5">
                                    <div class="flex items-center gap-3">
                                        <div
                                            class="w-8 h-8 bg-gradient-to-br from-primary to-primary/70 rounded-full flex items-center justify-center text-primary-foreground text-xs font-bold flex-shrink-0">
                                            @GetInitials(ticket.Patient?.FullName)
                                        </div>
                                        <div>
                                            <p class="font-medium text-foreground">@(ticket.Patient?.FullName ?? "—")</p>
                                            <p class="text-xs text-muted-foreground">@(ticket.Patient?.Address ?? "Không có địa chỉ")
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-5 text-center text-foreground">
                                    @(GetAge(ticket.Patient?.DoB) > 0 ? $"{GetAge(ticket.Patient?.DoB)} tuổi" : "—")
                                </td>
                                <td class="py-3 px-5 text-center text-foreground">
                                    @(ticket.Patient?.Phone ?? "—")
                                </td>
                                <td class="py-3 px-5 text-center">
                                    <span class="text-foreground">@(ticket.ClinicalDiagnosis ?? "—")</span>
                                </td>
                                <td class="py-3 px-5 text-center">
                                    <div class="flex items-center justify-center gap-1 text-muted-foreground">
                                        <i class="ph-bold ph-clock text-xs"></i>
                                        <span>@GetWaitTime(ticket.CreatedAt)</span>
                                    </div>
                                </td>
                                <td class="py-3 px-5 text-center">
                                    <span
                                        class="inline-block px-3 py-1 rounded-full text-xs font-medium @GetStatusClass(ticket.StatusEnum)">
                                        @TranslateStatus(ticket.StatusEnum)
                                    </span>
                                </td>
                                <td class="py-3 px-5 flex items-center justify-center gap-2">
                                    @if (ticket.StatusEnum == TicketStatus.Calling)
                                    {
                                        <button @onclick="() => StartExaminationAsync(ticket.Id)"
                                                class="flex items-center gap-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-medium shadow-md hover:shadow-lg transition">
                                            <i class="ph ph-door-open"></i>
                                            Bắt đầu khám
                                        </button>
                                    }
                                    else if (ticket.StatusEnum == TicketStatus.Examinating || ticket.StatusEnum == TicketStatus.Testing)
                                    {
                                        <button @onclick="() => OnExaminePatientAsync(ticket.Id, ticket.PatientId)"
                                                class="flex items-center gap-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-medium transition">
                                            <i class="ph ph-stethoscope"></i>
                                            Khám bệnh
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Phân trang Component -->
                <Pagination CurrentPage="@_currentPage" TotalItems="@TotalCount" PageSize="@_pageSize"
                            OnPageChanged="HandlePageChanged" />
            }
        </div>
    </div>
</div>

@code {
    private List<QueueTicket>? _queueTickets;
    private bool _showNotification = false;
    private bool _isUpdating = false;
    private int _currentDoctorId = 0;
    private string? _roomName;
    private int? _currentRoomId;

    private int _currentPage = 1;
    private int _pageSize = 10;

    private IEnumerable<QueueTicket> PagedTickets =>
        _queueTickets?.Skip((_currentPage - 1) * _pageSize).Take(_pageSize) ?? Enumerable.Empty<QueueTicket>();

    private void HandlePageChanged(int page)
    {
        _currentPage = page;
        StateHasChanged();
    }

    private int TotalCount => _queueTickets?.Count ?? 0;
    private int WaitingCount => _queueTickets?.Count(t => t.StatusEnum == TicketStatus.Waiting || t.StatusEnum == TicketStatus.Calling) ?? 0;
    private int InProgressCount => _queueTickets?.Count(t => t.StatusEnum == TicketStatus.Examinating || t.StatusEnum == TicketStatus.Testing) ?? 0;
    private int WaitingPct => TotalCount > 0 ? WaitingCount * 100 / TotalCount : 0;
    private int InProgressPct => TotalCount > 0 ? InProgressCount * 100 / TotalCount : 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int doctorId))
            {
                _currentDoctorId = doctorId;
            }

            var now = DateTime.Now;
            var activeShift = await DbContext.DoctorShifts
                .Include(s => s.Room)
                .Where(s => s.DoctorId == _currentDoctorId
                         && s.StartTime <= now
                         && (s.EndTime == null || s.EndTime >= now))
                .OrderByDescending(s => s.StartTime)
                .FirstOrDefaultAsync();

            if (activeShift != null)
            {
                _currentRoomId = activeShift.RoomId;
                _roomName = activeShift.Room.Name;
            }
            else
            {
                var doctor = await DbContext.Users
                    .Include(u => u.Room)
                    .FirstOrDefaultAsync(u => u.Id == _currentDoctorId);

                _currentRoomId = doctor?.RoomId;
                _roomName = doctor?.Room?.Name ?? "Chưa phân phòng";
            }
        }

        await LoadDataAsync();

        if (_currentRoomId.HasValue && _currentRoomId.Value > 0)
        {
            try
            {
                await Notification.JoinRoomAsync(_currentRoomId.Value);
            }
            catch (Exception) { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Notification.OnPatientQueueUpdated += HandleQueueUpdatedAsync;
            Notification.OnQueueStatusUpdated += HandleStatusChangedAsync;
        }
    }

    private async void HandleQueueUpdatedAsync(string patientName)
    {
        await InvokeAsync(async () =>
        {
            try
            {
                _isUpdating = true;
                _showNotification = true;
                StateHasChanged();

                await LoadDataAsync(withDelay: true);

                _isUpdating = false;
                StateHasChanged();

                await Task.Delay(3000);
                _showNotification = false;
                StateHasChanged();
            }
            catch (Exception)
            {
                _isUpdating = false;
            }
        });
    }

    private async void HandleStatusChangedAsync(int ticketId)
    {
        await InvokeAsync(async () =>
        {
            try
            {
                var ticketToUpdate = _queueTickets?.FirstOrDefault(t => t.Id == ticketId);
                if (ticketToUpdate != null)
                {
                    StateHasChanged();
                }
            }
            catch (Exception) { }
        });
    }

    private async Task RefreshQueueAsync()
    {
        try
        {
            _isUpdating = true;
            StateHasChanged();
            await LoadDataAsync(withDelay: true);
            _isUpdating = false;
            StateHasChanged();
        }
        catch (Exception)
        {
            _isUpdating = false;
        }
    }

    private async Task LoadDataAsync(bool withDelay = false)
    {
        if (withDelay)
        {
            _queueTickets = null;
            StateHasChanged();
            await Task.Delay(1000);
        }
        try
        {
            _queueTickets = await PatientService.GetDoctorQueueAsync(_currentDoctorId);
        }
        catch (Exception)
        {
            _queueTickets = new();
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Notification.OnPatientQueueUpdated -= HandleQueueUpdatedAsync;
        Notification.OnQueueStatusUpdated -= HandleStatusChangedAsync;
        await ValueTask.CompletedTask;
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private static int GetAge(DateOnly? dob)
    {
        if (!dob.HasValue) return 0;
        var age = DateTime.Today.Year - dob.Value.Year;
        if (dob.Value.ToDateTime(TimeOnly.MinValue) > DateTime.Today.AddYears(-age)) age--;
        return age;
    }

    private static string GetWaitTime(DateTime? createdAt)
    {
        if (!createdAt.HasValue) return "—";
        var elapsed = DateTime.Now - createdAt.Value;
        if (elapsed.TotalHours >= 1) return $"{(int)elapsed.TotalHours} giờ {elapsed.Minutes} phút";
        if (elapsed.TotalMinutes < 1) return "Vừa xong";
        return $"{(int)elapsed.TotalMinutes} phút";
    }

    private static string GetStatusClass(TicketStatus status) => status switch
    {
        TicketStatus.Done => "bg-green-100 text-green-700",
        TicketStatus.Examinating => "bg-cyan-100 text-cyan-700",
        TicketStatus.Calling => "bg-orange-100 text-orange-700",
        TicketStatus.Waiting => "bg-amber-100 text-amber-700",
        TicketStatus.Testing => "bg-purple-100 text-purple-700",
        _ => "bg-gray-100 text-gray-700"
    };

    private static string GetRowBgClass(TicketStatus status) => status switch
    {
        TicketStatus.Done => "bg-green-50",
        TicketStatus.Examinating => "bg-cyan-50",
        TicketStatus.Calling => "bg-orange-50",
        TicketStatus.Waiting => "bg-amber-50",
        TicketStatus.Testing => "bg-purple-50",
        _ => ""
    };

    private static string TranslateStatus(TicketStatus status) => status switch
    {
        TicketStatus.Waiting => "Chờ khám",
        TicketStatus.Calling => "Đang gọi",
        TicketStatus.Examinating => "Đang khám",
        TicketStatus.Testing => "Đang xét nghiệm",
        TicketStatus.Done => "Hoàn tất",
        _ => status.ToString()
    };

    private async Task AddTestQueueTicketAsync()
    {
        try
        {
            if (_currentDoctorId == 0 || !_currentRoomId.HasValue) return;
            var room = await DbContext.Rooms.FindAsync(_currentRoomId.Value);
            if (room == null) return;

            await TicketService.GenerateTicketAsync(
                $"Bệnh nhân mẫu {DateTime.Now:HHmmss}",
                "0123456789",
                room.DepartmentId
            );

            _showNotification = true;
            StateHasChanged();
            await Task.Delay(3000);
            _showNotification = false;
            StateHasChanged();
        }
        catch (Exception) { }
    }

    private Task OnExaminePatientAsync(int ticketId, int? patientId)
    {
        if (!patientId.HasValue) return Task.CompletedTask;
        try
        {
            NavigationManager.NavigateTo($"/doctor/examination/{ticketId}/{patientId.Value}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi: {ex.Message}");
        }
        return Task.CompletedTask;
    }

    private async Task StartExaminationAsync(int ticketId)
    {
        try
        {
            var ticket = _queueTickets?.FirstOrDefault(t => t.Id == ticketId);
            if (ticket == null)
            {
                ToastService.ShowError("Không tìm thấy phiếu");
                return;
            }

            ticket.StatusEnum = TicketStatus.Examinating;
            DbContext.QueueTickets.Update(ticket);
            await DbContext.SaveChangesAsync();
            StateHasChanged();
            ToastService.ShowSuccess($"Đang bắt đầu khám cho {ticket.Patient?.FullName}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi: {ex.Message}");
        }
    }
}