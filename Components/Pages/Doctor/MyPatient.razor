@page "/doctor/my-patients"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.Constant
@using SmartClinic.Models
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@using SmartClinic.Components.Common
@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.Toast.Services
@rendermode InteractiveServer
@layout MainLayout
@implements IAsyncDisposable
@inject PatientService PatientService
@inject NavigationManager NavigationManager
@inject NotificationService Notification
@inject IDbContextFactory<SmartClinicDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastService ToastService
@inject ITicketService TicketService
@inject IDoctorShiftService DoctorShiftService
@attribute [Authorize(Policy = "DoctorPolicy")]

<div class="p-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-foreground">Hàng Đợi Bệnh Nhân</h1>
            @if (!string.IsNullOrEmpty(_roomName))
            {
                <div class="flex items-center gap-3 mt-1">
                    <p class="text-muted-foreground">📍 <span class="font-medium text-foreground">@_roomName</span></p>
                    @if (_activeShift != null)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider @GetShiftStatusClass(_activeShift.StatusEnum)">
                            @_activeShift.StatusDisplay
                        </span>
                    }
                </div>
            }
        </div>
        <div class="flex items-center gap-4">
            <div class="text-right">
                <p class="text-sm font-medium text-foreground">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</p>
                <p class="text-xs text-muted-foreground">@DateTime.Now.ToString("HH:mm")</p>
            </div>
            @if (_isUpdating)
            {
                <div class="flex items-center gap-2 px-3 py-2 bg-primary/10 text-primary rounded-lg text-xs font-medium">
                    <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
                    Đang cập nhật...
                </div>
            }
            else
            {
                <button class="relative p-2 hover:bg-muted rounded-lg transition">
                    <i class="ph ph-bell text-xl text-foreground"></i>
                    @if (_showNotification)
                    {
                        <span class="absolute top-1 right-1 w-2 h-2 bg-destructive rounded-full"></span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Notification Toast -->
    @if (_showNotification)
    {
        <div class="mb-6 p-4 bg-card border border-primary/30 rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center">
                    <i class="ph ph-bell-ringing text-lg text-primary"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-foreground">Có bệnh nhân mới trong hàng đợi</p>
                    <p class="text-xs text-muted-foreground">Hàng đợi đã được cập nhật</p>
                </div>
            </div>
            <button @onclick="() => _showNotification = false"
                    class="p-1 hover:bg-muted rounded-lg transition text-muted-foreground hover:text-foreground">
                <i class="ph ph-x text-sm"></i>
            </button>
        </div>
    }

    <!-- Queue Table -->
    <div class="bg-card rounded-xl border border-border shadow-sm">
        <div class="flex items-center justify-end p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <!-- Shift Control Buttons -->
                @if (_activeShift != null)
                {
                    @if (_activeShift.StatusEnum == DoctorShiftStatus.Active)
                    {
                        <button @onclick="HandleStopReceivingAsync" disabled="@_isClosingShift"
                                class="flex items-center gap-2 px-4 py-2 bg-amber-100 text-amber-700 rounded-lg text-sm font-bold hover:bg-amber-200 transition disabled:opacity-70 disabled:cursor-not-allowed">
                            @if (_isClosingShift)
                            {
                                <i class="ph ph-spinner-gap animate-spin"></i>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <i class="ph ph-hand-palm"></i>
                                <span>Chốt sổ (Dừng nhận bệnh)</span>
                            }
                        </button>
                    }
                    else if (_activeShift.StatusEnum == DoctorShiftStatus.Closing)
                    {
                        <button @onclick="HandleEndShiftAsync" disabled="@_isEndingShift"
                                class="flex items-center gap-2 px-4 py-2 bg-slate-900 text-white rounded-lg text-sm font-bold hover:bg-slate-800 transition shadow-sm disabled:opacity-70 disabled:cursor-not-allowed">
                            @if (_isEndingShift)
                            {
                                <i class="ph ph-spinner-gap animate-spin"></i>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <i class="ph ph-power"></i>
                                <span>Kết thúc ca làm việc</span>
                            }
                        </button>
                    }

                    <div class="h-8 w-[1px] bg-slate-200 mx-2"></div>
                }

                <CallNextPatientButton RoomId="@_currentRoomId" RoomName="@_roomName" ButtonText="Gọi BN Tiếp Theo"
                                       OnCalled="RefreshQueueAsync" />
                <button @onclick="RefreshQueueAsync"
                        class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition">
                    <i class="ph ph-arrows-clockwise"></i>
                    Làm mới
                </button>

                <!-- Dev Test Buttons -->
                <button @onclick="() => AddTestTicketAsync(false)"
                        class="flex items-center gap-2 px-4 py-2 bg-slate-100 text-slate-600 rounded-lg text-sm font-medium hover:bg-slate-200 transition">
                    <i class="ph ph-plus-circle"></i>
                    + Thường (Dev)
                </button>
                <button @onclick="() => AddTestTicketAsync(true)"
                        class="flex items-center gap-2 px-4 py-2 bg-rose-100 text-rose-600 rounded-lg text-sm font-medium hover:bg-rose-200 transition">
                    <i class="ph ph-lightning"></i>
                    + Khẩn Cấp (Dev)
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            @if (_queueTickets == null)
            {
                <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground">
                    <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
                    <span class="text-sm">Đang tải hàng đợi...</span>
                </div>
            }
            else if (!_queueTickets.Any())
            {
                <div class="flex flex-col items-center justify-center py-16 gap-3 text-muted-foreground">
                    <i class="ph ph-queue text-4xl"></i>
                    <p class="text-sm font-medium">Hôm nay không có bệnh nhân nào trong hàng đợi</p>
                </div>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-border bg-muted/30">
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground">STT</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground">Bệnh nhân</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground">Tuổi</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground">Số điện thoại</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground">Chờ đợi</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground">Trạng thái</th>
                            <th class="text-center py-3 px-5 font-semibold text-muted-foreground">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in PagedTickets)
                        {
                            <tr class="border-b border-border transition @GetRowBgClass(ticket.StatusEnum)">
                                <td class="py-3 px-5 text-center">
                                    <span class="inline-flex items-center justify-center w-8 h-8 bg-primary/10 text-primary rounded-lg text-xs font-bold">
                                        @ticket.TicketNumber
                                    </span>
                                </td>
                                <td class="py-3 px-5 text-center">
                                    <p class="font-medium text-foreground">@(ticket.PatientUser?.FullName ?? "—")</p>
                                    <p class="text-xs text-muted-foreground">@(ticket.PatientUser?.Address ?? "Không có địa chỉ")</p>
                                </td>
                                <td class="py-3 px-5 text-center text-foreground">
                                    @(GetAge(ticket.PatientUser?.DoB) > 0 ? $"{GetAge(ticket.PatientUser?.DoB)} tuổi" : "—")
                                </td>
                                <td class="py-3 px-5 text-center text-foreground">
                                    @(ticket.PatientUser?.PhoneNumber ?? "—")
                                </td>
                                <td class="py-3 px-5 text-center">
                                    <div class="flex items-center justify-center gap-1 text-muted-foreground">
                                        <i class="ph-bold ph-clock text-xs"></i>
                                        <span>@GetWaitTime(ticket.CreatedAt)</span>
                                    </div>
                                </td>
                                <td class="py-3 px-5 text-center">
                                    <span class="inline-block px-3 py-1 rounded-full text-xs font-medium @GetStatusClass(ticket.StatusEnum)">
                                        @TranslateStatus(ticket.StatusEnum)
                                    </span>
                                </td>
                                <td class="py-3 px-5 flex items-center justify-center gap-2">
                                    @if (ticket.StatusEnum == TicketStatus.Calling || ticket.StatusEnum == TicketStatus.Missed)
                                    {
                                        <button @onclick="() => StartExaminationAsync(ticket.Id)"
                                                class="flex items-center gap-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold shadow-sm transition">
                                            <i class="ph ph-door-open"></i>
                                            Khám ngay
                                        </button>
                                    }
                                    
                                    @if (ticket.StatusEnum == TicketStatus.Examinating || ticket.StatusEnum == TicketStatus.Testing)
                                    {
                                        <button @onclick="() => OnExaminePatientAsync(ticket.Id, ticket.PatientId)"
                                                class="flex items-center gap-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold shadow-sm transition">
                                            <i class="ph ph-stethoscope"></i>
                                            Vào hồ sơ
                                        </button>
                                    }

                                    @if (ticket.StatusEnum == TicketStatus.Missed)
                                    {
                                        <button @onclick='() => UpdateTicketStatusAsync(ticket.Id, TicketStatus.Cancelled, "Bác sĩ hủy vé")'
                                                title="Hủy vé rác do bệnh nhân vắng mặt"
                                                class="p-2 bg-slate-100 text-slate-500 border border-slate-200 rounded-lg hover:bg-slate-200 transition">
                                            <i class="ph ph-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <Pagination CurrentPage="@_currentPage" TotalItems="@TotalCount" PageSize="@_pageSize"
                            OnPageChanged="HandlePageChanged" />
            }
        </div>
    </div>
</div>

@code {
    private List<QueueTicket>? _queueTickets;
    private bool _showNotification = false;
    private bool _isUpdating = false;
    private int _currentDoctorId = 0;
    private string? _roomName;
    private int? _currentRoomId;
    private DoctorShift? _activeShift;
    
    private bool _isClosingShift = false;
    private bool _isEndingShift = false;

    private int _currentPage = 1;
    private int _pageSize = 10;

    private IEnumerable<QueueTicket> PagedTickets =>
        _queueTickets?.Skip((_currentPage - 1) * _pageSize).Take(_pageSize) ?? Enumerable.Empty<QueueTicket>();

    private void HandlePageChanged(int page)
    {
        _currentPage = page;
        StateHasChanged();
    }

    private int TotalCount => _queueTickets?.Count ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int doctorId))
            {
                _currentDoctorId = doctorId;
            }

            _activeShift = await PatientService.GetActiveDoctorShiftAsync(_currentDoctorId);

            if (_activeShift != null)
            {
                _currentRoomId = _activeShift.RoomId;
                _roomName = _activeShift.Room?.Name;
            }
            else
            {
                _currentRoomId = null;
                _roomName = "Hết ca làm việc / Chưa bắt đầu ca";
            }
        }

        _ = LoadDataAsync(); 

        if (_currentRoomId.HasValue && _currentRoomId.Value > 0)
        {
            try { await Notification.JoinRoomAsync(_currentRoomId.Value); } catch { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Notification.OnPatientQueueUpdated += HandleQueueUpdatedAsync;
            Notification.OnQueueStatusUpdated += HandleStatusChangedAsync;
        }
    }

    private async void HandleQueueUpdatedAsync(string patientName)
    {
        await InvokeAsync(async () =>
        {
            try
            {
                _isUpdating = true;
                _showNotification = true;
                StateHasChanged();
                await LoadDataAsync(withDelay: true);
                _isUpdating = false;
                StateHasChanged();
                await Task.Delay(3000);
                _showNotification = false;
                StateHasChanged();
            }
            catch { _isUpdating = false; }
        });
    }

    private async void HandleStatusChangedAsync(int ticketId)
    {
        await InvokeAsync(async () => { try { await LoadDataAsync(); } catch { } });
    }

    private async Task RefreshQueueAsync()
    {
        try
        {
            _isUpdating = true;
            StateHasChanged();
            await LoadDataAsync(withDelay: true);
            _isUpdating = false;
            StateHasChanged();
        }
        catch { _isUpdating = false; }
    }

    private async Task LoadDataAsync(bool withDelay = false)
    {
        if (withDelay)
        {
            _queueTickets = null;
            StateHasChanged();
            await Task.Delay(500);
        }
        try
        {
            _queueTickets = await PatientService.GetDoctorQueueAsync(_currentDoctorId);
        }
        catch { _queueTickets = new(); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Notification.OnPatientQueueUpdated -= HandleQueueUpdatedAsync;
        Notification.OnQueueStatusUpdated -= HandleStatusChangedAsync;
        await ValueTask.CompletedTask;
    }

    private static int GetAge(DateOnly? dob)
    {
        if (!dob.HasValue) return 0;
        var age = DateTime.Today.Year - dob.Value.Year;
        if (dob.Value.ToDateTime(TimeOnly.MinValue) > DateTime.Today.AddYears(-age)) age--;
        return age;
    }

    private static string GetWaitTime(DateTime? createdAt)
    {
        if (!createdAt.HasValue) return "—";
        var elapsed = DateTime.Now - createdAt.Value;
        if (elapsed.TotalHours >= 1) return $"{(int)elapsed.TotalHours}h{elapsed.Minutes}m";
        if (elapsed.TotalMinutes < 1) return "Vừa xong";
        return $"{(int)elapsed.TotalMinutes} phút";
    }

    private static string GetStatusClass(TicketStatus status) => status switch
    {
        TicketStatus.Done => "bg-green-100 text-green-700",
        TicketStatus.Completed => "bg-teal-100 text-teal-700",
        TicketStatus.Examinating => "bg-cyan-100 text-cyan-700",
        TicketStatus.Calling => "bg-orange-100 text-orange-700",
        TicketStatus.Waiting => "bg-amber-100 text-amber-700",
        TicketStatus.Testing => "bg-purple-100 text-purple-700",
        TicketStatus.Emergency => "bg-rose-100 text-rose-700 font-bold",
        TicketStatus.Missed => "bg-red-100 text-red-700",
        TicketStatus.Cancelled => "bg-slate-100 text-slate-700",
        _ => "bg-gray-100 text-gray-700"
    };

    private static string GetRowBgClass(TicketStatus status) => status switch
    {
        TicketStatus.Done => "bg-green-50",
        TicketStatus.Completed => "bg-teal-50",
        TicketStatus.Examinating => "bg-cyan-50",
        TicketStatus.Calling => "bg-orange-50",
        TicketStatus.Waiting => "bg-amber-50",
        TicketStatus.Testing => "bg-purple-50",
        TicketStatus.Emergency => "bg-rose-50/50",
        TicketStatus.Missed => "bg-red-50",
        TicketStatus.Cancelled => "bg-slate-50",
        _ => ""
    };

    private static string TranslateStatus(TicketStatus status) => status switch
    {
        TicketStatus.Waiting => "Chờ khám",
        TicketStatus.Calling => "Đang gọi",
        TicketStatus.Examinating => "Đang khám",
        TicketStatus.Testing => "Đang xét nghiệm",
        TicketStatus.Completed => "Đã khám xong",
        TicketStatus.Done => "Hoàn tất",
        TicketStatus.Emergency => "Khẩn cấp",
        TicketStatus.Missed => "Vắng mặt",
        TicketStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private Task OnExaminePatientAsync(int ticketId, int? patientId)
    {
        if (!patientId.HasValue) return Task.CompletedTask;
        try
        {
            NavigationManager.NavigateTo($"/doctor/examination/{ticketId}/{patientId.Value}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi: {ex.Message}");
        }
        return Task.CompletedTask;
    }

    private async Task AddTestTicketAsync(bool isEmergency)
    {
        try
        {
            if (!_currentRoomId.HasValue) 
                return;

            using var context = DbFactory.CreateDbContext();
            var room = await context.Rooms.FindAsync(_currentRoomId.Value);
            if (room == null) return;

            var ticketStatus = isEmergency ? TicketStatus.Emergency : TicketStatus.Waiting;
            var prefix = isEmergency ? "[KHẨN CẤP]" : "[Test]";

            await TicketService.GenerateTicketAsync(new SmartClinic.DTOs.GenerateTicketRequest
            {
                PatientName = $"{prefix} BN {DateTime.Now:HH:mm:ss}",
                PatientPhone = "",
                DepartmentId = room.DepartmentId,
                StatusEnum = ticketStatus
            });

            ToastService.ShowSuccess(isEmergency ? "Đã thêm bệnh nhân khẩn cấp!" : "Đã thêm bệnh nhân thường!");
            await RefreshQueueAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi: {ex.Message}");
        }
    }

    private async Task StartExaminationAsync(int ticketId)
    {
        try
        {
            var ticket = _queueTickets?.FirstOrDefault(t => t.Id == ticketId);
            if (ticket == null) return;

            ticket.StatusEnum = TicketStatus.Examinating;
            ticket.DoctorId = _currentDoctorId;
            ticket.UpdatedAt = DateTime.Now;
            
            using var context = DbFactory.CreateDbContext();
            context.QueueTickets.Update(ticket);
            await context.SaveChangesAsync();
            
            ToastService.ShowSuccess($"Bắt đầu khám: {ticket.PatientUser?.FullName}");
        }
        catch (Exception ex) { ToastService.ShowError($"Lỗi: {ex.Message}"); }
    }

    private async Task UpdateTicketStatusAsync(int ticketId, TicketStatus newStatus, string actionName)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var ticket = await context.QueueTickets.FindAsync(ticketId);
            if (ticket == null) return;
            ticket.StatusEnum = newStatus;
            ticket.UpdatedAt = DateTime.Now;
            ticket.UpdatedBy = _currentDoctorId;
            await context.SaveChangesAsync();
            ToastService.ShowInfo($"{actionName} thành công");
            await RefreshQueueAsync();
        }
        catch (Exception ex) { ToastService.ShowError($"Lỗi: {ex.Message}"); }
    }

    private async Task HandleStopReceivingAsync()
    {
        if (_activeShift == null) return;
        _isClosingShift = true;
        try
        {
            var (success, error) = await DoctorShiftService.StopReceivingPatientsAsync(_activeShift.Id, _currentDoctorId);
            if (success)
            {
                ToastService.ShowSuccess("Đã chốt sổ. Dừng nhận bệnh nhân mới.");
                _activeShift = await PatientService.GetActiveDoctorShiftAsync(_currentDoctorId);
            }
            else ToastService.ShowError(error);
        }
        finally
        {
            _isClosingShift = false;
        }
    }

    private async Task HandleEndShiftAsync()
    {
        if (_activeShift == null) return;
        _isEndingShift = true;
        try
        {
            var (success, error) = await DoctorShiftService.EndShiftAsync(_activeShift.Id, _currentDoctorId);
            if (success)
            {
                ToastService.ShowSuccess("Ca trực đã kết thúc.");
                NavigationManager.NavigateTo("/", true);
            }
            else ToastService.ShowWarning(error);
        }
        finally 
        {
            _isEndingShift = false;
        }
    }

    private static string GetShiftStatusClass(DoctorShiftStatus status) => status switch
    {
        DoctorShiftStatus.Active => "bg-emerald-100 text-emerald-700",
        DoctorShiftStatus.Closing => "bg-amber-100 text-amber-700 border border-amber-200",
        DoctorShiftStatus.Completed => "bg-slate-100 text-slate-700",
        _ => "bg-slate-100 text-slate-600"
    };
}