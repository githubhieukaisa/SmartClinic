@page "/doctor-dashboard"
@using Blazored.Toast.Services
@using SmartClinic.Services
@inject IQueueService QueueService
@inject IToastService ToastService

<button @onclick="CallNext" class="btn btn-primary">Gọi bệnh nhân tiếp theo</button>

@code {
    private async Task CallNext()
    {
        bool success = await QueueService.CallNextPatientAsync("Phòng Khám 1");
        if (!success)
        {
            // Báo Toast Message: "Đã hết bệnh nhân trong hàng đợi!"
            ToastService.ShowWarning("Đã hết bệnh nhân trong hàng đợi!");
        }
    }
}