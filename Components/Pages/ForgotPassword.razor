@page "/forgot-password"
@layout SmartClinic.Components.Layout.KioskLayout
@using SmartClinic.Services
@using System.ComponentModel.DataAnnotations

@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="flex items-center justify-center min-h-screen p-4 bg-slate-100">
    <div class="w-full max-w-md p-8 bg-white shadow-2xl rounded-2xl ring-1 ring-slate-900/5">

        <div class="mb-8 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-blue-50">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z">
                    </path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold tracking-tight text-slate-900">Quên Mật Khẩu</h3>
            <p class="mt-2 text-sm text-slate-500">Nhập email đã đăng ký để nhận OTP đặt lại mật khẩu</p>
        </div>

        <div class="space-y-5">

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="p-3 text-sm rounded-lg @(isError ? "text-red-600 bg-red-100" : "text-emerald-700 bg-emerald-100")">
                    @message
                </div>
            }

            @if (resetSuccess)
            {
                <a href="/login"
                   class="block w-full px-4 py-2.5 text-sm font-semibold text-center text-white bg-blue-600 rounded-lg hover:bg-blue-700">
                    Quay lại đăng nhập
                </a>
            }
            else
            {
                <EditForm Model="@sendOtpModel" OnValidSubmit="HandleSendOtp" FormName="sendOtpForm" class="space-y-3">
                    <DataAnnotationsValidator />

                    <div>
                        <label for="forgotEmail" class="block mb-1 text-sm font-medium text-slate-700">Email nhận OTP</label>
                        <InputText id="forgotEmail" @bind-Value="sendOtpModel.Email"
                                   class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors sm:text-sm"
                                   placeholder="example@email.com" />
                        <ValidationMessage For="@(() => sendOtpModel.Email)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <button type="submit" disabled="@isLoading"
                            class="w-full px-4 py-2.5 text-sm font-semibold text-white transition-colors bg-blue-600 rounded-lg hover:bg-blue-700 disabled:opacity-50">
                        @(isLoading ? "Đang gửi OTP..." : "Gửi OTP")
                    </button>
                </EditForm>

                <EditForm Model="@resetModel" OnValidSubmit="HandleResetPassword" FormName="resetPasswordForm" class="space-y-3">
                    <DataAnnotationsValidator />

                    <div>
                        <label for="otp" class="block mb-1 text-sm font-medium text-slate-700">Mã OTP</label>
                        <InputText id="otp" @bind-Value="resetModel.Otp"
                                   class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors sm:text-sm"
                                   placeholder="Nhập mã 6 số" />
                        <ValidationMessage For="@(() => resetModel.Otp)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <div>
                        <label for="newPassword" class="block mb-1 text-sm font-medium text-slate-700">Mật khẩu mới</label>
                        <InputText id="newPassword" type="password" @bind-Value="resetModel.NewPassword"
                                   class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors sm:text-sm"
                                   placeholder="Tối thiểu 6 ký tự" />
                        <ValidationMessage For="@(() => resetModel.NewPassword)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <div>
                        <label for="confirmPassword" class="block mb-1 text-sm font-medium text-slate-700">Xác nhận mật khẩu mới</label>
                        <InputText id="confirmPassword" type="password" @bind-Value="resetModel.ConfirmPassword"
                                   class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors sm:text-sm"
                                   placeholder="Nhập lại mật khẩu mới" />
                        <ValidationMessage For="@(() => resetModel.ConfirmPassword)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <button type="submit" disabled="@isLoading"
                            class="w-full px-4 py-2.5 text-sm font-semibold text-white transition-colors bg-emerald-600 rounded-lg hover:bg-emerald-700 disabled:opacity-50">
                        @(isLoading ? "Đang đặt lại..." : "Xác nhận đặt lại mật khẩu")
                    </button>
                </EditForm>

                <a href="/login"
                   class="block w-full px-4 py-2.5 text-sm font-semibold text-center text-slate-700 bg-slate-100 rounded-lg hover:bg-slate-200">
                    Quay lại đăng nhập
                </a>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    private bool isLoading;
    private string? message;
    private bool isError;
    private bool resetSuccess;

    private SendOtpModel sendOtpModel { get; set; } = new();
    private ResetModel resetModel { get; set; } = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            sendOtpModel.Email = Email;
            resetModel.Email = Email;
        }
    }

    private async Task HandleSendOtp()
    {
        isLoading = true;
        message = null;

        try
        {
            var result = await AuthService.SendPasswordResetOtpAsync(sendOtpModel.Email);
            isError = !result.Success;
            message = result.Message;

            if (result.Success)
            {
                resetModel.Email = sendOtpModel.Email.Trim();
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = "Lỗi gửi OTP: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleResetPassword()
    {
        isLoading = true;
        message = null;

        try
        {
            if (string.IsNullOrWhiteSpace(resetModel.Email))
            {
                isError = true;
                message = "Vui lòng nhập email trước khi đặt lại mật khẩu.";
                return;
            }

            var result = await AuthService.ResetPasswordWithOtpAsync(
                resetModel.Email,
                resetModel.Otp,
                resetModel.NewPassword);

            isError = !result.Success;
            message = result.Message;

            if (result.Success)
            {
                resetSuccess = true;
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = "Lỗi đặt lại mật khẩu: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class SendOtpModel
    {
        [Required(ErrorMessage = "Vui lòng nhập email!")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ!")]
        public string Email { get; set; } = string.Empty;
    }

    public class ResetModel
    {
        [Required(ErrorMessage = "Vui lòng nhập email!")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ!")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập OTP!")]
        [RegularExpression("^\\d{6}$", ErrorMessage = "OTP phải gồm đúng 6 chữ số!")]
        public string Otp { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu mới!")]
        [MinLength(6, ErrorMessage = "Mật khẩu tối thiểu 6 ký tự!")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng xác nhận mật khẩu mới!")]
        [Compare(nameof(NewPassword), ErrorMessage = "Xác nhận mật khẩu không khớp!")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
