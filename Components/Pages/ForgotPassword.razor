@page "/forgot-password"
@layout SmartClinic.Components.Layout.KioskLayout
@using SmartClinic.Services
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@implements IDisposable
@rendermode InteractiveServer

<style>
    @@keyframes check-scale {
        0% { transform: scale(0); opacity: 0; }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); opacity: 1; }
    }
    @@keyframes fade-up {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .check-icon { animation: check-scale 0.5s ease-out forwards; }
    .fade-up { animation: fade-up 0.4s ease-out 0.3s both; }
    .fade-up-delay { animation: fade-up 0.4s ease-out 0.6s both; }
</style>

<div class="flex items-center justify-center min-h-screen p-4 bg-slate-100">
    <div class="w-full max-w-md p-8 bg-white shadow-2xl rounded-2xl ring-1 ring-slate-900/5">

        @if (currentStep != Step.Success)
        {
            <div class="mb-8 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-blue-50">
                    <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z">
                        </path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold tracking-tight text-slate-900">Quên Mật Khẩu</h3>
                <p class="mt-2 text-sm text-slate-500">
                    @if (currentStep == Step.EnterEmail)
                    {
                        @:Nhập email đã đăng ký để nhận mã OTP
                    }
                    else
                    {
                        @:OTP đã gửi đến <strong>@sentToEmail</strong>
                    }
                </p>
            </div>
        }

        <div class="space-y-5">

            @if (!string.IsNullOrEmpty(message) && currentStep != Step.Success)
            {
                <div class="p-3 text-sm rounded-lg @(isError ? "text-red-600 bg-red-100" : "text-emerald-700 bg-emerald-100")">
                    @message
                </div>
            }

            @* ===== STEP 1: Nhập Email ===== *@
            @if (currentStep == Step.EnterEmail)
            {
                <EditForm Model="@sendOtpModel" OnValidSubmit="HandleSendOtp" FormName="sendOtpForm" class="space-y-4">
                    <DataAnnotationsValidator />

                    <div>
                        <label for="forgotEmail" class="block mb-1 text-sm font-medium text-slate-700">Email nhận OTP</label>
                        <InputText id="forgotEmail" @bind-Value="sendOtpModel.Email"
                                   class="@InputClass"
                                   placeholder="example@email.com" />
                        <ValidationMessage For="@(() => sendOtpModel.Email)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <button type="submit" disabled="@isLoading"
                            class="flex items-center justify-center gap-2 w-full px-4 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 disabled:opacity-50">
                        @if (isLoading)
                        {
                            <span class="inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Đang gửi OTP...</span>
                        }
                        else
                        {
                            <span>Gửi OTP</span>
                        }
                    </button>
                </EditForm>
            }

            @* ===== STEP 2: Nhập OTP + Mật khẩu mới ===== *@
            else if (currentStep == Step.EnterOtp)
            {
                <EditForm Model="@resetModel" OnValidSubmit="HandleResetPassword" FormName="resetPasswordForm" class="space-y-4">
                    <DataAnnotationsValidator />

                    <div>
                        <label for="otp" class="block mb-1 text-sm font-medium text-slate-700">Mã OTP</label>
                        <InputText id="otp" @bind-Value="resetModel.Otp"
                                   class="@InputClass"
                                   placeholder="Nhập mã 6 số" />
                        <ValidationMessage For="@(() => resetModel.Otp)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <div>
                        <label for="newPassword" class="block mb-1 text-sm font-medium text-slate-700">Mật khẩu mới</label>
                        <InputText id="newPassword" type="password" @bind-Value="resetModel.NewPassword"
                                   class="@InputClass"
                                   placeholder="Tối thiểu 6 ký tự" />
                        <ValidationMessage For="@(() => resetModel.NewPassword)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <div>
                        <label for="confirmPassword" class="block mb-1 text-sm font-medium text-slate-700">Xác nhận mật khẩu mới</label>
                        <InputText id="confirmPassword" type="password" @bind-Value="resetModel.ConfirmPassword"
                                   class="@InputClass"
                                   placeholder="Nhập lại mật khẩu mới" />
                        <ValidationMessage For="@(() => resetModel.ConfirmPassword)" class="mt-1 text-xs text-red-500" />
                    </div>

                    <button type="submit" disabled="@isLoading"
                            class="flex items-center justify-center gap-2 w-full px-4 py-2.5 text-sm font-semibold text-white bg-emerald-600 rounded-lg hover:bg-emerald-700 disabled:opacity-50">
                        @if (isLoading)
                        {
                            <span class="inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Đang đặt lại...</span>
                        }
                        else
                        {
                            <span>Xác nhận đặt lại mật khẩu</span>
                        }
                    </button>
                </EditForm>

                <div class="flex items-center justify-between pt-1">
                    <button type="button" @onclick="HandleResendOtp" disabled="@(resendCooldown > 0 || isLoading)"
                            class="flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline disabled:opacity-50 disabled:no-underline disabled:cursor-not-allowed">
                        @if (isResending)
                        {
                            <span class="inline-block w-3.5 h-3.5 border-2 border-blue-600/30 border-t-blue-600 rounded-full animate-spin"></span>
                        }
                        @if (resendCooldown > 0)
                        {
                            @:Gửi lại OTP (@resendCooldown s)
                        }
                        else
                        {
                            @:Gửi lại OTP
                        }
                    </button>

                    <button type="button" @onclick="BackToStep1"
                            class="text-sm font-medium text-slate-500 hover:text-slate-700 hover:underline">
                        Đổi email
                    </button>
                </div>
            }

            @* ===== STEP 3: Thành công ===== *@
            else if (currentStep == Step.Success)
            {
                <div class="py-4 text-center">
                    @* Big green checkmark *@
                    <div class="check-icon inline-flex items-center justify-center w-24 h-24 mb-6 rounded-full bg-emerald-100">
                        <svg class="w-14 h-14 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>

                    <h3 class="fade-up text-xl font-bold text-slate-900 mb-2">Đặt lại mật khẩu thành công!</h3>
                    <p class="fade-up text-sm text-slate-500 mb-6">Mật khẩu đã được cập nhật. Đang chuyển hướng về trang đăng nhập...</p>

                    <div class="fade-up-delay p-4 rounded-xl bg-emerald-50 ring-1 ring-emerald-200">
                        <p class="text-sm font-medium text-emerald-700">
                            ✅ Bạn có thể đăng nhập ngay bằng mật khẩu mới
                        </p>
                    </div>

                    <a href="/login"
                       class="fade-up-delay block w-full mt-5 px-4 py-2.5 text-sm font-semibold text-center text-white bg-emerald-600 rounded-lg hover:bg-emerald-700">
                        Đăng nhập ngay
                    </a>
                </div>
            }

            @if (currentStep != Step.Success)
            {
                <a href="/login"
                   class="block w-full px-4 py-2.5 text-sm font-semibold text-center text-slate-700 bg-slate-100 rounded-lg hover:bg-slate-200">
                    Quay lại đăng nhập
                </a>
            }
        </div>
    </div>
</div>

@code {
    private const string InputClass = "block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors sm:text-sm";
    private const int CooldownSeconds = 60;
    private const int RedirectDelayMs = 3000;

    private enum Step { EnterEmail, EnterOtp, Success }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    private Step currentStep = Step.EnterEmail;
    private bool isLoading;
    private bool isResending;
    private string? message;
    private bool isError;
    private string sentToEmail = string.Empty;
    private int resendCooldown;
    private System.Threading.Timer? countdownTimer;

    private SendOtpModel sendOtpModel { get; set; } = new();
    private ResetPasswordDto resetModel { get; set; } = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            sendOtpModel.Email = Email;
        }
    }

    private async Task HandleSendOtp()
    {
        isLoading = true;
        message = null;

        try
        {
            var result = await AuthService.SendPasswordResetOtpAsync(sendOtpModel.Email);
            isError = !result.Success;
            message = result.Message;

            if (result.Success)
            {
                sentToEmail = sendOtpModel.Email.Trim();
                resetModel.Email = sentToEmail;
                currentStep = Step.EnterOtp;
                message = null;
                StartCooldown();
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = "Lỗi gửi OTP: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleResendOtp()
    {
        if (resendCooldown > 0) return;

        isResending = true;
        message = null;

        try
        {
            var result = await AuthService.SendPasswordResetOtpAsync(sentToEmail);
            isError = !result.Success;
            message = result.Message;

            if (result.Success)
            {
                StartCooldown();
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = "Lỗi gửi lại OTP: " + ex.Message;
        }
        finally
        {
            isResending = false;
        }
    }

    private async Task HandleResetPassword()
    {
        isLoading = true;
        message = null;

        try
        {
            var result = await AuthService.ResetPasswordWithOtpAsync(
                resetModel.Email,
                resetModel.Otp,
                resetModel.NewPassword);

            isError = !result.Success;
            message = result.Message;

            if (result.Success)
            {
                currentStep = Step.Success;
                StopCooldown();
                _ = RedirectAfterDelay();
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = "Lỗi đặt lại mật khẩu: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RedirectAfterDelay()
    {
        await Task.Delay(RedirectDelayMs);
        NavigationManager.NavigateTo("/login");
    }

    private void BackToStep1()
    {
        currentStep = Step.EnterEmail;
        message = null;
        isError = false;
        resetModel = new ResetPasswordDto();
        StopCooldown();
    }

    private void StartCooldown()
    {
        resendCooldown = CooldownSeconds;
        StopCooldown();
        countdownTimer = new System.Threading.Timer(async _ =>
        {
            resendCooldown--;
            if (resendCooldown <= 0)
            {
                resendCooldown = 0;
                StopCooldown();
            }
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void StopCooldown()
    {
        countdownTimer?.Dispose();
        countdownTimer = null;
    }

    public void Dispose()
    {
        StopCooldown();
    }

    public class SendOtpModel
    {
        [Required(ErrorMessage = "Vui lòng nhập email!")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ!")]
        public string Email { get; set; } = string.Empty;
    }
}
