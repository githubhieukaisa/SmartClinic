@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Trang chủ - SmartClinic</PageTitle>

<div class="min-h-[calc(100vh-4rem)] bg-slate-50 flex items-center justify-center p-6">
    <div class="max-w-4xl w-full">
        @if (_isRedirecting)
        {
            <div class="text-center animate-pulse">
                <i class="ph-bold ph-spinner-gap text-4xl text-primary animate-spin mb-4"></i>
                <p class="text-slate-500 font-medium">Đang chuyển hướng đến khu vực làm việc...</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-3xl border border-slate-200 p-12 shadow-sm text-center space-y-10">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-primary/10 text-primary mb-8">
                    <i class="ph-fill ph-hospital text-4xl"></i>
                </div>

                <h1 class="text-4xl font-extrabold text-slate-900 mb-4 tracking-tight">
                    Chào mừng đến với <span class="text-primary">SmartClinic</span>
                </h1>

                <p class="text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
                    Hệ thống quản lý phòng khám thông minh, hỗ trợ tối ưu quy trình tiếp đón,
                    khám bệnh và xét nghiệm theo thời gian thực.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left py-4">
                    <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50/50">
                        <i class="ph ph-users-three text-2xl text-primary mb-3"></i>
                        <h3 class="font-bold text-slate-800 mb-1">Dành cho Bệnh nhân</h3>
                        <p class="text-sm text-slate-500">Đặt lịch hẹn và theo dõi lịch sử khám bệnh cá nhân.</p>
                    </div>
                    <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50/50">
                        <i class="ph ph-stethoscope text-2xl text-primary mb-3"></i>
                        <h3 class="font-bold text-slate-800 mb-1">Dành cho Bác sĩ</h3>
                        <p class="text-sm text-slate-500">Quản lý hàng đợi và thực hiện khám bệnh thông minh.</p>
                    </div>
                    <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50/50">
                        <i class="ph ph-flask text-2xl text-primary mb-3"></i>
                        <h3 class="font-bold text-slate-800 mb-1">Cận lâm sàng</h3>
                        <p class="text-sm text-slate-500">Xử lý kết quả xét nghiệm nhanh chóng và chính xác.</p>
                    </div>
                </div>

                <div class="pt-4">
                    <a href="/login"
                           class="inline-flex items-center gap-3 px-10 py-4 bg-primary text-white text-lg font-bold rounded-xl hover:bg-primary/90 transition shadow-lg shadow-primary/20 hover:-translate-y-1 transform active:scale-95">
                        Bắt đầu làm việc <i class="ph ph-arrow-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool _isRedirecting = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var roleMaskClaim = user.FindFirst("RoleMask")?.Value;
            if (int.TryParse(roleMaskClaim, out int roleMask))
            {
                var redirectUrl = AuthService.GetRedirectUrl(roleMask);

                if (redirectUrl != "/")
                {
                    NavManager.NavigateTo(redirectUrl, forceLoad: true);
                    return;
                }
            }
        }

        _isRedirecting = false;
    }
}
