@page "/checkin"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Policy = "ReceptionPolicy")]
@using Blazored.Toast.Services
@using SmartClinic.Components.Common
@using SmartClinic.Models
@using SmartClinic.Services
@using SmartClinic.Services.Exceptions
@using SmartClinic.DTOs
@inject ITicketService TicketService
@inject IDepartmentService DepartmentService
@inject IToastService ToastService
@inject ILogger<CheckInTicket> Logger
@rendermode InteractiveServer

<div class="flex items-center justify-center min-h-screen p-4 bg-slate-50">
	<div class="max-w-6xl w-full mx-auto p-6 bg-white shadow-xl rounded-2xl ring-1 ring-slate-900/5 sm:p-8">

		<div class="mb-8 text-center">
			<h3 class="text-2xl font-bold tracking-tight text-slate-900">Quầy Lễ Tân</h3>
			<p class="mt-2 text-sm text-slate-500">Vui lòng nhập thông tin để cấp số đợi</p>
		</div>

		@if (generatedTicket == null)
		{
			<div class="checkin-layout">
				<div>
					<div class="h-full flex flex-col gap-5">
						<div>
							<label class="block mb-1 text-sm font-medium text-slate-700">Số điện thoại bệnh nhân</label>
							<input type="text"
								   @bind="patientPhone"
								   @onblur="CheckExistingPatient"
								   placeholder="VD: 0901234567"
								   class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
						</div>

						<div>
							<label class="block mb-1 text-sm font-medium text-slate-700">Giới tính</label>
							<div class="flex gap-3">
								<button type="button"
										@onclick="() => patientGender = true"
										class="@GetGenderButtonClass(true)">
									Nam
								</button>
								<button type="button"
										@onclick="() => patientGender = false"
										class="@GetGenderButtonClass(false)">
									Nữ
								</button>
							</div>
						</div>

						<div>
							<label class="block mb-1 text-sm font-medium text-slate-700">Loại ca</label>
							<div class="flex gap-2">
								<button type="button"
										@onclick="() => SetTicketType(TicketType.Normal)"
										class="@GetTicketTypeClass(TicketType.Normal)">
									Thường
								</button>
								<button type="button"
										@onclick="() => SetTicketType(TicketType.Priority)"
										class="@GetTicketTypeClass(TicketType.Priority)">
									⭐ Ưu tiên
								</button>
								@* <button type="button"
										@onclick="() => SetTicketType(TicketType.Emergency)"
										class="@GetTicketTypeClass(TicketType.Emergency)">
									🚨 Cấp cứu
								</button> *@
							</div>
							@if (selectedTicketType == TicketType.Emergency)
							{
								<span class="text-xs text-rose-600 mt-1 block">Bypass giới hạn ca và sức chứa. Luôn đứng đầu hàng đợi.</span>
							}
							else if (selectedTicketType == TicketType.Priority)
							{
								<span class="text-xs text-amber-600 mt-1 block">Ưu tiên xếp trước ~3-5 vị trí trong hàng đợi.</span>
							}
						</div>

						<div>
							<label class="block mb-1 text-sm font-medium text-slate-700">Tên bệnh nhân</label>
							<input type="text"
								   @bind="patientName"
								   placeholder="VD: Nguyễn Văn A"
								   class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />

							@if (isExistingPatient)
							{
								<span class="text-xs text-green-600 mt-1 block">Đã tìm thấy hồ sơ bệnh nhân</span>
							}
						</div>

						<div>
							<label class="block mb-1 text-sm font-medium text-slate-700">Chọn Chuyên Khoa</label>

							@if (isLoadingDepts)
							{
								<p>Đang tải danh sách chuyên khoa...</p>
							}
							else
							{
								<select value="@selectedDepartmentId"
										@onchange="HandleDepartmentChanged"
										class="block w-full px-3 py-2 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-700">
									<option value="0">-- Vui lòng chọn khoa --</option>
									@foreach (var dept in departments)
									{
										<option value="@dept.Id">@dept.Name</option>
									}
								</select>
							}
						</div>

						<div class="pt-2 mt-auto">
							<Button IsLoading="isLoading"
									OnClick="HandleGetTicket"
									Disabled="@(string.IsNullOrWhiteSpace(patientName) || selectedDepartmentId == 0)"
									class="@GetSubmitButtonClass()">
								@GetSubmitButtonText()
							</Button>
						</div>
					</div>
				</div>

				<div>
					<div class="h-full border border-slate-200 bg-slate-50 rounded-xl p-4 sm:p-5">
						<h4 class="text-lg font-semibold text-slate-800">Danh sách Bác sĩ / Ca trực đang mở</h4>

						@if (selectedDepartmentId == 0)
						{
							<p class="mt-3 text-sm text-slate-500">Vui lòng chọn chuyên khoa để xem ca trực đang mở.</p>
						}
						else if (isLoadingShifts)
						{
							<p class="mt-3 text-sm text-slate-500">Đang tải ca trực theo chuyên khoa...</p>
						}
						else
						{
							<div class="mt-4 overflow-y-auto max-h-125 pr-2 custom-scrollbar space-y-3">
								<div @onclick="() => selectedDoctorShiftId = null"
									 class="cursor-pointer rounded-xl border p-4 transition-all duration-200 @(selectedDoctorShiftId == null ? "ring-2 ring-blue-500 bg-blue-50 border-blue-200" : "bg-white border-slate-200 hover:bg-slate-100")">
									<div class="flex items-start justify-between gap-3">
										<div>
											<p class="font-semibold text-slate-800">Tự động phân luồng (Khuyên dùng)</p>
											<p class="text-sm text-slate-500 mt-1">Hệ thống sẽ tự chọn phòng và ca trực phù hợp nhất.</p>
										</div>
									</div>
								</div>

								@foreach (var shift in availableShifts)
								{
									var effectiveRemain = GetEffectiveRemainCapacity(shift);
									var isFull = effectiveRemain <= 0;
									var isSelected = selectedDoctorShiftId == shift.DoctorShiftId;
									var canSelect = !isFull || selectedTicketType == TicketType.Emergency;

									<div @onclick="() => SelectDoctorShift(shift)"
										 class="rounded-xl border p-4 transition-all duration-200 @(!canSelect ? "cursor-not-allowed bg-slate-100 text-slate-400 border-slate-200" : "cursor-pointer bg-white border-slate-200 hover:bg-slate-100") @(isSelected ? "ring-2 ring-blue-500 border-blue-200" : string.Empty)">
										<div class="flex items-start justify-between gap-3">
											<div>
												<p class="font-semibold text-slate-800 @(isFull ? "text-slate-500" : string.Empty)">@shift.DoctorName - @shift.RoomName</p>
												<p class="text-sm text-slate-500 mt-1">@shift.ShiftName | @shift.ShiftStartTime.ToString(@"hh\:mm") - @shift.ShiftEndTime.ToString(@"hh\:mm")</p>
												<p class="mt-2 text-sm @(isFull ? "text-rose-500" : "text-amber-600")">Đang chờ: @shift.WaitingCount</p>
											</div>
											<div class="text-right shrink-0">
												<p class="text-xs text-slate-500">Còn: @effectiveRemain/@shift.Capacity</p>
												@if (isFull)
												{
													<p class="mt-1 text-xs font-semibold text-rose-600">Đã đầy</p>
												}
											</div>
										</div>
									</div>
								}

								@if (availableShifts.Count == 0)
								{
									<p class="text-xs text-amber-600">Không có ca trực khả dụng cho khoa này.</p>
								}
							</div>
						}
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="min-h-[60vh] flex items-center justify-center">
				<div class="w-full max-w-2xl flex flex-col items-center justify-center p-10 border-2 border-green-100 bg-green-50 rounded-2xl animate-fade-in-up">
					<div class="flex items-center justify-center w-16 h-16 mb-4 bg-green-100 rounded-full">
						<svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
					</div>

					<h4 class="text-2xl font-semibold text-green-800">Cấp số thành công!</h4>
					<p class="mt-2 text-base text-green-600">Bệnh nhân: <span class="font-medium text-green-900">@patientName</span></p>

					@if (selectedTicketType == TicketType.Emergency)
					{
						<span class="mt-2 inline-block px-3 py-1 text-sm font-bold text-white bg-rose-600 rounded-full">🚨 CẤP CỨU</span>
					}
					else if (selectedTicketType == TicketType.Priority)
					{
						<span class="mt-2 inline-block px-3 py-1 text-sm font-bold text-white bg-amber-500 rounded-full">⭐ ƯU TIÊN</span>
					}

					<div class="w-full mt-6 text-center">
						<span class="block text-sm font-semibold tracking-wider text-green-600 uppercase">Số thứ tự của bạn</span>
						<span class="text-7xl font-black text-green-700 drop-shadow-sm">@generatedTicket.TicketNumber</span>

						<div class="p-4 mt-5 bg-white border border-green-200 shadow-sm rounded-lg">
							<span class="block text-base text-slate-500">Xin mời đến:</span>
							<span class="block text-2xl font-bold text-blue-700">@generatedTicket.Room?.Name</span>
							<span class="block text-sm text-slate-400">(@generatedTicket.Room?.Location)</span>
						</div>
					</div>

					<button @onclick="ResetForm" class="mt-6 text-base font-medium text-slate-500 hover:text-slate-800 underline transition-colors">
						Cấp số bệnh nhân tiếp theo
					</button>
				</div>
			</div>
		}
	</div>
</div>

<style>
	.checkin-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
	}

	@@media (min-width: 1024px) {
		.checkin-layout {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		}
	}
</style>

@code {
	[CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

	private string patientName = string.Empty;
	private bool patientGender = true; // true = Nam, false = Nu
	private string patientPhone = string.Empty;
	private bool isExistingPatient = false;
	private bool isLoading = false;
	private QueueTicket? generatedTicket;
	private List<Department> departments = new();
	private List<ReceptionRoomLiveItemDto> availableShifts = new();
	private int selectedDepartmentId;
	private int? selectedDoctorShiftId;
	private bool isLoadingDepts = false;
	private bool isLoadingShifts = false;
	private int? currentUserId;
	private const int WalkInOverflowCapacity = 3;

	protected override async Task OnInitializedAsync()
	{
		isLoadingDepts = true;
		departments = await DepartmentService.GetAllDepartmentsAsync();
		isLoadingDepts = false;

		// Get userId from AuthenticationState
		if (AuthenticationStateTask is not null)
		{
			var authState = await AuthenticationStateTask;
			var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
			if (int.TryParse(userIdClaim, out var userId))
			{
				currentUserId = userId;
			}
			else
			{
				Logger.LogWarning("Unable to parse UserId claim. Value: {UserIdClaim}", userIdClaim);
			}
		}
	}

	private async Task HandleGetTicket()
	{
		if (string.IsNullOrWhiteSpace(patientName))
		{
			ToastService.ShowWarning("Vui lòng nhập tên bệnh nhân!");
			return;
		}

		if (selectedDepartmentId == 0)
		{
			ToastService.ShowWarning("Vui lòng chọn chuyên khoa!");
			return;
		}

		isLoading = true;
		generatedTicket = null;

		try
		{
			var ticketRequest = new GenerateTicketRequest
			{
				PatientName = patientName,
				PatientPhone = patientPhone,
				DepartmentId = selectedDepartmentId,
				DoctorShiftId = selectedDoctorShiftId,
				PatientGender = patientGender,
				UserId = currentUserId,
				IsEmergency = selectedTicketType == TicketType.Emergency,
				IsPriority = selectedTicketType == TicketType.Priority
			};

			generatedTicket = await TicketService.GenerateTicketAsync(ticketRequest);

			ToastService.ShowSuccess($"Cấp số thành công cho bệnh nhân {patientName}!");
		}
		catch (BusinessException bex)
		{
			// Business validation error, safe to show for user
			ToastService.ShowError(bex.Message);
			Logger.LogWarning(bex, "Business error when generating ticket for patient: {PatientName}, Phone: {Phone}, DeptId: {DeptId}, UserId: {UserId}", patientName, patientPhone, selectedDepartmentId, currentUserId);
		}
		catch (Exception ex)
		{
			// System error, avoid leaking technical details
			Logger.LogError(ex, "System error when generating ticket for patient: {PatientName}, Phone: {Phone}, DeptId: {DeptId}, UserId: {UserId}",
			patientName, patientPhone, selectedDepartmentId, currentUserId);

			ToastService.ShowError("Đã xảy ra sự cố trong quá trình cấp số. Vui lòng thử lại sau hoặc liên hệ bộ phận IT.");
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task HandleDepartmentChanged(ChangeEventArgs e)
	{
		selectedDoctorShiftId = null;
		availableShifts.Clear();

		if (!int.TryParse(e.Value?.ToString(), out var departmentId))
		{
			selectedDepartmentId = 0;
			return;
		}

		selectedDepartmentId = departmentId;
		await GetAvailableShifts(departmentId);
	}

	private async Task GetAvailableShifts(int departmentId)
	{
		if (departmentId <= 0)
		{
			availableShifts.Clear();
			selectedDoctorShiftId = null;
			return;
		}

		isLoadingShifts = true;
		try
		{
			availableShifts = await TicketService.GetAvailableShiftsAsync(departmentId);
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Failed to load available shifts for DepartmentId={DepartmentId}", departmentId);
			ToastService.ShowError("Không thể tải danh sách ca trực. Vui lòng thử lại.");
			availableShifts.Clear();
			selectedDoctorShiftId = null;
		}
		finally
		{
			isLoadingShifts = false;
		}
	}

	private async Task CheckExistingPatient()
	{
		if (string.IsNullOrWhiteSpace(patientPhone)) return;

		var existingPatient = await TicketService.FindPatientByPhoneAsync(patientPhone);
		if (existingPatient != null)
		{
			patientName = existingPatient.FullName ?? string.Empty;
			patientGender = existingPatient.Gender ?? true;
			isExistingPatient = true;
			ToastService.ShowInfo($"Đã tìm thấy hồ sơ: {patientName}");
		}
		else
		{
			if (isExistingPatient) patientName = string.Empty;
			patientGender = true;
			isExistingPatient = false;
		}
	}

	private void ResetForm()
	{
		patientName = string.Empty;
		patientPhone = string.Empty;
		patientGender = true;
		selectedDepartmentId = 0;
		selectedDoctorShiftId = null;
		availableShifts.Clear();
		generatedTicket = null;
		isExistingPatient = false;
		selectedTicketType = TicketType.Normal;
	}

	private void SelectDoctorShift(ReceptionRoomLiveItemDto shift)
	{
		var canSelect = GetEffectiveRemainCapacity(shift) > 0 || selectedTicketType == TicketType.Emergency;
		if (!canSelect)
		{
			return;
		}

		selectedDoctorShiftId = shift.DoctorShiftId;
	}

	private string GetGenderButtonClass(bool isMale)
	{
		string baseClass = "flex-1 px-4 py-2 rounded-lg font-medium transition-colors duration-200";
		string activeClass = (isMale ? patientGender : !patientGender)
		? "bg-blue-500 text-white shadow-md"
		: "bg-slate-100 text-slate-700 border border-slate-300 hover:bg-slate-200";

		return $"{baseClass} {activeClass}";
	}

	private static int GetEffectiveRemainCapacity(ReceptionRoomLiveItemDto shift)
	{
		if (shift.RemainCapacity > 0)
		{
			return Math.Clamp(shift.RemainCapacity, 0, shift.Capacity);
		}

		return Math.Max(0, WalkInOverflowCapacity - shift.WaitingCount);
	}

	// === Ticket Type ===
	private enum TicketType { Normal, Priority, Emergency }
	private TicketType selectedTicketType = TicketType.Normal;

	private void SetTicketType(TicketType type)
	{
		selectedTicketType = type;
	}

	private string GetTicketTypeClass(TicketType type)
	{
		var baseClass = "flex-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-200";
		if (selectedTicketType == type)
		{
			return type switch
			{
				TicketType.Emergency => $"{baseClass} bg-rose-600 text-white shadow-md",
				TicketType.Priority => $"{baseClass} bg-amber-500 text-white shadow-md",
				_ => $"{baseClass} bg-blue-500 text-white shadow-md"
			};
		}
		return $"{baseClass} bg-slate-100 text-slate-700 border border-slate-300 hover:bg-slate-200";
	}

	private string GetSubmitButtonClass()
	{
		var baseClass = "w-full disabled:opacity-50 disabled:cursor-not-allowed";
		return selectedTicketType switch
		{
			TicketType.Emergency => $"{baseClass} !bg-rose-600 hover:!bg-rose-700",
			TicketType.Priority => $"{baseClass} !bg-amber-500 hover:!bg-amber-600",
			_ => baseClass
		};
	}

	private string GetSubmitButtonText()
	{
		return selectedTicketType switch
		{
			TicketType.Emergency => "🚨 Cấp Số Cấp Cứu",
			TicketType.Priority => "⭐ Cấp Số Ưu Tiên",
			_ => "Cấp Số"
		};
	}
}
