@page "/login"
@layout SmartClinic.Components.Layout.KioskLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using SmartClinic.Components.Common
@using SmartClinic.Services
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt

@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="flex items-center justify-center min-h-screen p-4 bg-slate-100">
    <div class="w-full max-w-md p-8 bg-white shadow-2xl rounded-2xl ring-1 ring-slate-900/5">

        <div class="mb-8 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-blue-50">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z">
                    </path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold tracking-tight text-slate-900">Đăng Nhập SmartClinic</h3>
            <p class="mt-2 text-sm text-slate-500">Hệ thống quản lý phòng khám thông minh</p>
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" FormName="loginForm" class="space-y-5">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3 text-sm text-red-600 bg-red-100 rounded">@errorMessage</div>
            }

            <div>
                <label for="usernameOrEmail" class="block mb-1 text-sm font-medium text-slate-700">Tên đăng nhập hoặc
                    Email</label>
                    <InputText id="usernameOrEmail" @bind-Value="loginModel.UsernameOrEmail"
                               class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors sm:text-sm"
                               placeholder="Nhập username hoặc email..." />
                    <ValidationMessage For="@(() => loginModel.UsernameOrEmail)" class="mt-1 text-xs text-red-500" />
                </div>

                <div>
                    <label for="password" class="block mb-1 text-sm font-medium text-slate-700">Mật khẩu</label>
                    <InputText id="password" type="password" @bind-Value="loginModel.Password"
                               class="block w-full px-4 py-2 text-slate-900 bg-white border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors sm:text-sm"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => loginModel.Password)" class="mt-1 text-xs text-red-500" />
                </div>

                <div class="flex justify-between items-center pt-1">
                    <a href="/forgot-password"
                           class="text-sm font-medium text-blue-600 transition-colors hover:text-blue-700 hover:underline">
                        Quên mật khẩu?
                    </a>

                    <div class="text-sm text-slate-600">
                        Chưa có tài khoản bệnh nhân?
                        <a href="/register" class="font-semibold text-blue-600 hover:text-blue-700">Đăng ký ngay</a>
                    </div>
                </div>

                <div class="pt-2">
                    <Button Type="submit" IsLoading="isLoading">
                        Đăng Nhập Vào Hệ Thống
                    </Button>
                </div>
            </EditForm>
        </div>
    </div>

@code {
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = default!;
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private bool isLoading = false;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        loginModel ??= new LoginModel();
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(loginModel.UsernameOrEmail, loginModel.Password);

            if (response != null && HttpContext != null)
            {
                var handler = new JwtSecurityTokenHandler();
                var jwtToken = handler.ReadJwtToken(response.AccessToken);

                var claims = jwtToken.Claims.ToList();
                var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

                var authProperties = new AuthenticationProperties
                {
                    IsPersistent = true,
                    ExpiresUtc = DateTimeOffset.UtcNow.AddDays(7)
                };

                authProperties.StoreTokens(new[]
                {
                    new AuthenticationToken { Name = "access_token", Value = response.AccessToken },
                    new AuthenticationToken { Name = "refresh_token", Value = response.RefreshToken }
                });

                await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity),
authProperties);

                var roleMaskClaim = jwtToken.Claims.FirstOrDefault(c => c.Type == "RoleMask")?.Value;
                string redirectUrl = "/";

                if (int.TryParse(roleMaskClaim, out int roleMask))
                {
                    if ((roleMask & 16) == 16)
                    {
                        redirectUrl = "/admin/users";
                    }
                    else if ((roleMask & 64) == 64)
                    {
                        redirectUrl = "/";
                    }
                    else if ((roleMask & 128) == 128)
                    {
                        redirectUrl = "/patient/medical-history";
                    }
                    else if ((roleMask & 2) == 2)
                    {
                        redirectUrl = "/doctor/dashboard";
                    }
                    else if ((roleMask & 1) == 1)
                    {
                        redirectUrl = "/checkin";
                    }
                    else if ((roleMask & 32) == 32)
                    {
                        redirectUrl = "/lab";
                    }
                    else if ((roleMask & 8) == 8)
                    {
                        redirectUrl = "/cashier/payments";
                    }
                    else if ((roleMask & 4) == 4)
                    {
                        redirectUrl = "/pharmacist/prescriptions";
                    }
                }
                NavigationManager.NavigateTo(redirectUrl, forceLoad: true);
            }
            else if (HttpContext == null)
            {
                errorMessage = "Lỗi hệ thống: HttpContext bị null. Vui lòng kiểm tra lại cấu hình RenderMode ở App.razor!";
            }
            else
            {
                errorMessage = "Sai tên đăng nhập/email hoặc mật khẩu! Vui lòng thử lại.";
            }
        }
        catch (NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi hệ thống: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập hoặc email!")]
        public string UsernameOrEmail { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu!")]
        public string Password { get; set; } = "";
    }
}