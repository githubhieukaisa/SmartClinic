@page "/admin/scheduling"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.DTOs
@using SmartClinic.Models
@using SmartClinic.Constant

@attribute [Authorize(Policy = "ManagerPolicy")]
@rendermode InteractiveServer

@inject IDoctorShiftService ShiftService
@inject IJSRuntime JSRuntime

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 ml-4">Phân lịch trực theo Tuần</h1>
        <p class="text-sm text-slate-500 mt-1 ml-4">Quản lý ca trực cho các phòng khám theo lịch tuần</p>
    </div>
    <div class="flex items-center gap-3">
        <!-- Điều hướng tuần -->
        <div class="flex items-center bg-white border border-slate-300 rounded-lg overflow-hidden shadow-sm">
            <button @onclick="PreviousWeek" class="px-3 py-2 text-slate-600 hover:bg-slate-100 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div class="px-4 py-2 font-medium text-sm text-slate-700 border-x border-slate-300 bg-slate-50">
                Tuần: @currentWeekMonday.ToString("dd/MM/yyyy") - @currentWeekMonday.AddDays(6).ToString("dd/MM/yyyy")
            </div>
            <button @onclick="NextWeek" class="px-3 py-2 text-slate-600 hover:bg-slate-100 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>

        <button @onclick="LoadData"
                class="px-4 py-2 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 transition font-medium text-sm border border-slate-300">
            Xóa nháp (Chưa lưu)
        </button>
        <button @onclick="SaveChanges" disabled="@isSaving"
                class="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 disabled:opacity-50 transition-colors font-medium text-sm shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            @(isSaving ? "Đang lưu..." : "Lưu lịch tuần")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="mb-4 p-4 rounded-lg bg-red-50 text-red-700 border border-red-200 text-sm flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        @errorMessage
    </div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="mb-4 p-4 rounded-lg bg-teal-50 text-teal-700 border border-teal-200 text-sm flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        @successMessage
    </div>
}

@if (isLoading)
{
    <div class="bg-white rounded-xl shadow-sm p-12 text-center text-slate-400">
        <p class="text-lg">Đang tải lịch tuần...</p>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm overflow-hidden ring-1 ring-slate-200 overflow-x-auto">
        <table class="w-full text-sm border-collapse min-w-[1200px]">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="w-48 text-left px-4 py-3 font-semibold text-slate-600 border-r border-slate-200" style="position: sticky; left: 0; background: #f8fafc; z-index: 10;">
                        Phòng \ Ca
                    </th>
                    @for (int i = 0; i < 7; i++)
                    {
                        var d = currentWeekMonday.AddDays(i);
                        <th class="text-center px-2 py-3 font-semibold text-slate-600 border-r border-slate-200 min-w-[140px]">
                            @GetDayName(d)<br />
                            <span class="text-xs text-slate-400 font-normal">@d.ToString("dd/MM")</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                @foreach (var room in rooms)
                {
                    <tr class="bg-slate-100/50">
                        <td colspan="8" class="px-4 py-2 font-bold text-slate-700 border-b border-slate-200 sticky left-0 z-10">
                            @room.Department?.Name  -  @room.Name <span class="text-xs font-normal text-slate-500">(@room.Location)</span>
                        </td>
                    </tr>
                    @foreach (var shiftDef in shiftDefinitions)
                    {
                        <tr>
                            <td class="px-4 py-3 font-medium text-slate-600 border-r border-slate-200 bg-white sticky left-0 z-10 shadow-[1px_0_0_0_#e2e8f0]">
                                @shiftDef.Name
                                <div class="text-[10px] text-slate-400 font-normal">
                                    @shiftDef.StartTime.ToString(@"hh\:mm") - @shiftDef.EndTime.ToString(@"hh\:mm")
                                </div>
                            </td>
                            @for (int i = 0; i < 7; i++)
                            {
                                var currentDate = currentWeekMonday.AddDays(i);
                                var key = GetKey(room.Id, currentDate, shiftDef.Id);
                                var cellState = currentGridState.ContainsKey(key) ? currentGridState[key] : null;

                                <td class="p-2 border-r border-slate-100 hover:bg-slate-50 transition relative">
                                    @if (cellState != null)
                                    {
                                        var dbShift = originalShifts.FirstOrDefault(s => s.Id == cellState.Id);
                                        bool isCompleted = dbShift != null && dbShift.Status == "Đã hoàn thành";

                                        // Business Rules validation
                                        bool canEdit = false;
                                        string lockReason = "";
                                        
                                        if (isCompleted || currentDate.Date < DateTime.Today)
                                        {
                                            canEdit = false;
                                            lockReason = "Ca trực trong quá khứ không thể thay đổi.";
                                        }
                                        else
                                        {
                                            canEdit = true;
                                        }

                                        <div title="@lockReason">
                                            <select class="w-full text-xs p-1.5 border border-slate-200 rounded focus:border-teal-500 focus:ring-1 focus:ring-teal-500 outline-none
                                                           @(cellState.DoctorId > 0 ? "bg-teal-50/50 font-medium text-teal-800" : "text-slate-500")
                                                           @(originalGridDocMap.ContainsKey(key) && originalGridDocMap[key] != cellState.DoctorId ? "border-amber-300 bg-amber-50" : "")
                                                           @(!canEdit ? "opacity-60 cursor-not-allowed bg-slate-100" : "")"
                                                    disabled="@(!canEdit)"
                                                    @onchange="(e) => OnDoctorChanged(key, e.Value?.ToString())">
                                                <option value="0">- Trống -</option>
                                                @foreach (var doc in doctors)
                                                {
                                                    <!-- If it's pre-selected, it will match -->
                                                    if (cellState.DoctorId == doc.Id)
                                                    {
                                                        <option value="@doc.Id" selected>@doc.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@doc.Id">@doc.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        
                                        @if(cellState.Id > 0 && originalGridDocMap.ContainsKey(key) && originalGridDocMap[key] == cellState.DoctorId)
                                        {
                                            <!-- Chỗ này có thể hiển thị Status Computed của DB shift nếu nó map khớp -->
                                            if (dbShift != null)
                                            {
                                                <div class="mt-1 flex justify-center">
                                                    <span class="text-[10px] font-medium px-2 py-[1px] border rounded-full @GetStatusColor(dbShift.Status)">
                                                        @dbShift.Status
                                                    </span>
                                                </div>
                                            }
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private DateTime currentWeekMonday;

    private List<Room> rooms = new();
    private List<User> doctors = new();
    private List<ShiftDefinition> shiftDefinitions = new();
    
    // DB state
    private List<DoctorShiftDisplayDto> originalShifts = new();
    private Dictionary<string, int> originalGridDocMap = new();

    // UI tracking state
    private Dictionary<string, DoctorShiftWeeklyUpdateDto> currentGridState = new();

    protected override async Task OnInitializedAsync()
    {
        // Compute Monday of this week
        int diff = (7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7;
        currentWeekMonday = DateTime.Today.AddDays(-1 * diff);

        await LoadData();
    }

    private string GetKey(int roomId, DateTime date, int shiftDefId) => $"{roomId}_{date:yyyyMMdd}_{shiftDefId}";

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        
        // Parallel-like logic but DB context needs sequential or separate factories. Service manages own factories!
        rooms = await ShiftService.GetRoomsAsync();
        doctors = await ShiftService.GetDoctorsAsync();
        shiftDefinitions = await ShiftService.GetShiftDefinitionsAsync();

        await LoadShiftsForCurrentWeek();
        
        isLoading = false;
    }

    private async Task LoadShiftsForCurrentWeek()
    {
        var nextMonday = currentWeekMonday.AddDays(7);
        originalShifts = await ShiftService.GetShiftsAsync(currentWeekMonday, nextMonday);

        currentGridState.Clear();
        originalGridDocMap.Clear();

        // 1. Initialize all cells to empty
        foreach (var r in rooms)
        {
            foreach (var sDef in shiftDefinitions)
            {
                for (int i = 0; i < 7; i++)
                {
                    var d = currentWeekMonday.AddDays(i);
                    var k = GetKey(r.Id, d, sDef.Id);
                    currentGridState[k] = new DoctorShiftWeeklyUpdateDto
                    {
                        Id = 0,
                        RoomId = r.Id,
                        ShiftDefinitionId = sDef.Id,
                        Date = d,
                        DoctorId = 0,
                        IsDeleted = false
                    };
                    originalGridDocMap[k] = 0;
                }
            }
        }

        // 2. Map existing DB data to grid
        foreach (var s in originalShifts)
        {
            // TÌm shift definition của cái shift này (lưu qua s.ShiftName)
            var def = shiftDefinitions.FirstOrDefault(d => d.Name == s.ShiftName);
            if (def != null)
            {
                var k = GetKey(s.RoomId, s.StartTime.Date, def.Id);
                if (currentGridState.ContainsKey(k))
                {
                    currentGridState[k].Id = s.Id;
                    currentGridState[k].DoctorId = s.DoctorId;
                    originalGridDocMap[k] = s.DoctorId;
                }
            }
        }
    }

    private void OnDoctorChanged(string key, string? value)
    {
        if (currentGridState.ContainsKey(key))
        {
            if (int.TryParse(value, out int docId))
            {
                currentGridState[key].DoctorId = docId;
            }
        }
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        var updatesToSave = new List<DoctorShiftWeeklyUpdateDto>();

        foreach (var kvp in currentGridState)
        {
            var key = kvp.Key;
            var cell = kvp.Value;
            var originalDocId = originalGridDocMap.ContainsKey(key) ? originalGridDocMap[key] : 0;

            if (cell.DoctorId != originalDocId)
            {
                if (cell.DoctorId == 0 && cell.Id > 0)
                {
                    // Existing shift was cleared -> DELETE
                    cell.IsDeleted = true;
                    updatesToSave.Add(cell);
                }
                else if (cell.DoctorId > 0)
                {
                    // New shift OR updated doctor -> UPSERT
                    cell.IsDeleted = false;
                    updatesToSave.Add(cell);
                }
            }
        }

        if (!updatesToSave.Any())
        {
            successMessage = "Không có thay đổi nào để lưu.";
            isSaving = false;
            return;
        }

        var (success, error) = await ShiftService.BulkSaveShiftsAsync(updatesToSave);

        if (success)
        {
            successMessage = "Đã lưu lịch trực tuần thành công!";
            await LoadShiftsForCurrentWeek(); // Reload để reset ID và original map
        }
        else
        {
            errorMessage = error;
        }

        isSaving = false;
    }

    private async Task PreviousWeek()
    {
        currentWeekMonday = currentWeekMonday.AddDays(-7);
        await LoadData();
    }

    private async Task NextWeek()
    {
        currentWeekMonday = currentWeekMonday.AddDays(7);
        await LoadData();
    }

    private string GetDayName(DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ 2",
            DayOfWeek.Tuesday => "Thứ 3",
            DayOfWeek.Wednesday => "Thứ 4",
            DayOfWeek.Thursday => "Thứ 5",
            DayOfWeek.Friday => "Thứ 6",
            DayOfWeek.Saturday => "Thứ 7",
            DayOfWeek.Sunday => "CN",
            _ => ""
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Đang trực" => "text-green-700 bg-green-100 border-green-200",
            "Đã hoàn thành" => "text-slate-600 bg-slate-100 border-slate-200",
            _ => "text-teal-700 bg-teal-100 border-teal-200" // Sắp diễn ra
        };
    }
}
