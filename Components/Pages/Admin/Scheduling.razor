@page "/admin/scheduling"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.DTOs
@using SmartClinic.Models
@using SmartClinic.Constant

@attribute [Authorize(Policy = "ManagerPolicy")]
@rendermode InteractiveServer

@inject IDoctorShiftService ShiftService
@inject IJSRuntime JSRuntime

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 ml-4">Phân lịch trực theo Tuần</h1>
        <p class="text-sm text-slate-500 mt-1 ml-4">Quản lý ca trực cho các phòng khám theo lịch tuần</p>
    </div>
    <div class="flex items-center gap-3">
        <!-- Điều hướng tuần -->
        <div class="flex items-center bg-white border border-slate-300 rounded-lg overflow-hidden shadow-sm">
            <button @onclick="PreviousWeek" class="px-3 py-2 text-slate-600 hover:bg-slate-100 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div class="px-4 py-2 font-medium text-sm text-slate-700 border-x border-slate-300 bg-slate-50">
                Tuần: @currentWeekMonday.ToString("dd/MM/yyyy") - @currentWeekMonday.AddDays(6).ToString("dd/MM/yyyy")
            </div>
            <button @onclick="NextWeek" class="px-3 py-2 text-slate-600 hover:bg-slate-100 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>

        <button @onclick="LoadData"
                class="px-4 py-2 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 transition font-medium text-sm border border-slate-300">
            Xóa nháp (Chưa lưu)
        </button>
        <button @onclick="OpenAutoScheduleModal"
                class="flex items-center gap-2 px-4 py-2 bg-white text-teal-700 rounded-lg hover:bg-teal-50 transition font-medium text-sm border border-teal-300 shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Phân lịch tự động
        </button>
        <button @onclick="SaveChanges" disabled="@isSaving"
                class="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 disabled:opacity-50 transition-colors font-medium text-sm shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            @(isSaving ? "Đang lưu..." : "Lưu lịch tuần")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="mb-4 p-4 rounded-lg bg-red-50 text-red-700 border border-red-200 text-sm flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        @errorMessage
    </div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="mb-4 p-4 rounded-lg bg-teal-50 text-teal-700 border border-teal-200 text-sm flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        @successMessage
    </div>
}

@* ══════════ PREVIEW BAR (khi đang xem trước) ══════════ *@
@if (previewItems.Any())
{
    <div class="mb-4 p-4 rounded-lg bg-amber-50 border border-amber-300 flex items-center justify-between">
        <div class="flex items-center gap-2 text-amber-800">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            <span class="font-medium text-sm">Đang xem trước: @previewItems.Count ca trực sẽ được tạo</span>
            @if (previewItems.Any(p => p.IsOverwrite))
            {
                <span class="text-xs text-red-600">(@previewItems.Count(p => p.IsOverwrite) ca ghi đè)</span>
            }
        </div>
        <div class="flex items-center gap-2">
            <button @onclick="CancelPreview"
                    class="px-4 py-2 bg-white text-slate-600 rounded-lg hover:bg-slate-100 transition font-medium text-sm border border-slate-300">
                Hủy
            </button>
            <button @onclick="ConfirmAutoSchedule" disabled="@isSaving"
                    class="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 disabled:opacity-50 transition-colors font-medium text-sm shadow-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                @(isSaving ? "Đang lưu..." : "Xác nhận lưu")
            </button>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="bg-white rounded-xl shadow-sm p-12 text-center text-slate-400">
        <p class="text-lg">Đang tải lịch tuần...</p>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm overflow-hidden ring-1 ring-slate-200 overflow-x-auto">
        <table class="w-full text-sm border-collapse min-w-[1200px]">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="w-48 text-left px-4 py-3 font-semibold text-slate-600 border-r border-slate-200" style="position: sticky; left: 0; background: #f8fafc; z-index: 10;">
                        Phòng \ Ca
                    </th>
                    @for (int i = 0; i < 7; i++)
                    {
                        var d = currentWeekMonday.AddDays(i);
                        <th class="text-center px-2 py-3 font-semibold text-slate-600 border-r border-slate-200 min-w-[140px]">
                            @GetDayName(d)<br />
                            <span class="text-xs text-slate-400 font-normal">@d.ToString("dd/MM")</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                @foreach (var room in rooms)
                {
                    <tr class="bg-slate-100/50">
                        <td colspan="8" class="px-4 py-2 font-bold text-slate-700 border-b border-slate-200 sticky left-0 z-10">
                            @room.Department?.Name  -  @room.Name <span class="text-xs font-normal text-slate-500">(@room.Location)</span>
                        </td>
                    </tr>
                    @foreach (var shiftDef in shiftDefinitions)
                    {
                        <tr>
                            <td class="px-4 py-3 font-medium text-slate-600 border-r border-slate-200 bg-white sticky left-0 z-10 shadow-[1px_0_0_0_#e2e8f0]">
                                @shiftDef.Name
                                <div class="text-[10px] text-slate-400 font-normal">
                                    @shiftDef.StartTime.ToString(@"hh\:mm") - @shiftDef.EndTime.ToString(@"hh\:mm")
                                </div>
                            </td>
                            @for (int i = 0; i < 7; i++)
                            {
                                var currentDate = currentWeekMonday.AddDays(i);
                                var key = GetKey(room.Id, currentDate, shiftDef.Id);
                                var cellState = currentGridState.ContainsKey(key) ? currentGridState[key] : null;

                                var previewItem = previewItems.FirstOrDefault(p =>
                                    p.RoomId == room.Id && p.Date.Date == currentDate.Date && p.ShiftDefinitionId == shiftDef.Id);
                                var hasPreview = previewItem != null;
                                <td class="p-2 border-r border-slate-100 hover:bg-slate-50 transition relative @(hasPreview ? "bg-amber-50/80" : "")">
                                    @if (hasPreview)
                                    {
                                        @* ── PREVIEW: hiển thị tên BS được phân tự động ── *@
                                        <div class="text-xs p-1.5 rounded border-2 border-dashed border-amber-400 bg-amber-50 text-amber-800 font-medium text-center">
                                            @previewItem!.DoctorName
                                            @if (previewItem.IsOverwrite)
                                            {
                                                <div class="text-[10px] text-red-500 font-normal">Ghi đè</div>
                                            }
                                        </div>
                                    }
                                    else if (cellState != null)
                                    {
                                        var dbShift = originalShifts.FirstOrDefault(s => s.Id == cellState.Id);
                                        bool isCompleted = dbShift != null && dbShift.Status == "Đã hoàn thành";

                                        // Business Rules validation
                                        bool canEdit = false;
                                        string lockReason = "";
                                        
                                        if (isCompleted || currentDate.Date < DateTime.Today)
                                        {
                                            canEdit = false;
                                            lockReason = "Ca trực trong quá khứ không thể thay đổi.";
                                        }
                                        else
                                        {
                                            canEdit = true;
                                        }

                                        <div title="@lockReason">
                                            <select class="w-full text-xs p-1.5 border border-slate-200 rounded focus:border-teal-500 focus:ring-1 focus:ring-teal-500 outline-none
                                                           @(cellState.DoctorId > 0 ? "bg-teal-50/50 font-medium text-teal-800" : "text-slate-500")
                                                           @(originalGridDocMap.ContainsKey(key) && originalGridDocMap[key] != cellState.DoctorId ? "border-amber-300 bg-amber-50" : "")
                                                           @(!canEdit ? "opacity-60 cursor-not-allowed bg-slate-100" : "")"
                                                    disabled="@(!canEdit)"
                                                    @onchange="(e) => OnDoctorChanged(key, e.Value?.ToString())">
                                                <option value="0">- Trống -</option>
                                                @foreach (var doc in doctors)
                                                {
                                                    if (cellState.DoctorId == doc.Id)
                                                    {
                                                        <option value="@doc.Id" selected>@doc.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@doc.Id">@doc.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        
                                        @if(cellState.Id > 0 && originalGridDocMap.ContainsKey(key) && originalGridDocMap[key] == cellState.DoctorId)
                                        {
                                            if (dbShift != null)
                                            {
                                                <div class="mt-1 flex justify-center">
                                                    <span class="text-[10px] font-medium px-2 py-[1px] border rounded-full @GetStatusColor(dbShift.Status)">
                                                        @dbShift.Status
                                                    </span>
                                                </div>
                                            }
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@* ══════════ MODAL PHÂN LỊCH TỰ ĐỘNG ══════════ *@
@if (showAutoScheduleModal)
{
    <div class="fixed inset-0 bg-black/40 z-40 flex items-start justify-center pt-16" @onclick="CloseAutoScheduleModal">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[80vh] overflow-y-auto" @onclick:stopPropagation="true">
            @* Header *@
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between sticky top-0 bg-white z-10 rounded-t-xl">
                <div>
                    <h2 class="text-lg font-bold text-slate-800">Phân lịch tự động</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Chọn thông số rồi bấm "Xem trước" để kiểm tra kết quả</p>
                </div>
                <button @onclick="CloseAutoScheduleModal" class="text-slate-400 hover:text-slate-600 p-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            @* Body *@
            <div class="px-6 py-4 space-y-5">
                @if (!string.IsNullOrEmpty(autoScheduleError))
                {
                    <div class="p-3 rounded-lg bg-red-50 text-red-700 text-sm border border-red-200 flex items-center gap-2">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        @autoScheduleError
                    </div>
                }

                @* ── Khoảng ngày ── *@
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Khoảng ngày</label>
                    <div class="flex items-center gap-3">
                        <div class="flex-1">
                            <label class="block text-xs text-slate-500 mb-1">Từ ngày</label>
                            <input type="date" @bind="autoRequest.FromDate" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:border-teal-500 focus:ring-1 focus:ring-teal-500 outline-none" />
                        </div>
                        <div class="flex-1">
                            <label class="block text-xs text-slate-500 mb-1">Đến ngày</label>
                            <input type="date" @bind="autoRequest.ToDate"
                                   class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:border-teal-500 focus:ring-1 focus:ring-teal-500 outline-none" />
                        </div>
                    </div>
                </div>

                @* ── Chọn bác sĩ ── *@
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-sm font-semibold text-slate-700">Bác sĩ</label>
                        <button @onclick="ToggleAllDoctors" class="text-xs text-teal-600 hover:text-teal-800 font-medium">
                            @(autoRequest.SelectedDoctorIds.Count == doctors.Count ? "Bỏ chọn tất cả" : "Chọn tất cả")
                        </button>
                    </div>
                    <div class="grid grid-cols-2 gap-2 max-h-36 overflow-y-auto border border-slate-200 rounded-lg p-3 bg-slate-50/50">
                        @foreach (var doc in doctors)
                        {
                            <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer hover:text-teal-700">
                                <input type="checkbox" checked="@autoRequest.SelectedDoctorIds.Contains(doc.Id)"
                                       @onchange="(e) => ToggleDoctor(doc.Id, (bool)(e.Value ?? false))"
                                       class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                <span>
                                    @(doc.FullName ?? doc.Username)
                                    @if (doc.Department != null)
                                    {
                                        <span class="text-[10px] text-slate-400 ml-1">(@doc.Department.Name)</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </div>

                @* ── Chọn phòng khám ── *@
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-sm font-semibold text-slate-700">Phòng khám</label>
                        <button @onclick="ToggleAllRooms" class="text-xs text-teal-600 hover:text-teal-800 font-medium">
                            @(autoRequest.SelectedRoomIds.Count == rooms.Count ? "Bỏ chọn tất cả" : "Chọn tất cả")
                        </button>
                    </div>
                    <div class="grid grid-cols-2 gap-2 max-h-36 overflow-y-auto border border-slate-200 rounded-lg p-3 bg-slate-50/50">
                        @foreach (var room in rooms)
                        {
                            <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer hover:text-teal-700">
                                <input type="checkbox" checked="@autoRequest.SelectedRoomIds.Contains(room.Id)"
                                       @onchange="(e) => ToggleRoom(room.Id, (bool)(e.Value ?? false))"
                                       class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                <span>@room.Department?.Name - @room.Name</span>
                            </label>
                        }
                    </div>
                </div>

                @* ── Chọn ca trực ── *@
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Ca trực</label>
                    <div class="flex flex-wrap gap-3">
                        @foreach (var sd in shiftDefinitions)
                        {
                            <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer hover:text-teal-700">
                                <input type="checkbox" checked="@autoRequest.SelectedShiftDefinitionIds.Contains(sd.Id)"
                                       @onchange="(e) => ToggleShiftDef(sd.Id, (bool)(e.Value ?? false))"
                                       class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                                @sd.Name <span class="text-xs text-slate-400">(@sd.StartTime.ToString(@"hh\:mm") - @sd.EndTime.ToString(@"hh\:mm"))</span>
                            </label>
                        }
                    </div>
                </div>

                @* ── Tùy chọn ── *@
                <div class="border-t border-slate-200 pt-4">
                    <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                        <input type="checkbox" @bind="autoRequest.OverwriteExisting"
                               class="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
                        <span>Ghi đè ca đã phân sẵn</span>
                        <span class="text-xs text-slate-400">(mặc định: chỉ điền ô trống)</span>
                    </label>
                </div>
            </div>

            @* Footer *@
            <div class="px-6 py-4 border-t border-slate-200 flex justify-end gap-3 sticky bottom-0 bg-white rounded-b-xl">
                <button @onclick="CloseAutoScheduleModal"
                        class="px-4 py-2 bg-white text-slate-600 rounded-lg hover:bg-slate-100 transition font-medium text-sm border border-slate-300">
                    Hủy
                </button>
                <button @onclick="RunPreview" disabled="@isPreviewLoading"
                        class="flex items-center gap-2 px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 disabled:opacity-50 transition-colors font-medium text-sm shadow-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    @(isPreviewLoading ? "Đang tính toán..." : "Xem trước")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private DateTime currentWeekMonday;

    private List<Room> rooms = new();
    private List<User> doctors = new();
    private List<ShiftDefinition> shiftDefinitions = new();
    
    // DB state
    private List<DoctorShiftDisplayDto> originalShifts = new();
    private Dictionary<string, int> originalGridDocMap = new();

    // UI tracking state
    private Dictionary<string, DoctorShiftWeeklyUpdateDto> currentGridState = new();

    // ── Auto-Schedule state ──
    private bool showAutoScheduleModal = false;
    private bool isPreviewLoading = false;
    private string autoScheduleError = string.Empty;
    private AutoScheduleRequestDto autoRequest = new();
    private List<AutoSchedulePreviewItemDto> previewItems = new();

    protected override async Task OnInitializedAsync()
    {
        // Compute Monday of this week
        int diff = (7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7;
        currentWeekMonday = DateTime.Today.AddDays(-1 * diff);

        await LoadData();
    }

    private string GetKey(int roomId, DateTime date, int shiftDefId) => $"{roomId}_{date:yyyyMMdd}_{shiftDefId}";

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        previewItems.Clear();
        
        rooms = await ShiftService.GetRoomsAsync();
        doctors = await ShiftService.GetDoctorsAsync();
        shiftDefinitions = await ShiftService.GetShiftDefinitionsAsync();

        await LoadShiftsForCurrentWeek();
        
        isLoading = false;
    }

    private async Task LoadShiftsForCurrentWeek()
    {
        var nextMonday = currentWeekMonday.AddDays(7);
        originalShifts = await ShiftService.GetShiftsAsync(currentWeekMonday, nextMonday);

        currentGridState.Clear();
        originalGridDocMap.Clear();

        foreach (var r in rooms)
        {
            foreach (var sDef in shiftDefinitions)
            {
                for (int i = 0; i < 7; i++)
                {
                    var d = currentWeekMonday.AddDays(i);
                    var k = GetKey(r.Id, d, sDef.Id);
                    currentGridState[k] = new DoctorShiftWeeklyUpdateDto
                    {
                        Id = 0,
                        RoomId = r.Id,
                        ShiftDefinitionId = sDef.Id,
                        Date = d,
                        DoctorId = 0,
                        IsDeleted = false
                    };
                    originalGridDocMap[k] = 0;
                }
            }
        }

        foreach (var s in originalShifts)
        {
            var def = shiftDefinitions.FirstOrDefault(d => d.Name == s.ShiftName);
            if (def != null)
            {
                var k = GetKey(s.RoomId, s.StartTime.Date, def.Id);
                if (currentGridState.ContainsKey(k))
                {
                    currentGridState[k].Id = s.Id;
                    currentGridState[k].DoctorId = s.DoctorId;
                    originalGridDocMap[k] = s.DoctorId;
                }
            }
        }
    }

    private void OnDoctorChanged(string key, string? value)
    {
        if (currentGridState.ContainsKey(key))
        {
            if (int.TryParse(value, out int docId))
            {
                currentGridState[key].DoctorId = docId;
            }
        }
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        var updatesToSave = new List<DoctorShiftWeeklyUpdateDto>();

        foreach (var kvp in currentGridState)
        {
            var key = kvp.Key;
            var cell = kvp.Value;
            var originalDocId = originalGridDocMap.ContainsKey(key) ? originalGridDocMap[key] : 0;

            if (cell.DoctorId != originalDocId)
            {
                if (cell.DoctorId == 0 && cell.Id > 0)
                {
                    cell.IsDeleted = true;
                    updatesToSave.Add(cell);
                }
                else if (cell.DoctorId > 0)
                {
                    cell.IsDeleted = false;
                    updatesToSave.Add(cell);
                }
            }
        }

        if (!updatesToSave.Any())
        {
            successMessage = "Không có thay đổi nào để lưu.";
            isSaving = false;
            return;
        }

        var (success, error) = await ShiftService.BulkSaveShiftsAsync(updatesToSave);

        if (success)
        {
            successMessage = "Đã lưu lịch trực tuần thành công!";
            await LoadShiftsForCurrentWeek();
        }
        else
        {
            errorMessage = error;
        }

        isSaving = false;
    }

    private async Task PreviousWeek()
    {
        currentWeekMonday = currentWeekMonday.AddDays(-7);
        await LoadData();
    }

    private async Task NextWeek()
    {
        currentWeekMonday = currentWeekMonday.AddDays(7);
        await LoadData();
    }

    // ══════════════════════════════════════════════════════
    // AUTO-SCHEDULE: Modal + Preview + Confirm
    // ══════════════════════════════════════════════════════

    private void OpenAutoScheduleModal()
    {
        autoScheduleError = string.Empty;
        autoRequest = new AutoScheduleRequestDto
        {
            FromDate = currentWeekMonday,
            ToDate = currentWeekMonday.AddDays(6),
            SelectedDoctorIds = new(),
            SelectedRoomIds = new(),
            SelectedShiftDefinitionIds = new(),
            OverwriteExisting = false
        };
        showAutoScheduleModal = true;
    }

    private void CloseAutoScheduleModal()
    {
        showAutoScheduleModal = false;
        autoScheduleError = string.Empty;
    }

    // ── Toggle helpers cho checkbox ──
    private void ToggleDoctor(int id, bool isChecked)
    {
        if (isChecked && !autoRequest.SelectedDoctorIds.Contains(id))
            autoRequest.SelectedDoctorIds.Add(id);
        else if (!isChecked)
            autoRequest.SelectedDoctorIds.Remove(id);
    }

    private void ToggleAllDoctors()
    {
        if (autoRequest.SelectedDoctorIds.Count == doctors.Count)
            autoRequest.SelectedDoctorIds.Clear();
        else
            autoRequest.SelectedDoctorIds = doctors.Select(d => d.Id).ToList();
    }

    private void ToggleRoom(int id, bool isChecked)
    {
        if (isChecked && !autoRequest.SelectedRoomIds.Contains(id))
            autoRequest.SelectedRoomIds.Add(id);
        else if (!isChecked)
            autoRequest.SelectedRoomIds.Remove(id);
    }

    private void ToggleAllRooms()
    {
        if (autoRequest.SelectedRoomIds.Count == rooms.Count)
            autoRequest.SelectedRoomIds.Clear();
        else
            autoRequest.SelectedRoomIds = rooms.Select(r => r.Id).ToList();
    }

    private void ToggleShiftDef(int id, bool isChecked)
    {
        if (isChecked && !autoRequest.SelectedShiftDefinitionIds.Contains(id))
            autoRequest.SelectedShiftDefinitionIds.Add(id);
        else if (!isChecked)
            autoRequest.SelectedShiftDefinitionIds.Remove(id);
    }

    // ── Chạy Preview (không ghi DB) ──
    private async Task RunPreview()
    {
        isPreviewLoading = true;
        autoScheduleError = string.Empty;

        var (items, error) = await ShiftService.PreviewAutoScheduleAsync(autoRequest);

        if (!string.IsNullOrEmpty(error))
        {
            autoScheduleError = error;
            isPreviewLoading = false;
            return;
        }

        previewItems = items;
        showAutoScheduleModal = false;
        isPreviewLoading = false;
        successMessage = string.Empty;
        errorMessage = string.Empty;
    }

    // ── Xác nhận lưu Preview vào DB ──
    private async Task ConfirmAutoSchedule()
    {
        isSaving = true;
        errorMessage = string.Empty;

        var result = await ShiftService.ConfirmAutoScheduleAsync(previewItems);

        if (result.Success)
        {
            successMessage = result.Summary;
            previewItems.Clear();
            await LoadShiftsForCurrentWeek();
        }
        else
        {
            errorMessage = result.Error;
        }

        isSaving = false;
    }

    // ── Hủy Preview ──
    private void CancelPreview()
    {
        previewItems.Clear();
    }

    // ══════════════════════════════════════════════════════
    // HELPERS
    // ══════════════════════════════════════════════════════

    private string GetDayName(DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ 2",
            DayOfWeek.Tuesday => "Thứ 3",
            DayOfWeek.Wednesday => "Thứ 4",
            DayOfWeek.Thursday => "Thứ 5",
            DayOfWeek.Friday => "Thứ 6",
            DayOfWeek.Saturday => "Thứ 7",
            DayOfWeek.Sunday => "CN",
            _ => ""
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Đang trực" => "text-green-700 bg-green-100 border-green-200",
            "Đã hoàn thành" => "text-slate-600 bg-slate-100 border-slate-200",
            _ => "text-teal-700 bg-teal-100 border-teal-200"
        };
    }
