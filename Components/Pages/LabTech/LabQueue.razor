@page "/lab"
@using SmartClinic.Models
@using SmartClinic.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Blazored.Toast.Services

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "LabTechPolicy")]
@rendermode InteractiveServer

@inject ILabService LabService
@inject IToastService ToastService
@inject NavigationManager NavigationManager

@implements IAsyncDisposable

<PageTitle>Kỹ Thuật Viên Xét Nghiệm - SmartClinic</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Danh Sách Chờ Xét Nghiệm</h1>
            <p class="text-sm text-slate-500 mt-1">Cập nhật kết quả cận lâm sàng cho các ca bác sĩ chỉ định</p>
        </div>
        <button @onclick="LoadDataAsync"
                class="p-2 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-full transition-colors group"
                title="Làm mới">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-6 w-6 group-hover:rotate-180 transition-transform duration-500" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <span class="ml-3 text-slate-600">Đang tải dữ liệu...</span>
        </div>
    }
    else if (_labOrders == null || !_labOrders.Any())
    {
        <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-8 text-center bg-slate-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-slate-400 mb-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <h3 class="text-lg font-medium text-slate-900 mb-1">Hiện không có ca xét nghiệm nào</h3>
            <p class="text-slate-500">Khi bác sĩ chỉ định phiếu mới, danh sách sẽ tự động hiện lên tại đây.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            @foreach (var order in _labOrders)
            {
                <div
                    class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden break-inside-avoid shadow-slate-100">
                    <div class="bg-slate-50 px-5 py-4 border-b border-slate-200 flex justify-between items-center">
                        <div>
                            <span class="font-bold text-slate-800 text-lg block">@order.QueueTicket?.Patient?.FullName</span>
                            <span class="text-sm text-slate-500 mt-1 flex items-center">
                                <span class="bg-blue-100 text-blue-800 py-0.5 px-2 rounded font-mono text-xs mr-2">Số:
                                    @order.QueueTicket?.TicketNumber</span>
                                    Chỉ định lúc @order.CreatedAt.ToString("HH:mm")
                                </span>
                            </div>
                            <div class="text-right">
                                <span
                                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium @(order.Status == "Done" ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                    @(order.Status == "Done" ? "Hoàn Thành" : "Đang Chờ")
                                </span>
                            </div>
                        </div>

                        <div class="p-5 space-y-5">
                            @foreach (var detail in order.LabOrderDetails)
                            {
                                bool isDetailDone = !string.IsNullOrEmpty(detail.ResultNotes);

                                <div
                                    class="border @(isDetailDone ? "border-green-200 bg-green-50/30" : "border-slate-200") rounded-lg p-4 transition-colors">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="font-medium text-slate-800 test-lg">@detail.LabTest?.Name</div>
                                        @if (isDetailDone)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20"
                                                 fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                                      clip-rule="evenodd" />
                                            </svg>
                                        }
                                    </div>

                                    <div class="space-y-4">
                                        <div>
                                            <label class="block text-xs font-medium text-slate-700 mb-1">Kết quả đo / Kết luận <span
                                                class="text-red-500">*</span></label>
                                                <textarea
                                                class="w-full border-slate-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm text-slate-800"
                                                rows="3" placeholder="Ví dụ: Chỉ số ở mức ổn định..."
                                                @bind="detail.ResultNotes"></textarea>
                                            </div>
                                            <div>
                                                <label class="block text-xs font-medium text-slate-700 mb-1">Đường dẫn tệp đính kèm (Hình
                                                    ảnh, PDF)</label>
                                                    <input type="text"
                                                           class="w-full border-slate-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm text-slate-800"
                                                           @bind="detail.ResultFileUrl" placeholder="https://ket-qua-xet-nghiem.jpg..." />
                                                </div>

                                                <div class="flex justify-end pt-2">
                                                    <button @onclick="() => SaveResultAsync(detail)"
                                                            disabled="@string.IsNullOrWhiteSpace(detail.ResultNotes)"
                                                            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded shadow-sm text-white bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                                                        @if (isDetailDone && order.Status == "Done")
                                                        {
                                                            <span>✓ Đã Trả Bác Sĩ</span>
                                                        }
                                                        else if (isDetailDone)
                                                        {
                                                            <span>Cập Nhật Lại Kết Quả</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Lưu Kết Quả Này</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

@code {
    private List<LabOrder>? _labOrders;
    private bool _isLoading = true;
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        // Connect to LabHub
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/labHub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<int>("LabOrderCreated", async (orderId) =>
        {
            await InvokeAsync(async () =>
            {
                ToastService.ShowInfo("Có chỉ định xét nghiệm mới từ bác sĩ!");
                await LoadDataAsync(); // Auto load new data
                StateHasChanged();
            });
        });

        await _hubConnection.StartAsync();

        // Join technicians group to listen to "LabOrderCreated"
        await _hubConnection.InvokeAsync("JoinLabTechGroup");
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _labOrders = await LabService.GetPendingLabOrdersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Có lỗi khi kết nối database: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveResultAsync(LabOrderDetail detail)
    {
        if (string.IsNullOrWhiteSpace(detail.ResultNotes))
        {
            ToastService.ShowWarning("Vui lòng nhập kết quả trước khi đưa lại cho bác sĩ.");
            return;
        }

        try
        {
            await LabService.SubmitLabResultAsync(detail.Id, detail.ResultNotes, detail.ResultFileUrl);
            ToastService.ShowSuccess($"Đã ghi nhận kết quả cho {detail.LabTest?.Name}");
            // Reload the list to check if entire Order becomes "Done"
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Có lỗi xảy ra khi lưu: " + ex.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
