@page "/lab"
@using SmartClinic.Models
@using SmartClinic.Services
@using SmartClinic.Components.Common
@using SmartClinic.Components.Common.Lab
@using Microsoft.AspNetCore.SignalR.Client
@using Blazored.Toast.Services

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "LabTechPolicy")]
@rendermode InteractiveServer

@inject ILabService LabService
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject PatientService PatientService

@implements IAsyncDisposable

<PageTitle>Kỹ Thuật Viên Xét Nghiệm - SmartClinic</PageTitle>

<div class="max-w-7xl mx-auto px-4 py-8">
    @* ── Tiêu đề trang ── *@
    <div class="flex items-center gap-3 mb-6">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
            <i class="ph ph-flask text-3xl"></i>
        </div>
        <div>
            <h1 class="text-3xl font-bold text-foreground">Hàng Đợi Xét Nghiệm</h1>
            <p class="text-muted-foreground">Kỹ thuật viên cập nhật kết quả xét nghiệm</p>
        </div>
    </div>

    @* ── Thanh tìm kiếm & bộ lọc ── *@
    <div class="flex items-center gap-3 p-4 bg-card border border-border rounded-xl shadow-sm mb-8">
        <div
            class="flex-1 flex items-center bg-background border border-border rounded-lg px-3 focus-within:ring-2 focus-within:ring-primary/50 transition-all">
            <i class="ph ph-magnifying-glass text-muted-foreground text-lg"></i>
            <input type="text" @bind="SearchTerm" @bind:event="oninput"
                   class="flex-1 bg-transparent border-none py-2.5 px-3 text-sm focus:outline-none text-foreground"
                   placeholder="Tìm bệnh nhân hoặc số phiếu..." />
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <div class="flex items-center gap-2 mr-4 bg-primary/5 px-4 py-2 rounded-lg border border-primary/20">
                <i class="ph ph-hospital text-primary"></i>
                <span class="text-sm font-bold text-primary">
                    @(_currentShiftRoomName ?? "Chưa vào ca / Hết ca trực")
                </span>
            </div>

            <div class="flex bg-muted/40 p-1 rounded-lg border border-border gap-0.5">
                <button @onclick='() => FilterStatus = null'
                        class='px-3 py-1.5 rounded-md text-xs font-bold transition-all @(FilterStatus == null ? "bg-card text-primary shadow" : "text-muted-foreground hover:text-foreground")'>
                    Tất cả
                </button>
                <button @onclick='() => FilterStatus = LabOrderStatus.Pending'
                        class='px-3 py-1.5 rounded-md text-xs font-bold transition-all @(FilterStatus == LabOrderStatus.Pending ? "bg-card text-amber-600 shadow" : "text-muted-foreground hover:text-foreground")'>
                    Đang chờ
                </button>
                <button @onclick='() => FilterStatus = LabOrderStatus.Completed'
                        class='px-3 py-1.5 rounded-md text-xs font-bold transition-all @(FilterStatus == LabOrderStatus.Completed ? "bg-card text-green-600 shadow" : "text-muted-foreground hover:text-foreground")'>
                    Hoàn tất
                </button>
            </div>

            <button @onclick="LoadDataAsync"
                    class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition">
                <i class="ph ph-arrows-clockwise @(_isLoading ? "animate-spin" : "")"></i>
                Làm mới
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground bg-card rounded-xl border border-border shadow-sm">
            <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
            <span class="text-sm">Đang tải dữ liệu xét nghiệm...</span>
        </div>
    }
    else if (FilteredOrders == null || !FilteredOrders.Any())
    {
        <div class="flex flex-col items-center justify-center py-16 gap-3 text-muted-foreground bg-card rounded-xl border border-border shadow-sm">
            <i class="ph ph-tray text-4xl"></i>
            <p class="text-sm font-medium">Hiện tại không có yêu cầu xét nghiệm nào</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var order in PagedOrders)
            {
                <LabOrderCard Order="order" OnOrderUpdated="LoadDataAsync" SelectedStationId="_selectedStationId" />
            }
        </div>

        @* ── Phân trang ── *@
        <Pagination CurrentPage="_currentPage" TotalItems="FilteredOrders.Count()" PageSize="_pageSize"
                    OnPageChanged="(p) => { _currentPage = p; StateHasChanged(); }" />
    }
</div>

@code {
    private List<LabOrder>? _labOrders;
    private List<Room> _stations = new();
    private bool _isLoading = true;
    private HubConnection? _hubConnection;
    private string? _currentShiftRoomName;
    private int? _currentUserId;

    // Pagination & Filters
    private int _currentPage = 1;
    private int _pageSize = 6;

    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set { if (_searchTerm != value) { _searchTerm = value; _currentPage = 1; } }
    }

    private LabOrderStatus? _filterStatus = LabOrderStatus.Pending;
    private LabOrderStatus? FilterStatus
    {
        get => _filterStatus;
        set { if (_filterStatus != value) { _filterStatus = value; _currentPage = 1; } }
    }

    private int _selectedStationId = 0;
    // Removed setter with LoadDataAsync to follow strict pattern
    private int SelectedStationId
    {
        get => _selectedStationId;
        set { _selectedStationId = value; _currentPage = 1; }
    }

    private IEnumerable<LabOrder> FilteredOrders => _labOrders?
        .Where(o => (string.IsNullOrWhiteSpace(_searchTerm) ||
                    (o.QueueTicket?.PatientUser?.FullName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (o.QueueTicket?.TicketNumber.ToString().Contains(_searchTerm) ?? false)))
        .Where(o => !_filterStatus.HasValue || o.Status == _filterStatus.Value)
        .Where(o => _selectedStationId == 0 || o.LabOrderDetails.Any(d => d.LabTest?.DefaultRoomId == _selectedStationId))
        ?? Enumerable.Empty<LabOrder>();

    private IEnumerable<LabOrder> PagedOrders => FilteredOrders
        .Skip((_currentPage - 1) * _pageSize)
        .Take(_pageSize);


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                _currentUserId = userId;

                // Centralized logic: Tự động lấy phòng/ca trực hiện tại (Bác sĩ hay KTV đều dùng chung pattern này)
                var activeShift = await PatientService.GetActiveDoctorShiftAsync(userId);
                if (activeShift != null)
                {
                    _selectedStationId = activeShift.RoomId;
                    _currentShiftRoomName = activeShift.Room?.Name;
                }
            }
        }

        await LoadDataAsync();
        _stations = await LabService.GetLabStationsAsync();

        // Connect to LabHub
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/labHub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<int>("LabOrderCreated", async (orderId) =>
        {
            await InvokeAsync(async () =>
            {
                ToastService.ShowInfo("Có chỉ định xét nghiệm mới từ bác sĩ!");
                await LoadDataAsync(); // Auto load new data
                StateHasChanged();
            });
        });

        await _hubConnection.StartAsync();

        // Join technicians group to listen to "LabOrderCreated"
        await _hubConnection.InvokeAsync("JoinLabTechGroup");
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            // Filter strictly by the station ID assigned to the LabTech's shift
            _labOrders = await LabService.GetTodayLabOrdersAsync(_selectedStationId);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Có lỗi khi kết nối database: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
