@page "/waiting-room"
@using Microsoft.AspNetCore.SignalR.Client
@using SmartClinic.Components.Common
@using SmartClinic.DTOs
@using SmartClinic.Services
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IQueueService QueueService

<div class="flex flex-col items-center min-h-screen px-4 py-12 font-sans transition-colors duration-300 bg-slate-50 dark:bg-slate-900 sm:px-6 lg:px-8">
	<div class="w-full max-w-5xl space-y-8">

		<h1 class="text-3xl font-extrabold tracking-tight text-center md:text-5xl text-slate-800 dark:text-white">
			SẢNH CHỜ KHÁM BỆNH
		</h1>

		@if (!IsConnected)
		{
			<ConnectionAlert Message="Đang kết nối đến hệ thống màn hình... Vui lòng đợi." />
		}
		else
		{
			<div class="flex flex-col gap-6 md:flex-row">
				<div class="flex-1">
					<CurrentCallCard TicketNumber="@DisplayData.CurrentTicketNumber"
						RoomName="@DisplayData.RoomName" />
				</div>

				<div class="w-full md:w-1/3">
					<NextCallsList Tickets="@DisplayData.NextTickets" />
				</div>
			</div>
		}
	</div>
</div>

@code {
	private HubConnection? hubConnection;
	private QueueDisplayDto DisplayData { get; set; } = new QueueDisplayDto();

	public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

	protected override async Task OnInitializedAsync()
	{
		DisplayData = await QueueService.GetDisplayDataAsync();

		hubConnection = new HubConnectionBuilder()
			.WithUrl(Navigation.ToAbsoluteUri("/queueHub"))
			.WithAutomaticReconnect()
			.Build();

		hubConnection.On<QueueDisplayDto>("ReceiveNewCall", (data) =>
		{
			DisplayData = data;
			InvokeAsync(StateHasChanged);
		});

		hubConnection.Reconnecting += async (error) =>
		{
			// Cập nhật trạng thái UI để hiện thông báo Alert
			Console.WriteLine($"Đang thử kết nối lại do lỗi: {error?.Message}");
			await InvokeAsync(StateHasChanged);
		};

		hubConnection.Reconnected += async (connectionId) =>
		{
			await InvokeAsync(StateHasChanged);
		};

		hubConnection.Closed += async (error) =>
		{
			Console.WriteLine($"Mất kết nối hoàn toàn. Vui lòng F5 tải lại trang.");
			await InvokeAsync(StateHasChanged);
		};

		try
		{
			await hubConnection.StartAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error starting SignalR: {ex.Message}");
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (hubConnection is not null)
		{
			await hubConnection.DisposeAsync();
		}
	}
}