@page "/cashier/vnpay-return"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@rendermode InteractiveServer
@layout CashierLayout
@attribute [Authorize(Policy = "CashierPolicy")]
@inject ICashierService CashierService
@inject NavigationManager Nav

<div class="p-8 flex items-center justify-center min-h-screen">
    <div class="bg-card rounded-2xl border border-border shadow-lg p-10 max-w-md w-full text-center">

        @if (_processing)
        {
            <div class="flex flex-col items-center gap-4">
                <i class="ph ph-spinner-gap text-5xl text-primary animate-spin"></i>
                <p class="text-lg font-semibold text-foreground">Processing payment...</p>
            </div>
        }
        else if (_success)
        {
            <div class="flex flex-col items-center gap-4">
                <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center">
                    <i class="ph ph-check-circle text-5xl text-green-600"></i>
                </div>
                <h2 class="text-2xl font-bold text-foreground">Payment Successful!</h2>
                <p class="text-muted-foreground">@_message</p>
                <div class="w-full p-4 bg-green-50 rounded-xl border border-green-200">
                    <p class="text-sm text-green-700 font-medium">Transaction completed via VNPay</p>
                </div>
                <button @onclick="GoBack"
                        class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-xl font-semibold hover:bg-primary/90 transition mt-2">
                    <i class="ph ph-arrow-left"></i>
                    Back to Payment Queue
                </button>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center gap-4">
                <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center">
                    <i class="ph ph-x-circle text-5xl text-red-600"></i>
                </div>
                <h2 class="text-2xl font-bold text-foreground">Payment Failed</h2>
                <p class="text-muted-foreground">@_message</p>
                <button @onclick="GoBack"
                        class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-xl font-semibold hover:bg-primary/90 transition mt-2">
                    <i class="ph ph-arrow-left"></i>
                    Back to Payment Queue
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool _processing = true;
    private bool _success;
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var queryString = uri.Query;

        // Parse query thành Dictionary rồi wrap thành QueryCollection
        var parsed = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryString);
        var dict = parsed.ToDictionary(k => k.Key, v => v.Value);
        var queryCollection = new QueryCollection(dict);

        var result = await CashierService.HandleVNPayCallbackAsync(queryCollection);

        _success = result.Success;
        _message = result.Success
            ? "The payment has been recorded and the patient's process is complete."
            : result.ErrorMessage;
        _processing = false;
    }

    private void GoBack() => Nav.NavigateTo("/cashier/payments");
}
