@page "/cashier/vnpay-return"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@rendermode InteractiveServer
@layout CashierLayout
@attribute [Authorize(Policy = "CashierPolicy")]
@inject ICashierService CashierService
@inject NavigationManager Nav

<div class="p-8 flex items-center justify-center min-h-screen">
    <div class="bg-card rounded-2xl border border-border shadow-lg p-10 max-w-md w-full text-center">
        <div class="flex flex-col items-center gap-4">
            <i class="ph ph-spinner-gap text-5xl text-primary animate-spin"></i>
            <p class="text-lg font-semibold text-foreground">Đang xử lý thanh toán...</p>
            <p class="text-sm text-muted-foreground">Vui lòng đợi, bạn sẽ được chuyển hướng trong giây lát.</p>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = new Uri(Nav.Uri);
            var queryString = uri.Query;

            var parsed = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryString);
            var dict = parsed.ToDictionary(k => k.Key, v => v.Value);
            var queryCollection = new QueryCollection(dict);

            var result = await CashierService.HandleVNPayCallbackAsync(queryCollection);

            if (result.Success || (result.ErrorMessage != null && result.ErrorMessage.Contains("'Done'"))) // allow double process success
            {
                Nav.NavigateTo($"/cashier/payments?vnpay_success=true&vnpay_msg={Uri.EscapeDataString("Thanh toán VNPay thành công!")}");
            }
            else
            {
                Nav.NavigateTo($"/cashier/payments?vnpay_error=true&vnpay_msg={Uri.EscapeDataString(result.ErrorMessage ?? "Thanh toán thất bại")}");
            }
        }
    }
}
