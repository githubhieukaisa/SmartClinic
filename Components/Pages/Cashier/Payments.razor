@page "/cashier/payments"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.DTOs
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@using Blazored.Toast.Services
@rendermode InteractiveServer
@layout CashierLayout
@attribute [Authorize(Policy = "CashierPolicy")]
@inject ICashierService CashierService
@inject IToastService ToastService

<div class="p-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-foreground">Thanh Toán Viện Phí</h1>
            <p class="text-muted-foreground mt-1">Danh sách bệnh nhân chờ thanh toán</p>
        </div>
        <button @onclick="LoadDataAsync"
                class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition">
            <i class="ph ph-arrows-clockwise"></i>
            Làm mới
        </button>
    </div>

    <!-- Summary -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <h4 class="font-semibold text-foreground text-sm">Chờ thanh toán</h4>
                <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                    <i class="ph ph-clock text-xl text-indigo-600"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-indigo-600">@(_prescriptions?.Count ?? 0)</p>
        </div>
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <h4 class="font-semibold text-foreground text-sm">Tổng thu chờ</h4>
                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="ph ph-money text-xl text-green-600"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-green-600">
                @((_prescriptions?.Sum(p => p.TotalAmount) ?? 0).ToString("N0"))đ
            </p>
        </div>
    </div>

    <!-- Payment List -->
    @if (_prescriptions == null)
    {
        <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground">
            <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
            <span>Đang tải...</span>
        </div>
    }
    else if (!_prescriptions.Any())
    {
        <div
            class="flex flex-col items-center justify-center py-16 gap-3 text-muted-foreground bg-card rounded-xl border border-border">
            <i class="ph ph-money text-4xl"></i>
            <p class="font-medium">Không có bệnh nhân nào đang chờ thanh toán</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var p in _prescriptions)
            {
                <div class="bg-card rounded-xl border border-border shadow-sm overflow-hidden">
                    <!-- Header -->
                    <div class="flex items-center justify-between p-5 border-b border-border bg-indigo-50">
                        <div class="flex items-center gap-4">
                            <span
                                class="inline-flex items-center justify-center w-10 h-10 bg-indigo-200 text-indigo-800 rounded-lg text-sm font-bold">
                                #@p.TicketNumber
                            </span>
                            <div>
                                <p class="font-semibold text-foreground">@p.PatientName</p>
                                <p class="text-xs text-muted-foreground">BS. @p.DoctorName · @p.CreatedAt.ToString("HH:mm")</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <p class="text-2xl font-black text-green-700">@p.TotalAmount.ToString("N0")đ</p>
                            <button @onclick="() => PayAsync(p.PrescriptionId)"
                                    disabled="@_processing.Contains(p.PrescriptionId)"
                                    class="flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed">
                                @if (_processing.Contains(p.PrescriptionId))
                                {
                                    <i class="ph ph-spinner-gap animate-spin"></i>
                                    <span>Đang xử lý...</span>
                                }
                                else
                                {
                                    <i class="ph ph-check-square"></i>
                                    <span>Xác nhận thanh toán</span>
                                }
                            </button>
                        </div>
                    </div>

                    <!-- Medicine Summary -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-border bg-muted/30">
                                    <th class="text-left py-2 px-5 font-semibold text-muted-foreground">Thuốc</th>
                                    <th class="text-center py-2 px-5 font-semibold text-muted-foreground">SL</th>
                                    <th class="text-right py-2 px-5 font-semibold text-muted-foreground">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in p.Details)
                                {
                                    <tr class="border-b border-border last:border-0">
                                        <td class="py-3 px-5 text-foreground">@d.MedicineName</td>
                                        <td class="py-3 px-5 text-center text-foreground">@d.Quantity @d.Unit</td>
                                        <td class="py-3 px-5 text-right font-medium text-foreground">@d.SubTotal.ToString("N0")đ
                                        </td>
                                    </tr>
                                }
                                <tr class="bg-green-50 font-bold">
                                    <td class="py-3 px-5 text-foreground" colspan="2">Tổng cộng</td>
                                    <td class="py-3 px-5 text-right text-green-700 text-base">@p.TotalAmount.ToString("N0")đ
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PrescriptionQueueDto>? _prescriptions;
    private HashSet<int> _processing = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _prescriptions = null;
        StateHasChanged();
        _prescriptions = await CashierService.GetDispensedPrescriptionsAsync();
    }

    private async Task PayAsync(int prescriptionId)
    {
        _processing.Add(prescriptionId);
        StateHasChanged();

        var (success, error) = await CashierService.ProcessPaymentAsync(prescriptionId);

        _processing.Remove(prescriptionId);

        if (success)
        {
            ToastService.ShowSuccess("Thanh toán thành công! Bệnh nhân đã hoàn tất quy trình.");
            _prescriptions?.RemoveAll(p => p.PrescriptionId == prescriptionId);
        }
        else
        {
            ToastService.ShowError(error);
        }

        StateHasChanged();
    }
}
