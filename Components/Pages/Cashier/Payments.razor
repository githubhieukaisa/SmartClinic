@page "/cashier/payments"
@using Microsoft.AspNetCore.Authorization
@using SmartClinic.DTOs
@using SmartClinic.Services
@using SmartClinic.Components.Layout
@using Blazored.Toast.Services
@rendermode InteractiveServer
@layout CashierLayout
@attribute [Authorize(Policy = "CashierPolicy")]
@inject ICashierService CashierService
@inject IToastService ToastService
@inject NavigationManager Nav

<div class="p-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-foreground">Payment Queue</h1>
            <p class="text-muted-foreground mt-1">Patients waiting to complete payment</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="text-right">
                <p class="text-sm font-medium text-foreground">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
                <p class="text-xs text-muted-foreground">@DateTime.Now.ToString("hh:mm tt")</p>
            </div>
            <button @onclick="LoadDataAsync"
                    class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition">
                <i class="ph ph-arrows-clockwise"></i>
                Refresh
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-semibold text-foreground text-sm">Awaiting Payment</h4>
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center">
                    <i class="ph ph-queue text-xl text-primary"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-primary">@(_prescriptions?.Count ?? 0)</p>
            <div class="mt-4 bg-primary/10 rounded-full h-2">
                <div class="bg-primary h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-semibold text-foreground text-sm">Total Revenue</h4>
                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="ph ph-money text-xl text-green-600"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-green-600">
                @((_prescriptions?.Sum(p => p.TotalAmount) ?? 0).ToString("N0"))đ
            </p>
            <div class="mt-4 bg-green-100 rounded-full h-2">
                <div class="bg-green-600 h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-semibold text-foreground text-sm">Avg. Bill</h4>
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="ph ph-chart-bar text-xl text-blue-600"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-blue-600">
                @((_prescriptions?.Count > 0 ? _prescriptions.Average(p => p.TotalAmount) : 0).ToString("N0"))đ
            </p>
            <div class="mt-4 bg-blue-100 rounded-full h-2">
                <div class="bg-blue-600 h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>
    </div>

    <!-- Payment Table -->
    <div class="bg-card rounded-xl border border-border shadow-sm">
        <div class="flex items-center justify-between p-6 border-b border-border">
            <div class="flex items-center gap-2">
                <i class="ph ph-receipt text-xl text-foreground"></i>
                <h2 class="text-xl font-bold text-foreground">Pending Payments</h2>
            </div>
        </div>

        <div class="overflow-x-auto">
            @if (_prescriptions == null)
            {
                <div class="flex items-center justify-center py-16 gap-3 text-muted-foreground">
                    <i class="ph ph-spinner-gap text-2xl animate-spin"></i>
                    <span class="text-sm">Loading...</span>
                </div>
            }
            else if (!_prescriptions.Any())
            {
                <div class="flex flex-col items-center justify-center py-16 gap-3 text-muted-foreground">
                    <i class="ph ph-money text-4xl"></i>
                    <p class="text-sm font-medium">No payments pending</p>
                </div>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-border bg-muted/30">
                            <th class="text-center py-3 px-4 font-semibold text-muted-foreground w-10"></th>
                            <th class="text-center py-3 px-4 font-semibold text-muted-foreground">#</th>
                            <th class="text-left py-3 px-4 font-semibold text-muted-foreground">Patient</th>
                            <th class="text-left py-3 px-4 font-semibold text-muted-foreground">Doctor</th>
                            <th class="text-left py-3 px-4 font-semibold text-muted-foreground">Medicines</th>
                            <th class="text-center py-3 px-4 font-semibold text-muted-foreground">Time</th>
                            <th class="text-center py-3 px-4 font-semibold text-muted-foreground">Status</th>
                            <th class="text-right py-3 px-4 font-semibold text-muted-foreground">Total</th>
                            <th class="text-center py-3 px-4 font-semibold text-muted-foreground">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _prescriptions)
                        {
                            var pid = p.PrescriptionId;

                            <tr class="border-b border-border hover:bg-muted/20 transition">
                                <!-- Expand toggle -->
                                <td class="py-3 px-4 text-center">
                                    <button @onclick="@(() => ToggleExpand(pid))"
                                            class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-muted transition text-muted-foreground hover:text-foreground">
                                        @if (_expanded.Contains(pid))
                                        {
                                            <i class="ph ph-caret-up text-base"></i>
                                        }
                                        else
                                        {
                                            <i class="ph ph-caret-down text-base"></i>
                                        }
                                    </button>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <span class="inline-flex items-center justify-center w-8 h-8 bg-primary/10 text-primary rounded-lg text-xs font-bold">
                                        @p.TicketNumber
                                    </span>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 bg-gradient-to-br from-primary to-primary/70 rounded-full flex items-center justify-center text-primary-foreground text-xs font-bold flex-shrink-0">
                                            @GetInitials(p.PatientName)
                                        </div>
                                        <p class="font-medium text-foreground">@p.PatientName</p>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-foreground text-sm">Dr. @p.DoctorName</td>
                                <td class="py-3 px-4">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var d in p.Details.Take(2))
                                        {
                                            <span class="inline-block px-2 py-0.5 bg-muted text-foreground rounded text-xs">
                                                @d.MedicineName (@d.Quantity)
                                            </span>
                                        }
                                        @if (p.Details.Count > 2)
                                        {
                                            <span class="text-xs text-muted-foreground">+@(p.Details.Count - 2)</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <div class="flex items-center justify-center gap-1 text-muted-foreground">
                                        <i class="ph-bold ph-clock text-xs"></i>
                                        <span class="text-xs">@p.CreatedAt.ToString("HH:mm")</span>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                        Dispensed
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <p class="font-black text-green-700 text-base">@p.TotalAmount.ToString("N0")đ</p>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex items-center justify-center gap-2">
                                        <!-- Cash -->
                                        <button @onclick="@(() => PayCashAsync(pid))"
                                                disabled="@(_processing.Contains(pid))"
                                                class="flex items-center gap-1 px-3 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-xs font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed active:scale-95">
                                            @if (_processing.Contains(pid))
                                            {
                                                <i class="ph ph-spinner-gap animate-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="ph ph-money"></i>
                                                <span>Cash</span>
                                            }
                                        </button>
                                        <!-- VNPay -->
                                        <button @onclick="@(() => PayVNPay(p))"
                                                disabled="@(_processing.Contains(pid))"
                                                class="flex items-center gap-1 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed active:scale-95">
                                            <i class="ph ph-credit-card"></i>
                                            <span>VNPay</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Expandable detail row -->
                            @if (_expanded.Contains(pid))
                            {
                                <tr class="bg-muted/10 border-b border-border">
                                    <td colspan="9" class="px-6 py-4">
                                        <div class="rounded-xl border border-border overflow-hidden shadow-sm">
                                            <div class="px-4 py-2 bg-muted/30 border-b border-border flex items-center gap-2">
                                                <i class="ph ph-pill text-sm text-primary"></i>
                                                <span class="text-xs font-semibold text-foreground uppercase tracking-wide">
                                                    Medicine Details — @p.PatientName
                                                </span>
                                            </div>
                                            <table class="w-full text-xs">
                                                <thead>
                                                    <tr class="border-b border-border bg-muted/20">
                                                        <th class="text-left py-2 px-4 font-semibold text-muted-foreground">Medicine</th>
                                                        <th class="text-center py-2 px-4 font-semibold text-muted-foreground">Qty</th>
                                                        <th class="text-center py-2 px-4 font-semibold text-muted-foreground">Unit</th>
                                                        <th class="text-left py-2 px-4 font-semibold text-muted-foreground">Instructions</th>
                                                        <th class="text-right py-2 px-4 font-semibold text-muted-foreground">Unit Price</th>
                                                        <th class="text-right py-2 px-4 font-semibold text-muted-foreground">Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var d in p.Details)
                                                    {
                                                        <tr class="border-t border-border hover:bg-muted/10 transition">
                                                            <td class="py-2.5 px-4 font-medium text-foreground">@d.MedicineName</td>
                                                            <td class="py-2.5 px-4 text-center text-foreground">@d.Quantity</td>
                                                            <td class="py-2.5 px-4 text-center text-muted-foreground">@(d.Unit ?? "—")</td>
                                                            <td class="py-2.5 px-4 text-muted-foreground">@(d.UsageInstruction ?? "—")</td>
                                                            <td class="py-2.5 px-4 text-right text-foreground">@d.UnitPrice.ToString("N0")đ</td>
                                                            <td class="py-2.5 px-4 text-right font-semibold text-foreground">@d.SubTotal.ToString("N0")đ</td>
                                                        </tr>
                                                    }
                                                    <tr class="border-t-2 border-border bg-green-50">
                                                        <td colspan="5" class="py-2.5 px-4 font-bold text-foreground">Total</td>
                                                        <td class="py-2.5 px-4 text-right font-black text-green-700 text-sm">@p.TotalAmount.ToString("N0")đ</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(p.DoctorNote))
                                        {
                                            <div class="mt-3 px-4 py-2.5 bg-blue-50 rounded-lg border border-blue-200 text-xs text-blue-700 flex items-start gap-2">
                                                <i class="ph ph-note text-base flex-shrink-0"></i>
                                                <span><strong>Doctor note:</strong> @p.DoctorNote</span>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private List<PrescriptionQueueDto>? _prescriptions;
    private HashSet<int> _processing = new();
    private HashSet<int> _expanded = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _prescriptions = null;
        StateHasChanged();
        _prescriptions = await CashierService.GetDispensedPrescriptionsAsync();
    }

    private void ToggleExpand(int id)
    {
        if (!_expanded.Remove(id))
            _expanded.Add(id);
    }

    private async Task PayCashAsync(int prescriptionId)
    {
        _processing.Add(prescriptionId);
        StateHasChanged();

        var result = await CashierService.ProcessPaymentAsync(prescriptionId);

        _processing.Remove(prescriptionId);

        if (result.Success)
        {
            ToastService.ShowSuccess("Cash payment confirmed! Patient process complete.");
            _prescriptions?.RemoveAll(p => p.PrescriptionId == prescriptionId);
            _expanded.Remove(prescriptionId);
        }
        else
        {
            ToastService.ShowError(result.ErrorMessage);
        }

        StateHasChanged();
    }

    private void PayVNPay(PrescriptionQueueDto p)
    {
        if (p.TotalAmount <= 0)
        {
            ToastService.ShowWarning("Total amount is 0, cannot process VNPay payment.");
            return;
        }
        var url = CashierService.CreateVNPayUrl(p.PrescriptionId, p.TotalAmount, p.PatientName);
        Nav.NavigateTo(url, forceLoad: true);
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }
}
